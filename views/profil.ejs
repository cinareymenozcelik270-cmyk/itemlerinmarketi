<!DOCTYPE html>
<html lang="tr">
<head>
    <meta name="google-site-verification" content="rXTtLPJavFhXvJ7TGofxQ3XXGZXb_B8dzSBNAPZwLFk" />
    <link rel="icon" type="image/png" href="/resim.png">
    <meta charset="UTF-8">
    <title>Profilimi Düzenle - İtemlerinMarketi</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/otpauth@9.3.2/dist/otpauth.umd.min.js"></script>
    <style>
        .profil-duzenle-kapsayici {
            max-width: 600px;
            margin: 40px auto;
            background: #1e293b;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid #334155;
        }
        .profil-duzenle-kapsayici h2 {
            color: #38bdf8;
            text-align: center;
            margin-top: 0;
        }
        .profil-buyuk-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #10b981;
            margin: 0 auto 15px auto;
            display: block;
            background: #0f172a;
        }
        .resim-yukle-etiket {
            display: inline-block;
            background: #334155;
            color: #38bdf8;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 25px;
            border: 1px solid #475569;
            transition: background 0.2s;
        }
        .resim-yukle-etiket:hover { background: #475569; }
        .profil-formu label {
            display: block;
            text-align: left;
            color: #94a3b8;
            font-size: 13px;
            margin-bottom: 5px;
        }
        .profil-formu input {
            width: 100%;
            padding: 10px;
            background: #0f172a;
            border: 1px solid #475569;
            color: white;
            border-radius: 6px;
            box-sizing: border-box;
            margin-bottom: 20px;
        }
        .profil-formu input:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .badge-dogrulandi {
            display: inline-block;
            background: #065f46;
            color: #34d399;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            margin-left: 10px;
        }
        .badge-dogrulanmadi {
            display: inline-block;
            background: #7f1d1d;
            color: #fca5a5;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            margin-left: 10px;
        }

        .twofa-kapsayici {
            background: #0f172a;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0 0 0;
            border: 1px solid #334155;
        }
        .twofa-kapsayici h3 {
            color: #a855f7;
            margin-top: 0;
        }
        .qr-kod {
            background: white;
            padding: 15px;
            border-radius: 8px;
            display: inline-block;
            margin: 10px auto;
        }
        .qr-kod img {
            width: 160px;
            height: 160px;
        }
        .yedek-anahtar {
            background: #1e293b;
            padding: 12px;
            border-radius: 6px;
            font-family: monospace;
            font-size: 18px;
            letter-spacing: 2px;
            color: #fbbf24;
            border: 1px dashed #fbbf24;
            word-break: break-all;
            margin: 10px 0;
        }
        .twofa-btn {
            background: linear-gradient(135deg, #a855f7, #6366f1);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .twofa-btn:hover { transform: scale(1.03); }
        .twofa-btn.aktif { background: linear-gradient(135deg, #ef4444, #dc2626); }
        .twofa-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .ayirici {
            border: none;
            border-top: 1px solid #334155;
            margin: 25px 0;
        }

        .kod-input-grubu {
            display: flex;
            gap: 10px;
            margin-top: 8px;
            flex-wrap: wrap;
            align-items: center;
        }
        .kod-input-grubu input {
            flex: 1;
            min-width: 150px;
            padding: 8px;
            background: #0f172a;
            border: 1px solid #475569;
            color: white;
            border-radius: 4px;
            margin-bottom: 0;
            text-align: center;
            font-size: 20px;
            letter-spacing: 4px;
        }
        .kod-input-grubu button {
            padding: 8px 16px;
            background: #6366f1;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
        .kod-input-grubu button:hover {
            background: #4f46e5;
        }
    </style>
</head>
<body>
    <header>
        <div class="header-sol-bölüm">
            <a href="/"><img src="/gif.png" alt="İtemlerinMarketi" class="logo-img" onerror="this.onerror=null; this.outerHTML='İtemlerinMarketi';"></a>
        </div>
        <nav><a href="/">🏠 Ana Sayfaya Dön</a></nav>
    </header>
    
    <div class="container">
        <div class="profil-duzenle-kapsayici" id="profilIcerik" style="display: none;">
            <h2>👤 Profil Ayarları</h2>
            <p style="color: #94a3b8; font-size: 13px; text-align: center; margin-bottom: 20px;">
                Kullanıcı adı, fotoğraf ve güvenlik ayarlarını yönet.
            </p>

            <!-- PROFİL BİLGİLERİ -->
            <form id="profilGuncelleFormu" class="profil-formu">
                <img src="/profil.jpg" id="avatarOnizleme" class="profil-buyuk-avatar">
                
                <label class="resim-yukle-etiket" for="yeniAvatarInput">📷 Yeni Fotoğraf Seç</label>
                <input type="file" id="yeniAvatarInput" accept="image/*" style="display: none;">

                <label>Kullanıcı Adınız (En az 3 harf, 1 büyük, 1 küçük):</label>
                <input type="text" id="profilKullaniciAdi" required autocomplete="off">

                <button type="submit" class="btn" style="width: 100%; padding: 12px;">✓ Değişiklikleri Uygula</button>
            </form>

            <hr class="ayirici">

            <!-- 2FA -->
            <div class="twofa-kapsayici">
                <h3>🔐 İki Faktörlü Doğrulama (2FA)</h3>
                <p style="color: #94a3b8; font-size: 13px;">
                    Hesabınıza ekstra güvenlik katmanı ekleyin. Google Authenticator veya Authy kullanın.
                </p>
                
                <div id="twofaDurum" style="margin: 10px 0;">
                    <span class="badge-dogrulanmadi">❌ 2FA Kapalı</span>
                </div>

                <div id="qrKodAlani" style="text-align: center;">
                    <div class="qr-kod">
                        <img id="qrKodImg" src="" alt="QR Kod">
                    </div>
                    <p style="color: #94a3b8; font-size: 12px;">QR kodu Google Authenticator ile tara</p>
                    
                    <div class="yedek-anahtar" id="yedekAnahtarAlani">XXXX-XXXX-XXXX-XXXX</div>
                    <button class="twofa-btn" onclick="kopyalaYedekAnahtar()" style="padding: 6px 14px; font-size: 12px;">📋 Kopyala</button>
                    <p style="color: #ef4444; font-size: 11px; margin-top: 5px;">⚠️ Bu anahtarı güvenli bir yerde sakla! Kaybedersen hesabına erişemezsin.</p>
                </div>

                <button class="twofa-btn" id="twofaToggleBtn" style="margin-top: 10px; width: 100%;">🔐 2FA'yı Aç</button>
                
                <div id="twofaDogrulaAlani" style="margin-top: 15px;">
                    <p style="color: #94a3b8; font-size: 13px;">Google Authenticator'dan kodu gir:</p>
                    <div class="kod-input-grubu">
                        <input type="text" id="twofaDogrulaInput" placeholder="6 haneli kod" maxlength="6">
                        <button class="twofa-btn" id="twofaDogrulaBtn" style="padding: 10px 20px;">✅ Onayla</button>
                    </div>
                    <div id="twofaSonuc" style="margin-top: 8px; font-size: 13px;"></div>
                </div>
            </div>

        </div>
    </div>

    <script>
    // ============================================
    // TÜM DEĞİŞKENLER
    // ============================================
    const aktif = JSON.parse(localStorage.getItem('aktifKullanici'));
    let yeniProfilBase64 = "";
    let twofaSecret = "";
    let twofaAktif = false;

    // ============================================
    // 2FA SECRET ÜRET
    // ============================================
    function twofaSecretUret() {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
        let secret = '';
        for (let i = 0; i < 16; i++) {
            secret += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        return secret;
    }

    // ============================================
    // 2FA DURUMUNU GÜNCELLE
    // ============================================
    function twofaDurumuGuncelle() {
        twofaAktif = localStorage.getItem(`twofa_aktif_${aktif?.kullaniciAdi}`) === 'true';
        const durum = document.getElementById('twofaDurum');
        const btn = document.getElementById('twofaToggleBtn');
        
        if (twofaAktif) {
            durum.innerHTML = '<span class="badge-dogrulandi">✅ 2FA Aktif</span>';
            btn.textContent = '🔒 2FA\'yı Kapat';
            btn.classList.add('aktif');
            document.getElementById('qrKodAlani').style.opacity = '0.5';
            document.getElementById('twofaDogrulaAlani').style.display = 'none';
        } else {
            durum.innerHTML = '<span class="badge-dogrulanmadi">❌ 2FA Kapalı</span>';
            btn.textContent = '🔐 2FA\'yı Aç';
            btn.classList.remove('aktif');
            document.getElementById('qrKodAlani').style.opacity = '1';
            document.getElementById('twofaDogrulaAlani').style.display = 'block';
            
            twofaSecret = localStorage.getItem(`twofa_secret_${aktif?.kullaniciAdi}`);
            if (!twofaSecret) {
                twofaSecret = twofaSecretUret();
                localStorage.setItem(`twofa_secret_${aktif?.kullaniciAdi}`, twofaSecret);
            }
            
            document.getElementById('qrKodImg').src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=otpauth://totp/ItemlerinMarketi:${aktif?.kullaniciAdi}?secret=${twofaSecret}&issuer=ItemlerinMarketi`;
            document.getElementById('yedekAnahtarAlani').textContent = twofaSecret.match(/.{4}/g).join('-');
        }
    }

    function kopyalaYedekAnahtar() {
        const anahtar = document.getElementById('yedekAnahtarAlani').textContent;
        navigator.clipboard.writeText(anahtar).then(() => {
            alert('✅ Yedek anahtar kopyalandı! Güvenli bir yerde sakla.');
        }).catch(() => {
            prompt('Anahtarı kopyala:', anahtar);
        });
    }

    // ============================================
    // SAYFA YÜKLENDİĞİNDE
    // ============================================
    if (!aktif) {
        alert('Profilinizi düzenlemek için önce giriş yapmalısınız!');
        window.location.href = '/login';
    } else {
        document.getElementById('profilIcerik').style.display = 'block';
        document.getElementById('profilKullaniciAdi').value = aktif.kullaniciAdi;

        let mevcutResim = localStorage.getItem(`profil_resim_${aktif.kullaniciAdi}`);
        if (mevcutResim) {
            document.getElementById('avatarOnizleme').src = mevcutResim;
            yeniProfilBase64 = mevcutResim;
        }

        twofaDurumuGuncelle();
    }

    // ============================================
    // AVATAR YÜKLEME
    // ============================================
    document.getElementById('yeniAvatarInput').addEventListener('change', function() {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('avatarOnizleme').src = e.target.result;
                yeniProfilBase64 = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });

    // ============================================
    // PROFİL GÜNCELLEME
    // ============================================
    document.getElementById('profilGuncelleFormu').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const yeniIsim = document.getElementById('profilKullaniciAdi').value.trim();
        
        if (yeniIsim.length < 3) {
            alert("Hata: Kullanıcı adınız en az 3 karakterden oluşmalıdır!");
            return;
        }
        if (!/[A-ZÇĞİÖŞÜ]/.test(yeniIsim)) {
            alert("Hata: Yeni isminiz en az bir tane BÜYÜK HARF içermelidir!");
            return;
        }
        if (!/[a-zçğıöşü]/.test(yeniIsim)) {
            alert("Hata: Yeni isminiz en az bir tane küçük harf içermelidir!");
            return;
        }

        let kullanicilar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
        
        if (yeniIsim.toLowerCase() !== aktif.kullaniciAdi.toLowerCase()) {
            const isimKullaniliyorMu = kullanicilar.some(u => u.kullaniciAdi.toLowerCase() === yeniIsim.toLowerCase());
            if (isimKullaniliyorMu) {
                alert("Hata: Bu kullanıcı adı başka bir üye tarafından kapılmış!");
                return;
            }
        }

        const uIdx = kullanicilar.findIndex(u => u.kullaniciAdi === aktif.kullaniciAdi);
        if (uIdx !== -1) {
            kullanicilar[uIdx].kullaniciAdi = yeniIsim;
            localStorage.setItem('kullanicilar', JSON.stringify(kullanicilar));
        }

        let pazardakiIlanlar = JSON.parse(localStorage.getItem('pazardakiIlanlar') || '[]');
        pazardakiIlanlar.forEach(ilan => {
            if (ilan.satici === aktif.kullaniciAdi) {
                ilan.satici = yeniIsim;
            }
        });
        localStorage.setItem('pazardakiIlanlar', JSON.stringify(pazardakiIlanlar));

        if (yeniProfilBase64) {
            localStorage.setItem(`profil_resim_${yeniIsim}`, yeniProfilBase64);
        }

        aktif.kullaniciAdi = yeniIsim;
        localStorage.setItem('aktifKullanici', JSON.stringify(aktif));

        alert('✅ Profil başarıyla güncellendi!');
        window.location.href = '/';
    });

    // ============================================
    // 2FA AÇ/KAPA BUTONU
    // ============================================
    document.getElementById('twofaToggleBtn').addEventListener('click', function() {
        if (twofaAktif) {
            if (confirm('2FA\'yı kapatmak istediğinize emin misiniz?')) {
                localStorage.setItem(`twofa_aktif_${aktif.kullaniciAdi}`, 'false');
                twofaDurumuGuncelle();
                document.getElementById('twofaSonuc').innerHTML = '<span style="color:#f59e0b;">🔓 2FA devre dışı bırakıldı.</span>';
                document.getElementById('twofaDogrulaInput').value = '';
            }
        } else {
            document.getElementById('twofaSonuc').innerHTML = '<span style="color:#38bdf8;">📱 Google Authenticator\'dan kodu girip "Onayla"ya bas.</span>';
            document.getElementById('twofaDogrulaInput').focus();
        }
    });

    // ============================================
    // 2FA DOĞRULAMA
    // ============================================
    document.getElementById('twofaDogrulaBtn').addEventListener('click', function() {
        const girilenKod = document.getElementById('twofaDogrulaInput').value.trim();
        const sonucAlani = document.getElementById('twofaSonuc');
        
        if (!girilenKod || girilenKod.length !== 6) {
            sonucAlani.innerHTML = '<span style="color:#ef4444;">❌ Lütfen 6 haneli kodu girin!</span>';
            return;
        }

        const secret = localStorage.getItem(`twofa_secret_${aktif.kullaniciAdi}`);
        if (!secret) {
            sonucAlani.innerHTML = '<span style="color:#ef4444;">❌ Secret bulunamadı! Sayfayı yenileyin.</span>';
            return;
        }

        try {
            if (typeof OTPAuth === 'undefined') {
                sonucAlani.innerHTML = '<span style="color:#ef4444;">❌ Kütüphane yüklenemedi! Sayfayı yenileyin.</span>';
                return;
            }

            const secretObj = OTPAuth.Secret.fromBase32(secret);
            const totp = new OTPAuth.TOTP({
                secret: secretObj,
                algorithm: 'SHA1',
                digits: 6,
                period: 30
            });

            const delta = totp.validate({
                token: girilenKod,
                window: 1
            });

            if (delta !== null && delta !== false) {
                localStorage.setItem(`twofa_aktif_${aktif.kullaniciAdi}`, 'true');
                sonucAlani.innerHTML = '<span style="color:#10b981;">✅ 2FA başarıyla etkinleştirildi! 🎉</span>';
                twofaDurumuGuncelle();
                document.getElementById('twofaDogrulaInput').value = '';
            } else {
                sonucAlani.innerHTML = '<span style="color:#ef4444;">❌ Geçersiz kod! Lütfen Google Authenticator kodunu kontrol edin.</span>';
            }

        } catch (hata) {
            console.error('2FA hatası:', hata);
            sonucAlani.innerHTML = `<span style="color:#ef4444;">❌ Doğrulama hatası: ${hata.message}</span>`;
        }
    });

    // ============================================
    // ENTER İLE 2FA DOĞRULAMA
    // ============================================
    document.getElementById('twofaDogrulaInput').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            document.getElementById('twofaDogrulaBtn').click();
        }
    });

    console.log('📧 İtemlerinMarketi - Profil sayfası yüklendi!');
    console.log('👤 Kullanıcı:', aktif?.kullaniciAdi);
    </script>
</body>
</html>