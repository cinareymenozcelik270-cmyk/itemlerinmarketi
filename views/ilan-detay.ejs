<!DOCTYPE html>
<html lang="tr">
<head>
    <meta name="google-adsense-account" content="ca-pub-7453399945201277">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= ilan ? ilan.baslik + ' - İtemlerinMarketi' : 'İlan Bulunamadı - İtemlerinMarketi' %></title>
    <meta name="description" content="<%= ilan ? ilan.baslik + ' - ' + ilan.fiyat + ' TL. Satıcı: ' + ilan.satici + '. ' + (ilan.detay || 'Güvenli ticaret platformunda ilan detayı.') : 'İlan bulunamadı. İtemlerinMarketi güvenli ticaret platformu.' %>">
    <meta name="keywords" content="<%= ilan ? ilan.baslik + ', ' + ilan.satici + ', oyun hesabı, güvenli ticaret, itemlerinmarketi' : 'itemlerinmarketi, güvenli ticaret' %>">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph -->
    <meta property="og:title" content="<%= ilan ? ilan.baslik + ' - İtemlerinMarketi' : 'İlan Bulunamadı' %>">
    <meta property="og:description" content="<%= ilan ? ilan.baslik + ' - ' + ilan.fiyat + ' TL' : 'İlan bulunamadı' %>">
    <meta property="og:type" content="product">
    <meta property="og:url" content="https://itemlerinmarketi.onrender.com/ilan/<%= ilan ? ilan._id || ilan.id : '' %>">
    
    <link rel="canonical" href="https://itemlerinmarketi.onrender.com/ilan/<%= ilan ? ilan._id || ilan.id : '' %>" />
    
    <link rel="stylesheet" href="/style.css">
    <style>
        body {
            background: #0f172a;
            color: #e2e8f0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
            padding: 20px;
        }
        .ilan-detay-container {
            max-width: 800px;
            margin: 40px auto;
            background: #1e293b;
            border-radius: 16px;
            padding: 40px;
            border: 1px solid #334155;
            box-shadow: 0 8px 40px rgba(0,0,0,0.5);
        }
        .ilan-detay-container .ilan-resim {
            width: 100%;
            max-height: 400px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid #334155;
        }
        .ilan-detay-container .ilan-baslik {
            color: #38bdf8;
            font-size: 32px;
            margin: 0 0 10px 0;
        }
        .ilan-detay-container .ilan-fiyat {
            color: #10b981;
            font-size: 28px;
            font-weight: bold;
        }
        .ilan-detay-container .ilan-bilgi {
            color: #94a3b8;
            margin: 10px 0;
            font-size: 16px;
        }
        .ilan-detay-container .ilan-bilgi strong {
            color: #e2e8f0;
        }
        .ilan-detay-container .ilan-aciklama {
            background: #0f172a;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
            border-left: 3px solid #6366f1;
            color: #cbd5e1;
            line-height: 1.6;
        }
        .ilan-detay-container .buton-grup {
            display: flex;
            gap: 15px;
            margin-top: 25px;
            flex-wrap: wrap;
        }
        .ilan-detay-container .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s;
            text-decoration: none;
            display: inline-block;
        }
        .ilan-detay-container .btn:hover {
            transform: scale(1.05);
        }
        .btn-satin-al {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
        }
        .btn-satin-al:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }
        .btn-mesaj {
            background: #1e293b;
            color: #38bdf8;
            border: 1px solid #38bdf8;
        }
        .btn-geri {
            background: #334155;
            color: #94a3b8;
        }
        .btn-geri:hover {
            background: #475569;
            color: white;
        }
        .ilan-detay-container .link-kopyala {
            background: #0f172a;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
            display: flex;
            gap: 10px;
            align-items: center;
            border: 1px solid #334155;
            flex-wrap: wrap;
        }
        .ilan-detay-container .link-kopyala input {
            flex: 1;
            padding: 10px;
            background: #1e293b;
            border: 1px solid #475569;
            border-radius: 6px;
            color: white;
            font-size: 14px;
            min-width: 200px;
        }
        .ilan-detay-container .link-kopyala button {
            background: #6366f1;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s;
        }
        .ilan-detay-container .link-kopyala button:hover {
            background: #4f46e5;
        }
        .durum-rozet {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-left: 10px;
        }
        .durum-aktif {
            background: #065f46;
            color: #6ee7b7;
        }
        .durum-pasif {
            background: #7f1d1d;
            color: #fca5a5;
        }
        .satici-kart {
            background: #0f172a;
            padding: 15px;
            border-radius: 8px;
            margin: 15px 0;
            border: 1px solid #334155;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }
        .satici-kart .satici-bilgi {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .satici-kart .satici-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #334155;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #38bdf8;
            font-size: 18px;
        }
        .satici-kart .satici-adi {
            color: #f8fafc;
            font-weight: 600;
            font-size: 16px;
        }
        .satici-kart .satici-uzmanlik {
            color: #94a3b8;
            font-size: 13px;
        }
        .satici-kart .mesaj-at-btn {
            background: #6366f1;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s;
        }
        .satici-kart .mesaj-at-btn:hover {
            background: #4f46e5;
        }
        .guvenli-havuz {
            display: inline-block;
            background: #1e1b4b;
            color: #a855f7;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            border: 1px solid #a855f7;
            margin-top: 5px;
        }
        .btn-duzenle {
            background: #38bdf8;
            color: #0f172a;
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }
        .btn-duzenle:hover {
            transform: scale(1.05);
        }
        .ilan-bulunamadi {
            text-align: center;
            padding: 60px 20px;
        }
        .ilan-bulunamadi h1 {
            color: #ef4444;
            font-size: 48px;
        }
        .ilan-bulunamadi p {
            color: #94a3b8;
            font-size: 18px;
            margin: 20px 0;
        }
        .ilan-bulunamadi a {
            color: #38bdf8;
            text-decoration: none;
            display: inline-block;
            margin-top: 20px;
            padding: 12px 30px;
            background: #1e293b;
            border-radius: 8px;
            border: 1px solid #38bdf8;
        }
        #duzenleBtnContainer {
            margin-top: 15px;
        }
        @media (max-width: 600px) {
            .ilan-detay-container {
                padding: 20px;
            }
            .ilan-detay-container .ilan-baslik {
                font-size: 24px;
            }
            .ilan-detay-container .ilan-fiyat {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <div class="ilan-detay-container">
        <a href="/" class="btn btn-geri" style="margin-bottom:20px;">← Ana Sayfaya Dön</a>

        <% if (!ilan) { %>
            <!-- İLAN BULUNAMADI -->
            <div class="ilan-bulunamadi">
                <h1>🔍 İlan Bulunamadı</h1>
                <p>Bu ilan artık mevcut değil veya kaldırılmış.</p>
                <a href="/">🏠 Ana Sayfaya Dön</a>
            </div>
        <% } else { %>
            <!-- İLAN GÖRSELİ -->
            <% if (ilan.resim && ilan.resim.length > 0 && ilan.resim !== 'undefined') { %>
                <img src="<%= ilan.resim %>" alt="<%= ilan.baslik %>" class="ilan-resim" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%23334155%22 stroke-width=%222%22><rect x=%223%22 y=%223%22 width=%2218%22 height=%2218%22 rx=%222%22/><circle cx=%228.5%22 cy=%228.5%22 r=%221.5%22/><path d=%22M21 15l-5-5L5 21%22/></svg>'">>
            <% } else { %>
                <div style="width:100%; height:200px; background:#0f172a; border-radius:12px; display:flex; align-items:center; justify-content:center; border:1px solid #334155; margin-bottom:20px; color:#475569; font-size:18px;">
                    📦 Ürün Resmi Yok
                </div>
            <% } %>

            <!-- BAŞLIK ve DURUM -->
            <h1 class="ilan-baslik">
                <%= ilan.baslik %>
                <span class="durum-rozet <%= ilan.aktiflikDurumu === 'pasif' ? 'durum-pasif' : 'durum-aktif' %>">
                    <%= ilan.aktiflikDurumu === 'pasif' ? '⛔ Liste Dışı' : '✅ Aktif' %>
                </span>
            </h1>

            <!-- FİYAT -->
            <div class="ilan-fiyat"><%= ilan.fiyat %> TL</div>

            <!-- GÜVENLİ HAVUZ BADGE -->
            <div class="guvenli-havuz">🔒 Güvenli Havuz</div>

            <!-- İLAN BİLGİLERİ -->
            <div class="ilan-bilgi"><strong>Satıcı:</strong> <%= ilan.satici %></div>
            <div class="ilan-bilgi"><strong>Teslimat Süresi:</strong> ⏱️ <%= ilan.sure || '24 Saat' %></div>
            <div class="ilan-bilgi"><strong>İlan No:</strong> #<%= ilan._id || ilan.id %></div>
            <div class="ilan-bilgi"><strong>Yayınlanma Tarihi:</strong> <%= new Date(ilan.createdAt || Date.now()).toLocaleDateString('tr-TR') %></div>

            <!-- SATICI KARTI -->
            <div class="satici-kart">
                <div class="satici-bilgi">
                    <div class="satici-avatar"><%= ilan.satici.charAt(0).toUpperCase() %></div>
                    <div>
                        <div class="satici-adi"><%= ilan.satici %></div>
                        <div class="satici-uzmanlik">🛒 Aktif Satıcı</div>
                    </div>
                </div>
                <button class="mesaj-at-btn" onclick="sohbetOdasiTetikle('<%= ilan.satici %>')">💬 Mesaj At</button>
            </div>

            <!-- AÇIKLAMA -->
            <% if (ilan.detay) { %>
                <div class="ilan-aciklama">
                    <strong style="color:#38bdf8;">📝 Ürün Açıklaması</strong>
                    <p style="margin-top:10px; margin-bottom:0;"><%= ilan.detay %></p>
                </div>
            <% } %>

            <!-- BUTONLAR -->
            <div class="buton-grup">
                <button class="btn btn-satin-al" id="satinAlBtn" onclick="ilanSatinAl('<%= ilan._id || ilan.id %>', <%= ilan.fiyat %>, '<%= ilan.satici %>', '<%= ilan.baslik.replace(/'/g, "\\'") %>')" <%= ilan.aktiflikDurumu === 'pasif' ? 'disabled' : '' %>>
                    🛒 Satın Al
                </button>
                <button class="btn btn-mesaj" onclick="sohbetOdasiTetikle('<%= ilan.satici %>')">💬 Satıcıya Mesaj At</button>
            </div>

            <!-- LİNK KOPYALA -->
            <div class="link-kopyala">
                <span style="color:#94a3b8; font-size:14px;">🔗 İlan Linki:</span>
                <input type="text" id="ilanLinkInput" value="https://itemlerinmarketi.onrender.com/ilan/<%= ilan._id || ilan.id %>" readonly>
                <button onclick="kopyalaLink()">📋 Kopyala</button>
            </div>

            <!-- İLAN SAHİBİ VEYA ADMIN9595 İSE DÜZENLE BUTONU (DÜZELTİLDİ) -->
            <div id="duzenleBtnContainer"></div>
            
        <% } %>
    </div>

    <script>
    // ============================================
    // İLAN DETAY SAYFASI - TAM SCRIPT
    // ============================================
    
    const aktif = JSON.parse(localStorage.getItem('aktifKullanici'));
    const ilanSatici = '<%= ilan ? ilan.satici : "" %>';
    const ilanId = '<%= ilan ? (ilan._id || ilan.id) : "" %>';

    // ============================================
    // DÜZENLE BUTONU KONTROLÜ (BU KISIM DÜZELTİLDİ)
    // ============================================
    const duzenleContainer = document.getElementById('duzenleBtnContainer');
    if (duzenleContainer && ilanSatici) {
        if (aktif && (aktif.kullaniciAdi === 'admin9595' || aktif.kullaniciAdi === ilanSatici)) {
            duzenleContainer.innerHTML = `
                <button class="btn btn-duzenle" onclick="window.location.href='/ilan-duzenle?id=${ilanId}'">
                    ⚙️ İlanı Düzenle
                </button>
            `;
        }
    }

    // ============================================
    // KOPYALA
    // ============================================
    function kopyalaLink() {
        const input = document.getElementById('ilanLinkInput');
        if (!input) return;
        input.select();
        input.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(input.value).then(() => {
            alert('✅ İlan linki kopyalandı!');
        }).catch(() => {
            document.execCommand('copy');
            alert('✅ İlan linki kopyalandı!');
        });
    }

    // ============================================
    // SATIN AL
    // ============================================
    function ilanSatinAl(id, fiyat, satici, baslik) {
        if (!aktif) {
            alert('⚠️ Satın almak için önce giriş yapmalısın kanka!');
            window.location.href = '/login';
            return;
        }
        
        if (aktif.kullaniciAdi === satici) {
            alert('❌ Kendi ilanını satın alamazsın kanka!');
            return;
        }
        
        if ((aktif.bakiye || 0) < parseFloat(fiyat)) {
            alert(`❌ Bakiyen yetersiz! Cüzdanında ${aktif.bakiye || 0} TL var.`);
            return;
        }

        if (confirm(`"${baslik}" ilanını ${fiyat} TL'ye satın almak istediğine emin misin?`)) {
            // Bakiye düş
            let kullanicilar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
            const aIdx = kullanicilar.findIndex(u => u.kullaniciAdi === aktif.kullaniciAdi);
            if (aIdx !== -1) {
                kullanicilar[aIdx].bakiye = parseFloat((kullanicilar[aIdx].bakiye - fiyat).toFixed(2));
                localStorage.setItem('kullanicilar', JSON.stringify(kullanicilar));
                aktif.bakiye = kullanicilar[aIdx].bakiye;
                localStorage.setItem('aktifKullanici', JSON.stringify(aktif));
                
                // Cüzdan güncelle
                const cuzdanElement = document.getElementById('cuzdanBakiyeYazi');
                if (cuzdanElement) {
                    cuzdanElement.innerText = aktif.bakiye + " ₺";
                }
            }

            // Bildirim gönder
            bildirimEkle(satici, `🎉 "${baslik}" ilanınız ${aktif.kullaniciAdi} tarafından satın alındı! Teslimat için iletişime geçin.`);
            bildirimEkle(aktif.kullaniciAdi, `🛍️ "${baslik}" ilanını başarıyla satın aldınız! Para havuzda güvende.`);

            // İlanı sil (MongoDB)
            fetch(`/api/ilan-sil/${id}`, {
                method: 'DELETE'
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert('✅ Satın alma başarılı! Para güvenli havuzda. Satıcı ile iletişime geçin.');
                    window.location.href = '/';
                } else {
                    alert('❌ İlan silinirken hata: ' + data.error);
                }
            })
            .catch(err => {
                alert('❌ Bağlantı hatası: ' + err.message);
            });
        }
    }

    // ============================================
    // SOHBET ODASI TETİKLE
    // ============================================
    function sohbetOdasiTetikle(saticiAdi) {
        if (!aktif) {
            alert('⚠️ Mesaj atmak için önce giriş yapmalısın kanka!');
            window.location.href = '/login';
            return;
        }
        if (aktif.kullaniciAdi === saticiAdi) {
            alert('📝 Kendine mesaj atamazsın kanka!');
            return;
        }
        // Ana sayfaya yönlendir ve sohbeti aç
        localStorage.setItem('sohbet_acilacak_kullanici', saticiAdi);
        window.location.href = '/';
    }

    // ============================================
    // BİLDİRİM EKLE
    // ============================================
    function bildirimEkle(kime, metin) {
        let tumBildirimler = JSON.parse(localStorage.getItem(`bildirimler_${kime}`) || '[]');
        tumBildirimler.unshift({ 
            id: Date.now(), 
            metin: metin, 
            durum: 'yeni', 
            tarih: new Date().toLocaleTimeString() 
        });
        localStorage.setItem(`bildirimler_${kime}`, JSON.stringify(tumBildirimler));
    }

    // ============================================
    // SATIN AL BUTONU (pasif ilanlarda devre dışı)
    // ============================================
    const aktiflikDurumu = '<%= ilan ? ilan.aktiflikDurumu : "pasif" %>';
    if (aktiflikDurumu === 'pasif') {
        const btn = document.getElementById('satinAlBtn');
        if (btn) {
            btn.disabled = true;
            btn.textContent = '⛔ Liste Dışı';
        }
    }

    // ============================================
    // ENTER İLE KOPYALA
    // ============================================
    const linkInput = document.getElementById('ilanLinkInput');
    if (linkInput) {
        linkInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                kopyalaLink();
            }
        });
    }

    console.log('📄 İlan detay sayfası yüklendi!');
    console.log('📦 İlan:', '<%= ilan ? ilan.baslik : "Bulunamadı" %>');
    console.log('👤 Satıcı:', ilanSatici);
    console.log('📌 ID:', ilanId);
    </script>
</body>
</html>