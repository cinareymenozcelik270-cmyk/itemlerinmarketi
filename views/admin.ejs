<!DOCTYPE html>
<html lang="tr">
<head>
    <meta name="google-adsense-account" content="ca-pub-7453399945201277">
    <meta name="google-site-verification" content="rXTtLPJavFhXvJ7TGofxQ3XXGZXb_B8dzSBNAPZwLFk" />
    <meta charset="UTF-8">
    <title>Yönetici Paneli - İtemlerinMarketi</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .ceza-btn { background-color: #f59e0b !important; color: #0f172a !important; padding: 5px 10px; font-size: 13px; font-weight: bold; border: none; border-radius: 4px; cursor: pointer; }
        .ceza-btn:hover { background-color: #d97706 !important; }
        .ban-btn { background-color: #ef4444 !important; color: white !important; padding: 5px 10px; font-size: 13px; font-weight: bold; border: none; border-radius: 4px; cursor: pointer; }
        .ban-btn:hover { background-color: #dc2626 !important; }
        .kaldir-btn { background-color: #10b981 !important; color: white !important; padding: 5px 10px; font-size: 13px; font-weight: bold; border: none; border-radius: 4px; cursor: pointer; }
        .kaldir-btn:hover { background-color: #059669 !important; }
        .hesap-sil-btn { background-color: #7f1d1d !important; color: white !important; padding: 5px 10px; font-size: 13px; font-weight: bold; border: none; border-radius: 4px; cursor: pointer; }
        .hesap-sil-btn:hover { background-color: #991b1b !important; }
        /* Panel İçi Kimlik Resim Tasarımları */
        .admin-kimlik-img { width: 140px; height: 90px; object-fit: cover; border-radius: 6px; border: 1px solid #475569; cursor: pointer; transition: transform 0.2s; }
        .admin-kimlik-img:hover { transform: scale(2.5); z-index: 9999; position: relative; }
    </style>
</head>
<body>
    <header>
        <div class="logo">İtemlerinMarketi (Yönetici Kontrolü)</div>
        <nav><a href="/">Ana Sayfa</a></nav>
    </header>
    <div class="container">
        
        <!-- 1. BÖLÜM: %18 Komisyonlu Bakiye Bildirimleri -->
        <h1>Gelen Bakiye Bildirimleri</h1>
        <div class="admin-list" id="adminListesi" style="margin-bottom: 50px;"></div>

        <!-- 2. BÖLÜM: Sohbet Şikayetleri Alanı -->
        <h1>Gelen Sohbet Şikayetleri (🚩)</h1>
        <div class="admin-list" id="sikayetListesiGövde" style="margin-bottom: 50px;"></div>

        <!-- 3. BÖLÜM: FOTOĞRAFLI KİMLİK KONTROLÜ VE LIMITSIZ PARA ÇEKME ALANI -->
        <h1>Gelen Para Çekme Talepleri (📷 Fotoğraflı Onay)</h1>
        <div class="admin-list" id="paraCekmeListesiGövde"></div>

    </div>

    <script>
        let ilkCezalar = JSON.parse(localStorage.getItem('sistemCezalilari') || '{}');
        if (ilkCezalar['admin9595']) { delete ilkCezalar['admin9595']; localStorage.setItem('sistemCezalilari', JSON.stringify(ilkCezalar)); }

        const aktif = JSON.parse(localStorage.getItem('aktifKullanici'));
        if (!aktif || aktif.rol !== 'admin') { alert('Bu sayfaya sadece admin9595 erişebilir!'); window.location.href = '/login'; }

        // SİSTEM BİLDİRİM EKLEME FONKSİYONU
        function sistemBildirimEkle(kime, metin) {
            let tumBildirimler = JSON.parse(localStorage.getItem(`bildirimler_${kime}`) || '[]');
            tumBildirimler.unshift({ id: Date.now(), metin: metin, durum: 'yeni', tarih: new Date().toLocaleTimeString() });
            localStorage.setItem(`bildirimler_${kime}`, JSON.stringify(tumBildirimler));
        }

        // %18 Komisyonlu Bakiye Onaylama Modülü
        function bakiyeListesiniYenile() {
            const listeAlani = document.getElementById('adminListesi'); listeAlani.innerHTML = '';
            let bildirimler = JSON.parse(localStorage.getItem('tumBakiyeBildirimleri') || '[]');
            if (bildirimler.length === 0) { listeAlani.innerHTML = '<p>Henüz gelen aktif bir bakiye bildirimi yok.</p>'; return; }
            bildirimler.forEach(b => {
                const kart = document.createElement('div'); kart.className = 'admin-item'; kart.style.marginBottom = '15px'; kart.style.padding = '15px'; kart.style.background = '#1e293b'; kart.style.borderRadius = '8px'; kart.style.display = 'flex'; kart.style.justifyContent = 'space-between'; kart.style.alignItems = 'center';
                let butonlarHTML = b.durum === 'Beklemede' ? `<div style="display: flex; gap: 10px;"><button onclick="bakiyeIslem(${b.id}, 'onayla')" class="btn" style="background-color: #10b981; padding: 5px 15px;">✓ Onayla</button><button onclick="bakiyeIslem(${b.id}, 'reddet')" class="btn" style="background-color: #ef4444; padding: 5px 15px;">✕ Reddet</button></div>` : `<span style="font-weight:bold; color:${b.durum === 'Onaylandı' ? '#10b981' : '#ef4444'}">${b.durum}</span>`;
                const netGelecek = (b.miktar * 0.82).toFixed(2);
                kart.innerHTML = `<div><strong>Kullanıcı:</strong> ${b.kullaniciAdi} <br><strong>Tutar:</strong> ${b.miktar} TL <br><strong>Net Gelecek (%18 Hariç):</strong> <strong style="color:#38bdf8;">${netGelecek} TL</strong></div>${butonlarHTML}`;
                listeAlani.appendChild(kart);
            });
        }

        function bakiyeIslem(id, aksiyon) {
            let bildirimler = JSON.parse(localStorage.getItem('tumBakiyeBildirimleri') || '[]');
            let kullanıcılar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
            const bIndex = bildirimler.findIndex(b => b.id === id);
            if (bIndex !== -1 && bildirimler[bIndex].durum === 'Beklemede') {
                if (aksiyon === 'onayla') {
                    bildirimler[bIndex].durum = 'Onaylandı';
                    const netMiktar = parseFloat((bildirimler[bIndex].miktar * 0.82).toFixed(2));
                    const uIndex = kullanıcılar.findIndex(u => u.kullaniciAdi === bildirimler[bIndex].kullaniciAdi);
                    if (uIndex !== -1) { 
                        kullanıcılar[uIndex].bakiye = parseFloat(((kullanıcılar[uIndex].bakiye || 0) + netMiktar).toFixed(2)); 
                        localStorage.setItem('kullanicilar', JSON.stringify(kullanıcılar)); 
                        if (aktif.kullaniciAdi === bildirimler[bIndex].kullaniciAdi) { 
                            aktif.bakiye = kullanıcılar[uIndex].bakiye; 
                            localStorage.setItem('aktifKullanici', JSON.stringify(aktif)); 
                        }
                    }
                    sistemBildirimEkle(bildirimler[bIndex].kullaniciAdi, `💰 ${bildirimler[bIndex].miktar} TL bakiye yükleme talebiniz onaylandı! %18 komisyon düşülerek net ${netMiktar} TL cüzdanınıza yatırıldı.`);
                    alert("✅ Bakiye onaylandı! %18 komisyon düşüldü.");
                } else { 
                    bildirimler[bIndex].durum = 'Reddedildi';
                    sistemBildirimEkle(bildirimler[bIndex].kullaniciAdi, `❌ ${bildirimler[bIndex].miktar} TL bakiye yükleme talebiniz reddedildi.`);
                    alert("❌ Bakiye talebi reddedildi.");
                }
                localStorage.setItem('tumBakiyeBildirimleri', JSON.stringify(bildirimler)); 
                bakiyeListesiniYenile();
            }
        }

        // Şikayet Modülü (GÜNCELLENDİ - Hesap Silme Butonu Eklendi)
        function sikayetListesiniYukle() {
            const govde = document.getElementById('sikayetListesiGövde'); 
            govde.innerHTML = '';
            let sikayetler = JSON.parse(localStorage.getItem('kullaniciSikayetleri') || '[]');
            let cezalar = JSON.parse(localStorage.getItem('sistemCezalilari') || '{}');
            
            if(sikayetler.length === 0) { 
                govde.innerHTML = '<p style="color:#94a3b8;">Aktif şikayet bulunmuyor.</p>'; 
                return; 
            }
            
            sikayetler.forEach(s => {
                const kart = document.createElement('div'); 
                kart.className = 'admin-item'; 
                kart.style.marginBottom = '15px'; 
                kart.style.padding = '15px'; 
                kart.style.background = '#1e293b'; 
                kart.style.borderRadius = '8px'; 
                kart.style.borderLeft = '4px solid #ef4444'; 
                kart.style.display = 'flex'; 
                kart.style.justifyContent = 'space-between'; 
                kart.style.alignItems = 'center';
                
                let eylemButonlariHTML = cezalar[s.suclu] ? 
                    `<button onclick="cezayiKaldir('${s.suclu}')" class="kaldir-btn">🔓 Cezayı Kaldır</button>` : 
                    `<div style="display:flex; flex-direction:column; gap:6px;">
                        <button onclick="cezaVer('${s.suclu}', 'chat_mute')" class="ceza-btn">🔇 Sustur</button>
                        <button onclick="cezaVer('${s.suclu}', 'sureli_ban')" class="ban-btn">⏳ 1 Gün Ban</button>
                        <button onclick="cezaVer('${s.suclu}', 'hesap_ban')" class="ban-btn" style="background-color:#991b1b !important;">❌ Sınırsız</button>
                        <button onclick="adminHesabiTamamenSil('${s.suclu}')" class="hesap-sil-btn">🗑️ Hesabı Sistemden Sil</button>
                    </div>`;
                
                kart.innerHTML = `
                    <div>
                        <strong>Suçlu:</strong> ${s.suclu}<br>
                        <strong>Mesaj:</strong> "${s.mesaj}"<br>
                        <strong>Neden:</strong> ${s.neden}
                    </div>
                    <div style="display:flex; flex-direction:column; gap:6px;">
                        ${eylemButonlariHTML}
                        <button onclick="sikayetSil(${s.id})" class="btn" style="font-size:12px; background-color:#475569;">🗑️ Sil</button>
                    </div>
                `;
                govde.appendChild(kart);
            });
        }

        function cezaVer(kullaniciAdi, cezaTuru) { 
            if (kullaniciAdi === 'admin9595') {
                alert("Admin'e ceza verilemez!");
                return; 
            }
            let cezaliListesi = JSON.parse(localStorage.getItem('sistemCezalilari') || '{}'); 
            if (cezaTuru === 'chat_mute') { 
                cezaliListesi[kullaniciAdi] = { tur: 'mute', bitis: Date.now() + (1*60*60*1000) };
                sistemBildirimEkle(kullaniciAdi, `🔇 1 saatliğine sohbetten susturuldunuz.`);
                alert(`🔇 ${kullaniciAdi} 1 saatliğine susturuldu.`);
            } else if (cezaTuru === 'sureli_ban') { 
                cezaliListesi[kullaniciAdi] = { tur: 'ban', bitis: Date.now() + (24*60*60*1000) };
                sistemBildirimEkle(kullaniciAdi, `⏳ 1 günlüğüne banlandınız.`);
                alert(`⏳ ${kullaniciAdi} 1 günlüğüne banlandı.`);
            } else if (cezaTuru === 'hesap_ban') { 
                cezaliListesi[kullaniciAdi] = { tur: 'ban', bitis: 'sinirsiz' };
                sistemBildirimEkle(kullaniciAdi, `❌ Hesabınız sınırsız olarak banlandı.`);
                alert(`❌ ${kullaniciAdi} sınırsız olarak banlandı.`);
            } 
            localStorage.setItem('sistemCezalilari', JSON.stringify(cezaliListesi)); 
            sikayetListesiniYukle(); 
        }

        function cezayiKaldir(kullaniciAdi) { 
            let cezaliListesi = JSON.parse(localStorage.getItem('sistemCezalilari') || '{}'); 
            if (cezaliListesi[kullaniciAdi]) { 
                delete cezaliListesi[kullaniciAdi]; 
                localStorage.setItem('sistemCezalilari', JSON.stringify(cezaliListesi)); 
                sistemBildirimEkle(kullaniciAdi, `🔓 Cezanız kaldırıldı.`);
                alert(`🔓 ${kullaniciAdi}'nin cezası kaldırıldı.`);
                sikayetListesiniYukle(); 
            } 
        }

        function sikayetSil(id) { 
            let sikayetler = JSON.parse(localStorage.getItem('kullaniciSikayetleri') || '[]'); 
            localStorage.setItem('kullaniciSikayetleri', JSON.stringify(sikayetler.filter(s => s.id !== id))); 
            alert("Şikayet silindi.");
            sikayetListesiniYukle(); 
        }

        // --- HESABI TAMAMEN SİLME FONKSİYONU ---
        function adminHesabiTamamenSil(silinecekKullanici) {
            if (silinecekKullanici === 'admin9595') { 
                alert("Hata: Kendi admin hesabını silemezsin kanka!"); 
                return; 
            }
            
            if (confirm(`DİKKAT ÇINAR: "${silinecekKullanici}" adlı hesabı, tüm ilanlarını ve cüzdanını sistemden TAMAMEN SİLMEK istediğine emin misin?`)) {
                // 1. Kullanıcıyı veritabanından uçur kanka
                let kullanicilar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
                kullanicilar = kullanicilar.filter(u => u.kullaniciAdi !== silinecekKullanici);
                localStorage.setItem('kullanicilar', JSON.stringify(kullanicilar));

                // 2. Bu adamın pazarda açtığı tüm ilanları da temizle
                let pazardakiIlanlar = JSON.parse(localStorage.getItem('pazardakiIlanlar') || '[]');
                pazardakiIlanlar = pazardakiIlanlar.filter(ilan => ilan.satici !== silinecekKullanici);
                localStorage.setItem('pazardakiIlanlar', JSON.stringify(pazardakiIlanlar));

                // 3. Kullanıcıya ait tüm bildirimleri temizle
                localStorage.removeItem(`bildirimler_${silinecekKullanici}`);

                // 4. Kullanıcıya ait tüm özel sohbet odalarını temizle
                let silinecekAnahtarlar = [];
                for (let i = 0; i < localStorage.length; i++) {
                    const anahtar = localStorage.key(i);
                    if (anahtar && anahtar.startsWith('ozel_oda_') && anahtar.includes(silinecekKullanici)) {
                        silinecekAnahtarlar.push(anahtar);
                    }
                }
                silinecekAnahtarlar.forEach(anahtar => localStorage.removeItem(anahtar));

                // 5. Eğer adam o an sitede açıksa oturumunu da patlat
                let aktifOlan = JSON.parse(localStorage.getItem('aktifKullanici'));
                if (aktifOlan && aktifOlan.kullaniciAdi === silinecekKullanici) {
                    localStorage.removeItem('aktifKullanici');
                }

                alert(`Başarılı! "${silinecekKullanici}" kullanıcısı ve tüm pazar izleri dünyadan tamamen silindi.`);
                window.location.reload(); // Paneli tazele kanka
            }
        }

        // --- FOTOĞRAFLI KİMLİK KONTROLLÜ PARA ÇEKME LİSTESİ ---
        function paraCekmeListesiniYukle() {
            const govde = document.getElementById('paraCekmeListesiGövde');
            govde.innerHTML = '';
            let talepler = JSON.parse(localStorage.getItem('paraCekmeTalepleri') || '[]');
            if (talepler.length === 0) { govde.innerHTML = '<p style="color:#94a3b8;">Banka para çekme talebi yok.</p>'; return; }

            talepler.forEach(t => {
                const kart = document.createElement('div'); 
                kart.className = 'admin-item'; 
                kart.style.marginBottom = '15px'; 
                kart.style.padding = '15px'; 
                kart.style.background = '#1e293b'; 
                kart.style.borderRadius = '8px'; 
                kart.style.borderLeft = '4px solid #10b981'; 
                kart.style.display = 'flex'; 
                kart.style.justifyContent = 'space-between'; 
                kart.style.alignItems = 'center';
                
                let eylemButonlari = t.durum === 'Beklemede' ? 
                    `<div style="display: flex; gap: 10px;">
                        <button onclick="paraCekmeKarar(${t.id}, 'onayla')" class="btn" style="background-color: #10b981; padding: 5px 15px;">✓ Fotoğraflar Doğru, Gönderdim</button>
                        <button onclick="paraCekmeKarar(${t.id}, 'reddet')" class="btn" style="background-color: #ef4444; padding: 5px 15px;">✕ Sahte Fotoğraf / Reddet</button>
                    </div>` : 
                    `<span style="font-weight:bold; color:${t.durum === 'Ödendi' ? '#10b981' : '#ef4444'}">${t.durum}</span>`;
                
                const netOdenecek = t.miktar - 10 > 0 ? t.miktar - 10 : 0;

                kart.innerHTML = `
                    <div>
                        <span style="color:#10b981; font-weight:bold;">🔒 KİMLİK ONAYLI TALEP</span><br>
                        <strong>Kullanıcı:</strong> ${t.kullanici}<br>
                        <strong>Ad Soyad:</strong> ${t.isim}<br>
                        <strong>T.C. Kimlik No:</strong> <span style="color:#f59e0b; font-family:monospace;">${t.tc || 'Belirtilmedi'}</span><br>
                        <strong>Telefon:</strong> ${t.telefon || 'Belirtilmedi'}<br>
                        <strong>Ödenecek Net (10 TL Komisyon Hariç):</strong> <strong style="color:#10b981; font-size:15px;">${netOdenecek} TL</strong><br>
                        <strong>IBAN:</strong> <span style="font-family:monospace;">${t.iban}</span> <br>
                        <div style="display:flex; gap:10px; margin-top:8px;">
                            <img src="${t.kimlikOn}" class="admin-kimlik-img">
                            <img src="${t.kimlikArka}" class="admin-kimlik-img">
                        </div>
                    </div>
                    ${eylemButonlari}
                `;
                govde.appendChild(kart);
            });
        }

        function paraCekmeKarar(id, aksiyon) {
            let talepler = JSON.parse(localStorage.getItem('paraCekmeTalepleri') || '[]');
            const tIdx = talepler.findIndex(t => t.id === id);
            if (tIdx !== -1 && talepler[tIdx].durum === 'Beklemede') {
                const hKul = talepler[tIdx].kullanici;
                const nOdenecek = talepler[tIdx].miktar - 10 > 0 ? talepler[tIdx].miktar - 10 : 0;
                
                if (aksiyon === 'onayla') {
                    talepler[tIdx].durum = 'Ödendi';
                    sistemBildirimEkle(hKul, `💰 Para çekme talebiniz onaylandı! 10 TL işlem ücreti düşülerek net ${nOdenecek} TL banka hesabınıza transfer edildi.`);
                    alert("✅ Para çekme talebi onaylandı! Kullanıcıya bildirim gönderildi.");
                } else {
                    talepler[tIdx].durum = 'Reddedildi';
                    
                    // Kullanıcının bakiyesini iade et
                    let kullanıcılar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
                    const uIdx = kullanıcılar.findIndex(u => u.kullaniciAdi === hKul);
                    if (uIdx !== -1) { 
                        kullanıcılar[uIdx].bakiye = parseFloat(((kullanıcılar[uIdx].bakiye || 0) + talepler[tIdx].miktar).toFixed(2)); 
                        localStorage.setItem('kullanicilar', JSON.stringify(kullanıcılar)); 
                    }
                    
                    sistemBildirimEkle(hKul, `❌ Para çekme talebiniz kurucu tarafından iptal edildi. ${talepler[tIdx].miktar} TL cüzdan bakiyenize iade edildi.`);
                    alert("❌ Para çekme talebi reddedildi ve kullanıcının bakiyesi iade edildi.");
                }
                
                localStorage.setItem('paraCekmeTalepleri', JSON.stringify(talepler));
                paraCekmeListesiniYukle();
            }
        }

        // SAYFA AÇILDIĞINDA TÜM LİSTELERİ SIFIRDAN TETİKLEYEN SİHİRLİ SATIRLAR
        bakiyeListesiniYenile();
        sikayetListesiniYukle();
        paraCekmeListesiniYukle();
    </script>
</body>
</html>