<!DOCTYPE html>
<html lang="tr">
<head>
    <meta name="google-adsense-account" content="ca-pub-7453399945201277">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7453399945201277" crossorigin="anonymous"></script>
    <meta name="google-site-verification" content="rXTtLPJavFhXvJ7TGofxQ3XXGZXb_B8dzSBNAPZwLFk" />
    <meta charset="UTF-8">
    <title>🛡️ Yönetim Merkezi - İtemlerinMarketi</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #0a0a1a;
            color: #e8e8f0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ✨ COOL GLOW BACKGROUND */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background:
                radial-gradient(ellipse at 10% 20%, rgba(99, 102, 241, 0.12) 0%, transparent 50%),
                radial-gradient(ellipse at 90% 80%, rgba(168, 85, 247, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(16, 185, 129, 0.05) 0%, transparent 70%);
            z-index: -1;
            pointer-events: none;
        }

        /* ⚡ HEADER - GLASS EFFECT */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 40px;
            background: rgba(10, 10, 26, 0.7);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            position: sticky;
            top: 0;
            z-index: 100;
            flex-wrap: wrap;
            gap: 12px;
        }
        header .logo {
            font-size: 22px;
            font-weight: 800;
            color: white;
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255,255,255,0.03);
            padding: 4px 18px 4px 12px;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.04);
        }
        header .logo i {
            color: #f59e0b;
            font-size: 20px;
        }
        header .logo .badge-admin {
            font-size: 10px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #0f172a;
            padding: 2px 10px;
            border-radius: 50px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        header nav {
            display: flex;
            gap: 8px;
        }
        header nav a {
            color: #8a8aaa;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            padding: 8px 18px;
            border-radius: 50px;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 6px;
            border: 1px solid transparent;
        }
        header nav a:hover {
            background: rgba(255, 255, 255, 0.04);
            color: white;
            border-color: rgba(255, 255, 255, 0.06);
        }
        header nav a.active {
            background: rgba(99, 102, 241, 0.15);
            color: #a5b4fc;
            border-color: rgba(99, 102, 241, 0.15);
        }
        header nav a i {
            color: #6366f1;
        }

        /* 📦 CONTAINER */
        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 28px 24px 60px;
        }

        /* 🏆 SAYFA BAŞLIĞI */
        .sayfa-baslik {
            font-size: 32px;
            font-weight: 800;
            color: white;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .sayfa-baslik i {
            color: #f59e0b;
            font-size: 30px;
        }
        .sayfa-baslik span {
            font-weight: 400;
            color: #5a5a7a;
            font-size: 16px;
            background: rgba(255,255,255,0.03);
            padding: 4px 14px;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.04);
        }
        .sayfa-baslik .live-dot {
            width: 10px;
            height: 10px;
            background: #10b981;
            border-radius: 50%;
            display: inline-block;
            animation: pulse 2s infinite;
            margin-left: 4px;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.8); }
        }

        /* 📋 BÖLÜMLER */
        .bolum {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 24px 28px;
            margin-bottom: 28px;
            backdrop-filter: blur(10px);
            transition: all 0.3s;
        }
        .bolum:hover {
            border-color: rgba(255, 255, 255, 0.07);
        }
        .bolum-baslik {
            font-size: 18px;
            font-weight: 700;
            color: white;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .bolum-baslik .icon-box {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }
        .bolum-baslik .icon-box.mor { background: rgba(99, 102, 241, 0.15); color: #a5b4fc; }
        .bolum-baslik .icon-box.yesil { background: rgba(16, 185, 129, 0.15); color: #34d399; }
        .bolum-baslik .icon-box.sari { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
        .bolum-baslik .icon-box.kirmizi { background: rgba(239, 68, 68, 0.15); color: #f87171; }

        .bolum-baslik .badge {
            font-size: 11px;
            font-weight: 600;
            padding: 3px 12px;
            border-radius: 50px;
            letter-spacing: 0.3px;
        }
        .badge-aktif { background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.1); }
        .badge-bekleme { background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.1); }
        .badge-acil { background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.1); }

        /* 📭 BOŞ MESAJ */
        .bos-mesaj {
            color: #5a5a7a;
            text-align: center;
            padding: 40px 20px;
            font-size: 15px;
        }
        .bos-mesaj i {
            font-size: 36px;
            display: block;
            margin-bottom: 12px;
            color: #3a3a5a;
        }
        .bos-mesaj .alt {
            font-size: 13px;
            color: #3a3a5a;
        }

        /* 🃏 İTEM KARTLARI */
        .admin-item {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 16px 22px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            transition: all 0.3s;
            position: relative;
        }
        .admin-item:hover {
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.07);
            transform: translateX(4px);
        }
        .admin-item .bilgi {
            flex: 1;
            min-width: 200px;
        }
        .admin-item .bilgi .kisi {
            color: white;
            font-weight: 600;
            font-size: 15px;
        }
        .admin-item .bilgi .kisi i {
            color: #38bdf8;
            margin-right: 4px;
        }
        .admin-item .bilgi .detay {
            color: #8a8aaa;
            font-size: 13px;
            margin-top: 2px;
        }
        .admin-item .bilgi .detay .vurgu {
            color: #34d399;
            font-weight: 600;
        }
        .admin-item .bilgi .detay .vurgu.mavi { color: #38bdf8; }
        .admin-item .bilgi .detay .vurgu.sari { color: #fbbf24; }
        .admin-item .bilgi .detay .vurgu.kirmizi { color: #f87171; }

        /* 🎯 BUTONLAR */
        .btn {
            padding: 7px 16px;
            border: none;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            letter-spacing: 0.2px;
        }
        .btn:hover { transform: scale(1.04); }
        .btn:active { transform: scale(0.95); }

        .btn-yesil { background: linear-gradient(135deg, #10b981, #059669); color: white; box-shadow: 0 4px 16px rgba(16, 185, 129, 0.2); }
        .btn-yesil:hover { box-shadow: 0 6px 24px rgba(16, 185, 129, 0.35); }
        .btn-kirmizi { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; box-shadow: 0 4px 16px rgba(239, 68, 68, 0.2); }
        .btn-kirmizi:hover { box-shadow: 0 6px 24px rgba(239, 68, 68, 0.35); }
        .btn-mor { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; box-shadow: 0 4px 16px rgba(99, 102, 241, 0.2); }
        .btn-mor:hover { box-shadow: 0 6px 24px rgba(99, 102, 241, 0.35); }
        .btn-sari { background: linear-gradient(135deg, #f59e0b, #d97706); color: #0f172a; box-shadow: 0 4px 16px rgba(245, 158, 11, 0.15); }
        .btn-sari:hover { box-shadow: 0 6px 24px rgba(245, 158, 11, 0.25); }
        .btn-gri { background: rgba(255, 255, 255, 0.05); color: #8a8aaa; border: 1px solid rgba(255, 255, 255, 0.06); }
        .btn-gri:hover { background: rgba(255, 255, 255, 0.1); color: white; }
        .btn-bordo { background: #7f1d1d; color: white; }
        .btn-bordo:hover { background: #991b1b; box-shadow: 0 4px 16px rgba(127, 29, 29, 0.3); }
        .btn-x {
            background: rgba(239, 68, 68, 0.08);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.1);
            padding: 4px 10px;
            font-size: 13px;
            border-radius: 50px;
        }
        .btn-x:hover { background: rgba(239, 68, 68, 0.2); color: white; transform: scale(1.1); }

        .btn-grup {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
        }
        .btn-grup .btn { font-size: 11px; padding: 5px 14px; }

        /* 🖼️ KİMLİK */
        .admin-kimlik-img {
            width: 90px;
            height: 58px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            cursor: pointer;
            transition: transform 0.3s;
        }
        .admin-kimlik-img:hover {
            transform: scale(2.2);
            z-index: 9999;
            position: relative;
        }
        .kimlik-grup {
            display: flex;
            gap: 10px;
            margin-top: 6px;
        }

        /* 🔔 TOAST */
        .toast-custom {
            position: fixed;
            bottom: 100px;
            right: 24px;
            background: rgba(20, 20, 42, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(99, 102, 241, 0.2);
            color: white;
            padding: 16px 24px;
            border-radius: 16px;
            font-weight: 600;
            font-size: 15px;
            box-shadow: 0 12px 48px rgba(0,0,0,0.5);
            z-index: 9999;
            animation: slideIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            max-width: 380px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-left: 4px solid #6366f1;
        }
        .toast-custom i { font-size: 22px; color: #fbbf24; }
        .toast-custom .kapat-toast {
            background: none;
            border: none;
            color: #5a5a7a;
            cursor: pointer;
            font-size: 18px;
            margin-left: 4px;
            transition: color 0.3s;
        }
        .toast-custom .kapat-toast:hover { color: white; }

        @keyframes slideIn {
            from { transform: translateX(60px) scale(0.95); opacity: 0; }
            to { transform: translateX(0) scale(1); opacity: 1; }
        }
        @keyframes slideOut {
            from { transform: translateX(0) scale(1); opacity: 1; }
            to { transform: translateX(60px) scale(0.95); opacity: 0; }
        }

        /* 📱 RESPONSIVE */
        @media (max-width: 768px) {
            header { padding: 12px 20px; }
            .container { padding: 16px; }
            .sayfa-baslik { font-size: 24px; flex-wrap: wrap; }
            .bolum { padding: 16px 18px; }
            .admin-item { flex-direction: column; align-items: stretch; padding: 14px 16px; }
            .admin-item .bilgi { min-width: auto; }
            .btn-grup { justify-content: flex-start; }
            .toast-custom { right: 16px; left: 16px; max-width: none; bottom: 80px; }
        }
        @media (max-width: 480px) {
            header .logo { font-size: 16px; padding: 4px 12px; }
            .sayfa-baslik { font-size: 20px; }
            .sayfa-baslik span { font-size: 12px; }
            .bolum-baslik { font-size: 15px; }
            .admin-item { padding: 12px; }
            .btn { font-size: 10px; padding: 4px 10px; }
        }
    </style>
</head>
<body>

    <!-- ============================================ -->
    <!-- HEADER -->
    <!-- ============================================ -->
    <header>
        <div class="logo">
            <i class="fas fa-crown"></i>
            <span>İtemlerinMarketi</span>
            <span class="badge-admin">YÖNETİM</span>
        </div>
        <nav>
            <a href="/"><i class="fas fa-home"></i> Pazar</a>
            <a href="/yonetici-paneli" class="active"><i class="fas fa-robot"></i> Kontrol</a>
        </nav>
    </header>

    <!-- ============================================ -->
    <!-- ANA İÇERİK -->
    <!-- ============================================ -->
    <div class="container">

        <!-- BAŞLIK -->
        <div class="sayfa-baslik">
            <i class="fas fa-robot"></i>
            Yönetim Merkezi
            <span>🔒 <span class="live-dot"></span> Canlı</span>
        </div>

        <!-- 1. BÖLÜM: BAKİYE -->
        <div class="bolum">
            <div class="bolum-baslik">
                <span class="icon-box yesil"><i class="fas fa-coins"></i></span>
                Bakiye Yüklemeleri
                <span class="badge badge-aktif">%18 Komisyon</span>
            </div>
            <div id="adminListesi"></div>
        </div>

        <!-- 2. BÖLÜM: ŞİKAYETLER -->
        <div class="bolum">
            <div class="bolum-baslik">
                <span class="icon-box kirmizi"><i class="fas fa-flag"></i></span>
                Şikayetler
                <span class="badge badge-acil">🚨</span>
            </div>
            <div id="sikayetListesiGövde"></div>
        </div>

        <!-- 3. BÖLÜM: PARA ÇEKME -->
        <div class="bolum">
            <div class="bolum-baslik">
                <span class="icon-box sari"><i class="fas fa-credit-card"></i></span>
                Para Çekme Talepleri
                <span class="badge badge-bekleme">📷 Kimlikli</span>
            </div>
            <div id="paraCekmeListesiGövde"></div>
        </div>

        <!-- 4. BÖLÜM: İLAN RAPORLARI -->
        <div class="bolum">
            <div class="bolum-baslik">
                <span class="icon-box kirmizi"><i class="fas fa-triangle-exclamation"></i></span>
                İlan Raporları
                <span class="badge badge-acil">YENİ</span>
            </div>
            <div id="ilanRaporlariListesiGövde"></div>
        </div>

    </div>

    <!-- ============================================ -->
    <!-- SCRİPT -->
    <!-- ============================================ -->
    <script>
        // ============================================
        // 🔔 SİSTEM BİLDİRİM SİSTEMİ (SES + TOAST)
        // ============================================

        const bildirimSesi = new Audio('/bildirim.mp3');
        let sonBildirimSayisi = 0;

        function bildirimKontrol() {
            const bildirimler = JSON.parse(localStorage.getItem('tumBakiyeBildirimleri') || '[]');
            const bekleyenler = bildirimler.filter(b => b.durum === 'Beklemede');
            
            if (bekleyenler.length > sonBildirimSayisi) {
                bildirimSesi.play().catch(() => {});
                sonBildirimSayisi = bekleyenler.length;
                const yeni = bekleyenler[0];
                if (yeni) {
                    showToast(`
                        <i class="fas fa-coins" style="color:#fbbf24;"></i>
                        <span><strong>${yeni.kullaniciAdi}</strong> · ${yeni.miktar} TL</span>
                        <button class="kapat-toast" onclick="this.parentElement.remove()">✕</button>
                    `);
                }
            }
            if (bekleyenler.length < sonBildirimSayisi) {
                sonBildirimSayisi = bekleyenler.length;
            }
        }

        function showToast(html) {
            const toast = document.createElement('div');
            toast.className = 'toast-custom';
            toast.innerHTML = html;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.animation = 'slideOut 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
                setTimeout(() => toast.remove(), 450);
            }, 5000);
        }

        // ============================================
        // 🧠 ADMIN PANELİ - TAM SCRIPT
        // ============================================

        // Admin kontrolü
        let ilkCezalar = JSON.parse(localStorage.getItem('sistemCezalilari') || '{}');
        if (ilkCezalar['admin9595']) {
            delete ilkCezalar['admin9595'];
            localStorage.setItem('sistemCezalilari', JSON.stringify(ilkCezalar));
        }

        const aktif = JSON.parse(localStorage.getItem('aktifKullanici'));
        if (!aktif || aktif.rol !== 'admin') {
            alert('⛔ Bu alan sadece yönetici içindir!');
            window.location.href = '/login';
        }

        // Sistem bildirim ekle
        function sistemBildirimEkle(kime, metin) {
            let tum = JSON.parse(localStorage.getItem(`bildirimler_${kime}`) || '[]');
            tum.unshift({ id: Date.now(), metin: metin, durum: 'yeni', tarih: new Date().toLocaleTimeString() });
            localStorage.setItem(`bildirimler_${kime}`, JSON.stringify(tum));
        }

        // ============================================
        // 📦 BAKİYE BİLDİRİMLERİ
        // ============================================
        function bakiyeListesiniYenile() {
            const alan = document.getElementById('adminListesi');
            alan.innerHTML = '';
            let list = JSON.parse(localStorage.getItem('tumBakiyeBildirimleri') || '[]');
            if (list.length === 0) {
                alan.innerHTML = `<div class="bos-mesaj"><i class="fas fa-inbox"></i>Bekleyen bakiye yok.<div class="alt">Yeni bildirimler burada görünür.</div></div>`;
                return;
            }
            list.forEach(b => {
                const kart = document.createElement('div');
                kart.className = 'admin-item';
                const net = (b.miktar * 0.82).toFixed(2);
                let btn = b.durum === 'Beklemede' ?
                    `<div class="btn-grup">
                        <button onclick="bakiyeIslem(${b.id},'onayla')" class="btn btn-yesil"><i class="fas fa-check"></i> Onayla</button>
                        <button onclick="bakiyeIslem(${b.id},'reddet')" class="btn btn-kirmizi"><i class="fas fa-times"></i> Red</button>
                        <button onclick="bakiyeSil(${b.id})" class="btn btn-x"><i class="fas fa-times"></i></button>
                    </div>` :
                    `<div class="btn-grup">
                        <span style="color:${b.durum === 'Onaylandı' ? '#34d399' : '#f87171'}; font-weight:600;">${b.durum}</span>
                        <button onclick="bakiyeSil(${b.id})" class="btn btn-x"><i class="fas fa-times"></i></button>
                    </div>`;
                kart.innerHTML = `
                    <div class="bilgi">
                        <div class="kisi"><i class="fas fa-user"></i> ${b.kullaniciAdi}</div>
                        <div class="detay">${b.miktar} TL → <span class="vurgu">${net} TL</span> <span style="color:#5a5a7a;font-size:11px;">(komisyon sonrası)</span></div>
                    </div>
                    ${btn}
                `;
                alan.appendChild(kart);
            });
        }

        function bakiyeSil(id) {
            if (!confirm('Bu bildirimi sil?')) return;
            let list = JSON.parse(localStorage.getItem('tumBakiyeBildirimleri') || '[]');
            list = list.filter(b => b.id !== id);
            localStorage.setItem('tumBakiyeBildirimleri', JSON.stringify(list));
            bakiyeListesiniYenile();
        }

        function bakiyeIslem(id, aksiyon) {
            let list = JSON.parse(localStorage.getItem('tumBakiyeBildirimleri') || '[]');
            let users = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
            const idx = list.findIndex(b => b.id === id);
            if (idx === -1 || list[idx].durum !== 'Beklemede') return;

            if (aksiyon === 'onayla') {
                list[idx].durum = 'Onaylandı';
                const net = parseFloat((list[idx].miktar * 0.82).toFixed(2));
                const uIdx = users.findIndex(u => u.kullaniciAdi === list[idx].kullaniciAdi);
                if (uIdx !== -1) {
                    users[uIdx].bakiye = parseFloat(((users[uIdx].bakiye || 0) + net).toFixed(2));
                    localStorage.setItem('kullanicilar', JSON.stringify(users));
                    if (aktif.kullaniciAdi === list[idx].kullaniciAdi) {
                        aktif.bakiye = users[uIdx].bakiye;
                        localStorage.setItem('aktifKullanici', JSON.stringify(aktif));
                    }
                }
                sistemBildirimEkle(list[idx].kullaniciAdi, `💰 ${list[idx].miktar} TL yüklemen onaylandı! Net ${net} TL hesabına yatırıldı.`);
                showToast(`✅ ${list[idx].kullaniciAdi} - ${net} TL onaylandı`);
            } else {
                list[idx].durum = 'Reddedildi';
                sistemBildirimEkle(list[idx].kullaniciAdi, `❌ ${list[idx].miktar} TL yüklemen reddedildi.`);
                showToast(`❌ ${list[idx].kullaniciAdi} reddedildi`);
            }
            localStorage.setItem('tumBakiyeBildirimleri', JSON.stringify(list));
            bakiyeListesiniYenile();
        }

        // ============================================
        // 🚩 ŞİKAYETLER
        // ============================================
        function sikayetListesiniYukle() {
            const alan = document.getElementById('sikayetListesiGövde');
            alan.innerHTML = '';
            let list = JSON.parse(localStorage.getItem('kullaniciSikayetleri') || '[]');
            let cezalar = JSON.parse(localStorage.getItem('sistemCezalilari') || '{}');
            if (list.length === 0) {
                alan.innerHTML = `<div class="bos-mesaj"><i class="fas fa-shield-alt"></i>Şikayet yok.<div class="alt">Herkes mutlu görünüyor 🌟</div></div>`;
                return;
            }
            list.forEach(s => {
                const kart = document.createElement('div');
                kart.className = 'admin-item';
                kart.style.borderLeft = '3px solid #ef4444';
                let btn = cezalar[s.suclu] ?
                    `<div class="btn-grup">
                        <button onclick="cezayiKaldir('${s.suclu}')" class="btn btn-yesil"><i class="fas fa-unlock"></i> Kaldır</button>
                        <button onclick="sikayetSil(${s.id})" class="btn btn-x"><i class="fas fa-times"></i></button>
                    </div>` :
                    `<div class="btn-grup">
                        <button onclick="cezaVer('${s.suclu}','chat_mute')" class="btn btn-sari"><i class="fas fa-microphone-slash"></i> Sustur</button>
                        <button onclick="cezaVer('${s.suclu}','sureli_ban')" class="btn btn-kirmizi"><i class="fas fa-clock"></i> 1 Gün</button>
                        <button onclick="cezaVer('${s.suclu}','hesap_ban')" class="btn btn-kirmizi" style="background:#991b1b;"><i class="fas fa-ban"></i> ∞</button>
                        <button onclick="adminHesabiTamamenSil('${s.suclu}')" class="btn btn-bordo"><i class="fas fa-trash"></i></button>
                        <button onclick="sikayetSil(${s.id})" class="btn btn-x"><i class="fas fa-times"></i></button>
                    </div>`;
                kart.innerHTML = `
                    <div class="bilgi">
                        <div class="kisi"><i class="fas fa-user" style="color:#f87171;"></i> ${s.suclu}</div>
                        <div class="detay">"${s.mesaj}" <span class="vurgu sari">· ${s.neden}</span></div>
                    </div>
                    ${btn}
                `;
                alan.appendChild(kart);
            });
        }

        function cezaVer(kAdi, tur) {
            if (kAdi === 'admin9595') { alert('Admin dokunulmaz!'); return; }
            let list = JSON.parse(localStorage.getItem('sistemCezalilari') || '{}');
            if (tur === 'chat_mute') {
                list[kAdi] = { tur: 'mute', bitis: Date.now() + 3600000 };
                sistemBildirimEkle(kAdi, '🔇 1 saat susturuldun.');
            } else if (tur === 'sureli_ban') {
                list[kAdi] = { tur: 'ban', bitis: Date.now() + 86400000 };
                sistemBildirimEkle(kAdi, '⏳ 1 gün banlandın.');
            } else if (tur === 'hesap_ban') {
                list[kAdi] = { tur: 'ban', bitis: 'sinirsiz' };
                sistemBildirimEkle(kAdi, '❌ Sınırsız ban.');
            }
            localStorage.setItem('sistemCezalilari', JSON.stringify(list));
            sikayetListesiniYukle();
        }

        function cezayiKaldir(kAdi) {
            let list = JSON.parse(localStorage.getItem('sistemCezalilari') || '{}');
            if (list[kAdi]) {
                delete list[kAdi];
                localStorage.setItem('sistemCezalilari', JSON.stringify(list));
                sistemBildirimEkle(kAdi, '🔓 Cezan kaldırıldı.');
                sikayetListesiniYukle();
            }
        }

        function sikayetSil(id) {
            if (!confirm('Şikayeti sil?')) return;
            let list = JSON.parse(localStorage.getItem('kullaniciSikayetleri') || '[]');
            list = list.filter(s => s.id !== id);
            localStorage.setItem('kullaniciSikayetleri', JSON.stringify(list));
            sikayetListesiniYukle();
        }

        function adminHesabiTamamenSil(kAdi) {
            if (kAdi === 'admin9595') { alert('Admin silinemez!'); return; }
            if (!confirm(`"${kAdi}" TAMAMEN SİL?`)) return;
            let users = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
            users = users.filter(u => u.kullaniciAdi !== kAdi);
            localStorage.setItem('kullanicilar', JSON.stringify(users));
            let ilanlar = JSON.parse(localStorage.getItem('pazardakiIlanlar') || '[]');
            ilanlar = ilanlar.filter(i => i.satici !== kAdi);
            localStorage.setItem('pazardakiIlanlar', JSON.stringify(ilanlar));
            localStorage.removeItem(`bildirimler_${kAdi}`);
            for (let i = 0; i < localStorage.length; i++) {
                const key = localStorage.key(i);
                if (key && key.startsWith('ozel_oda_') && key.includes(kAdi)) {
                    localStorage.removeItem(key);
                }
            }
            alert(`✅ ${kAdi} tamamen silindi.`);
            window.location.reload();
        }

        // ============================================
        // 💳 PARA ÇEKME
        // ============================================
        function paraCekmeListesiniYukle() {
            const alan = document.getElementById('paraCekmeListesiGövde');
            alan.innerHTML = '';
            let list = JSON.parse(localStorage.getItem('paraCekmeTalepleri') || '[]');
            if (list.length === 0) {
                alan.innerHTML = `<div class="bos-mesaj"><i class="fas fa-credit-card"></i>Para çekme talebi yok.<div class="alt">Kimse para çekmek istemiyor 🤷</div></div>`;
                return;
            }
            list.forEach(t => {
                const kart = document.createElement('div');
                kart.className = 'admin-item';
                kart.style.borderLeft = '3px solid #10b981';
                const net = t.miktar - 10 > 0 ? t.miktar - 10 : 0;
                let btn = t.durum === 'Beklemede' ?
                    `<div class="btn-grup">
                        <button onclick="paraCekmeKarar(${t.id},'onayla')" class="btn btn-yesil"><i class="fas fa-check"></i> Onayla</button>
                        <button onclick="paraCekmeKarar(${t.id},'reddet')" class="btn btn-kirmizi"><i class="fas fa-times"></i> Red</button>
                        <button onclick="paraCekmeSil(${t.id})" class="btn btn-x"><i class="fas fa-times"></i></button>
                    </div>` :
                    `<div class="btn-grup">
                        <span style="color:${t.durum === 'Ödendi' ? '#34d399' : '#f87171'}; font-weight:600;">${t.durum}</span>
                        <button onclick="paraCekmeSil(${t.id})" class="btn btn-x"><i class="fas fa-times"></i></button>
                    </div>`;
                kart.innerHTML = `
                    <div class="bilgi">
                        <div class="kisi"><i class="fas fa-id-card" style="color:#fbbf24;"></i> ${t.kullanici} · ${t.isim}</div>
                        <div class="detay">${t.miktar} TL → <span class="vurgu">${net} TL</span> <span style="color:#5a5a7a;font-size:11px;">(10 TL komisyon)</span></div>
                        <div class="detay" style="font-size:12px; color:#5a5a7a;">🏦 ${t.iban}</div>
                        <div class="kimlik-grup">
                            <img src="${t.kimlikOn}" class="admin-kimlik-img">
                            <img src="${t.kimlikArka}" class="admin-kimlik-img">
                        </div>
                    </div>
                    ${btn}
                `;
                alan.appendChild(kart);
            });
        }

        function paraCekmeSil(id) {
            if (!confirm('Talebi sil?')) return;
            let list = JSON.parse(localStorage.getItem('paraCekmeTalepleri') || '[]');
            list = list.filter(t => t.id !== id);
            localStorage.setItem('paraCekmeTalepleri', JSON.stringify(list));
            paraCekmeListesiniYukle();
        }

        function paraCekmeKarar(id, aksiyon) {
            let list = JSON.parse(localStorage.getItem('paraCekmeTalepleri') || '[]');
            const idx = list.findIndex(t => t.id === id);
            if (idx === -1 || list[idx].durum !== 'Beklemede') return;
            const kullanici = list[idx].kullanici;
            const net = list[idx].miktar - 10 > 0 ? list[idx].miktar - 10 : 0;

            if (aksiyon === 'onayla') {
                list[idx].durum = 'Ödendi';
                sistemBildirimEkle(kullanici, `💰 ${list[idx].miktar} TL çekimin onaylandı! Net ${net} TL hesabına yatırıldı.`);
                showToast(`✅ ${kullanici} - ${net} TL ödendi`);
            } else {
                list[idx].durum = 'Reddedildi';
                let users = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
                const uIdx = users.findIndex(u => u.kullaniciAdi === kullanici);
                if (uIdx !== -1) {
                    users[uIdx].bakiye = parseFloat(((users[uIdx].bakiye || 0) + list[idx].miktar).toFixed(2));
                    localStorage.setItem('kullanicilar', JSON.stringify(users));
                }
                sistemBildirimEkle(kullanici, `❌ ${list[idx].miktar} TL çekimin reddedildi, bakiye iade edildi.`);
                showToast(`❌ ${kullanici} reddedildi, bakiye iade`);
            }
            localStorage.setItem('paraCekmeTalepleri', JSON.stringify(list));
            paraCekmeListesiniYukle();
        }

        // ============================================
        // 🚨 İLAN RAPORLARI
        // ============================================
        function ilanRaporlariListesiniYukle() {
            const alan = document.getElementById('ilanRaporlariListesiGövde');
            alan.innerHTML = '';
            let adminBildirimler = JSON.parse(localStorage.getItem('bildirimler_admin9595') || '[]');
            const raporlar = adminBildirimler.filter(b => b.metin && b.metin.includes('🚨 YENİ RAPOR!'));
            if (raporlar.length === 0) {
                alan.innerHTML = `<div class="bos-mesaj"><i class="fas fa-shield-alt"></i>Rapor yok.<div class="alt">Temiz bir ortam 🌿</div></div>`;
                return;
            }
            raporlar.reverse().forEach(r => {
                const kart = document.createElement('div');
                kart.className = 'admin-item';
                kart.style.borderLeft = '3px solid #f59e0b';
                const satirlar = r.metin.split('\n');
                const raporEden = satirlar[1] ? satirlar[1].replace('Rapor eden: ', '') : '?';
                const ilanID = satirlar[2] ? satirlar[2].replace('İlan ID: ', '') : '?';
                const sebep = satirlar[3] ? satirlar[3].replace('Sebep: ', '') : '?';
                kart.innerHTML = `
                    <div class="bilgi">
                        <div class="kisi"><i class="fas fa-flag" style="color:#f59e0b;"></i> ${raporEden} · İlan #${ilanID}</div>
                        <div class="detay"><span class="vurgu sari">"${sebep}"</span></div>
                        <div class="detay" style="font-size:11px; color:#5a5a7a;">⏱️ ${r.tarih || ''}</div>
                    </div>
                    <div class="btn-grup">
                        <button onclick="ilanRaporuCozenSil(${r.id})" class="btn btn-yesil"><i class="fas fa-check"></i> Çözüldü</button>
                        <button onclick="ilanRaporuCozenSil(${r.id})" class="btn btn-x"><i class="fas fa-times"></i></button>
                    </div>
                `;
                alan.appendChild(kart);
            });
        }

        function ilanRaporuCozenSil(id) {
            if (!confirm('Raporu çözdün mü?')) return;
            let list = JSON.parse(localStorage.getItem('bildirimler_admin9595') || '[]');
            list = list.filter(b => b.id !== id);
            localStorage.setItem('bildirimler_admin9595', JSON.stringify(list));
            ilanRaporlariListesiniYukle();
        }

        // ============================================
        // 🚀 BAŞLANGIÇ
        // ============================================
        bakiyeListesiniYenile();
        sikayetListesiniYukle();
        paraCekmeListesiniYukle();
        ilanRaporlariListesiniYukle();

        // İlk bildirim sayacı
        setTimeout(() => {
            const list = JSON.parse(localStorage.getItem('tumBakiyeBildirimleri') || '[]');
            sonBildirimSayisi = list.filter(b => b.durum === 'Beklemede').length;
        }, 500);

        // Canlı yenileme + ses kontrolü
        setInterval(() => {
            bakiyeListesiniYenile();
            sikayetListesiniYukle();
            paraCekmeListesiniYukle();
            ilanRaporlariListesiniYukle();
            bildirimKontrol();
        }, 4000);
    </script>

</body>
</html>