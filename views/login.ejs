<!DOCTYPE html>
<html lang="tr">
<head>
    <meta name="google-adsense-account" content="ca-pub-7453399945201277">
    <meta name="google-site-verification" content="rXTtLPJavFhXvJ7TGofxQ3XXGZXb_B8dzSBNAPZwLFk" />
    <link rel="icon" type="image/png" href="/resim.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giriş Yap - İtemlerinMarketi</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #05050f; /* Ekstra koyu arka plan */
            color: #e8e8f0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            overflow-x: hidden;
        }

        /* --- VFX: ARKA PLAN IŞIK HALKA DÖNÜŞÜ --- */
        .vfx-background {
            position: fixed;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            z-index: -1;
            overflow: hidden;
        }
        
        .vfx-ring {
            position: absolute;
            border-radius: 50%;
            opacity: 0.5;
            background: conic-gradient(from 0deg, transparent, rgba(99, 102, 241, 0.2), transparent, rgba(168, 85, 247, 0.2), transparent);
            animation: rotateRing 20s linear infinite;
        }

        .vfx-ring:nth-child(1) {
            width: 600px;
            height: 600px;
            top: 20%;
            left: 30%;
            filter: blur(80px);
            animation-duration: 25s;
        }
        .vfx-ring:nth-child(2) {
            width: 400px;
            height: 400px;
            bottom: 10%;
            right: 20%;
            filter: blur(60px);
            animation-direction: reverse;
            animation-duration: 15s;
            background: conic-gradient(from 90deg, transparent, rgba(16, 185, 129, 0.15), transparent);
        }

        @keyframes rotateRing {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* --- HEADER --- */
        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            padding: 16px 40px;
            background: rgba(5, 5, 15, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 100;
            flex-wrap: wrap;
            gap: 12px;
        }
        header .logo {
            font-size: 20px;
            font-weight: 700;
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        header .logo i {
            color: #6366f1;
            text-shadow: 0 0 15px rgba(99, 102, 241, 0.5);
        }
        header nav a {
            color: #8a8aaa;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 8px;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        header nav a:hover {
            background: rgba(255, 255, 255, 0.06);
            color: white;
        }

        /* --- VFX: LOGIN KARTI (GLASSMORPHISM) --- */
        .login-container {
            max-width: 420px;
            width: 100%;
            margin-top: 60px;
            background: rgba(15, 15, 30, 0.7);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-radius: 24px;
            padding: 40px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 30px 80px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05);
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            position: relative;
            overflow: hidden;
        }
        
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(40px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Kartın üzerinde gezen hafif parıltı */
        .login-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(99, 102, 241, 0.03), transparent, rgba(168, 85, 247, 0.03), transparent);
            animation: rotateRing 30s linear infinite;
            pointer-events: none;
            z-index: -1;
        }

        .login-container h1 {
            font-size: 28px;
            font-weight: 800;
            color: white;
            text-align: center;
            margin-bottom: 6px;
            text-shadow: 0 0 20px rgba(99, 102, 241, 0.3);
        }
        .login-container h1 i {
            color: #6366f1;
            filter: drop-shadow(0 0 8px rgba(99, 102, 241, 0.6));
        }
        .login-container .alt-baslik {
            text-align: center;
            color: #8a8aaa;
            font-size: 14px;
            margin-bottom: 28px;
        }
        .login-container .alt-baslik a {
            color: #a5b4fc;
            text-decoration: none;
            transition: color 0.3s;
        }
        .login-container .alt-baslik a:hover {
            color: white;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            animation: slideUp 0.5s ease forwards;
        }
        .alert.error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #f87171;
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.1);
        }
        .alert.success {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.2);
            color: #34d399;
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.1);
        }
        .alert i {
            font-size: 16px;
        }

        .form-box label {
            display: block;
            color: #c4c4d4;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }
        .form-box input {
            width: 100%;
            padding: 14px 16px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            color: white;
            font-size: 14px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            margin-bottom: 18px;
        }
        .form-box input:focus {
            border-color: #6366f1;
            outline: none;
            background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15), 0 0 20px rgba(99, 102, 241, 0.05);
        }
        .form-box input::placeholder {
            color: #5a5a7a;
        }

        /* --- VFX: NEON BUTON --- */
        .btn-primary {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
            position: relative;
            overflow: hidden;
        }
        /* Buton üzerindeki ışık huzmesi */
        .btn-primary::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(255,255,255,0.1), transparent, rgba(255,255,255,0.1), transparent);
            animation: rotateRing 6s linear infinite;
            pointer-events: none;
        }
        .btn-primary:hover {
            transform: translateY(-3px) scale(1.01);
            box-shadow: 0 8px 40px rgba(99, 102, 241, 0.5), 0 0 80px rgba(99, 102, 241, 0.1);
        }

        .kayit-link {
            text-align: center;
            margin-top: 20px;
            color: #8a8aaa;
            font-size: 14px;
        }
        .kayit-link a {
            color: #a5b4fc;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s;
            position: relative;
        }
        .kayit-link a:hover {
            color: white;
            text-shadow: 0 0 10px rgba(165, 180, 252, 0.4);
        }

        .admin-badge {
            text-align: center;
            margin-top: 16px;
            font-size: 12px;
            color: #5a5a7a;
            background: rgba(245, 158, 11, 0.05);
            padding: 8px;
            border-radius: 8px;
            border: 1px solid rgba(245, 158, 11, 0.05);
        }
        .admin-badge span {
            color: #f59e0b;
            font-weight: 600;
        }

        @media (max-width: 480px) {
            header { padding: 12px 20px; }
            header .logo { font-size: 16px; }
            .login-container { padding: 24px; margin-top: 80px; }
            .login-container h1 { font-size: 24px; }
        }
    </style>
</head>
<body>

    <!-- VFX: ARKA PLAN DÖNEN HALKA -->
    <div class="vfx-background">
        <div class="vfx-ring"></div>
        <div class="vfx-ring"></div>
    </div>

    <header>
        <div class="logo">
            <i class="fas fa-store"></i> İtemlerinMarketi
        </div>
        <nav>
            <a href="/"><i class="fas fa-home"></i> Ana Sayfa</a>
        </nav>
    </header>

    <div class="login-container">

        <h1><i class="fas fa-sign-in-alt"></i> Giriş Yap</h1>
        <p class="alt-baslik">Hesabına giriş yap ve alışverişe başla!</p>

        <!-- Hata / Başarı Mesajı -->
        <% if (hata) { %>
            <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= hata %></div>
        <% } %>
        <% if (mesaj) { %>
            <div class="alert success"><i class="fas fa-check-circle"></i> <%= mesaj %></div>
        <% } %>

        <!-- FORM -->
        <form id="loginForm" class="form-box">
            <label for="kullaniciAdi"><i class="fas fa-user"></i> Kullanıcı Adı</label>
            <input type="text" id="kullaniciAdi" placeholder="Kullanıcı adını gir" required autocomplete="username">

            <label for="sifre"><i class="fas fa-lock"></i> Şifre</label>
            <input type="password" id="sifre" placeholder="Şifreni gir" required autocomplete="current-password">

            <button type="submit" class="btn-primary"><i class="fas fa-sign-in-alt"></i> Giriş Yap</button>
        </form>

        <div class="kayit-link">
            Hesabın yok mu? <a href="/register">Kayıt Ol</a>
        </div>

        <div class="admin-badge">
            <i class="fas fa-shield-alt" style="color:#f59e0b;"></i>
            Admin girişi için <span>admin9595</span> / <span>1453Cinar</span>
        </div>

    </div>

    <script>
        // ============================================
        // GİRİŞ YAP - TAM SCRIPT
        // ============================================

        // ============================================
        // NORMAL GİRİŞ
        // ============================================
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const kAdi = document.getElementById('kullaniciAdi').value.trim();
            const sifre = document.getElementById('sifre').value.trim();

            if (!kAdi || !sifre) {
                alert('⚠️ Lütfen kullanıcı adı ve şifreni gir!');
                return;
            }

            // Admin Kontrolü
            if (kAdi === 'admin9595' && sifre === '1453Cinar') {
                localStorage.setItem('aktifKullanici', JSON.stringify({
                    kullaniciAdi: kAdi,
                    rol: 'admin',
                    bakiye: 99999
                }));
                window.location.href = '/yonetici-paneli';
                return;
            }

            // Normal Kullanıcı Kontrolü
            const kayitliKullanicilar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
            const user = kayitliKullanicilar.find(u => u.kullaniciAdi === kAdi && u.sifre === sifre);

            if (user) {
                localStorage.setItem('aktifKullanici', JSON.stringify({
                    kullaniciAdi: user.kullaniciAdi,
                    rol: user.rol || 'uye',
                    bakiye: user.bakiye || 0,
                    email: user.email || ''
                }));
                window.location.href = '/';
            } else {
                // Kullanıcı var ama şifre yanlış mı?
                const kullaniciVar = kayitliKullanicilar.find(u => u.kullaniciAdi === kAdi);
                if (kullaniciVar) {
                    alert('❌ Şifren yanlış kanka! Tekrar dene.');
                } else {
                    alert('❌ Bu kullanıcı adı kayıtlı değil! Önce kayıt ol.');
                }
                document.getElementById('sifre').value = '';
                document.getElementById('sifre').focus();
            }
        });

        // ============================================
        // ENTER İLE GÖNDER
        // ============================================
        document.getElementById('sifre').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('loginForm').dispatchEvent(new Event('submit'));
            }
        });

        document.getElementById('kullaniciAdi').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('sifre').focus();
            }
        });

        console.log('🔐 İtemlerinMarketi - Giriş sayfası yüklendi!');
    </script>

</body>
</html>