<!DOCTYPE html>
<html lang="tr">
<head>
    <meta name="google-site-verification" content="rXTtLPJavFhXvJ7TGofxQ3XXGZXb_B8dzSBNAPZwLFk" />
    <link rel="icon" type="image/png" href="/resim.png">
    <meta charset="UTF-8">
    <title>Para Çek - İtemlerinMarketi</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .dosya-sec-etiket {
            display: block;
            background: #1e293b;
            border: 1px dashed #38bdf8;
            padding: 15px;
            border-radius: 6px;
            color: #cbd5e1;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 12px;
            text-align: center;
            transition: background 0.2s;
        }
        .dosya-sec-etiket:hover { background: #334155; }
        .onizleme-img {
            max-width: 100%;
            height: auto;
            border-radius: 6px;
            margin-bottom: 15px;
            display: none;
            border: 1px solid #475569;
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">İtemlerinMarketi</div>
        <nav><a href="/">Ana Sayfa</a></nav>
    </header>
    <div class="container" id="icerik" style="display: none;">
        <h1>💰 Bankaya Para Çekme Talebi</h1>
        <p>Dolandırıcılığa karşı yasal koruma amacıyla **Kimlik Kartınızın Ön ve Arka Fotoğrafını** yükleyiniz (Minimum Çekim: 10 TL):</p>

        <form id="paraCekForm" class="form-box" style="max-width: 450px; margin-top:20px;">
            <label style="color:#94a3b8; font-size:14px;">Mevcut Bakiyeniz:</label>
            <input type="text" id="mevcutBakiyeGosterge" readonly style="color:#10b981; font-weight:bold; margin-bottom: 15px;">
            
            <label style="color:#38bdf8; font-size:12px; font-weight:bold; display:block; text-align:left; margin-bottom:10px;">Kimlik Kartı Yükleme:</label>
            
            <!-- KİMLİK ÖN YÜZ BUTONU -->
            <label class="dosya-sec-etiket" for="kimlikOnInput">📷 Kimlik Kartı ÖN Yüzü Seç</label>
            <input type="file" id="kimlikOnInput" accept="image/*" required style="display: none;">
            <img id="onOnizleme" class="onizleme-img" alt="Ön Yüz">

            <!-- KİMLİK ARKA YÜZ BUTONU -->
            <label class="dosya-sec-etiket" for="kimlikArkaInput" style="border-color: #a855f7; color: #d8b4fe;">📷 Kimlik Kartı ARKA Yüzü Seç</label>
            <input type="file" id="kimlikArkaInput" accept="image/*" required style="display: none;">
            <img id="arkaOnizleme" class="onizleme-img" alt="Arka Yüz">

            <!-- BANKA ALANLARI -->
            <label style="color:#38bdf8; font-size:12px; font-weight:bold; display:block; text-align:left; margin-top:15px; margin-bottom:5px;">Hesap ve Tutar Bilgileri:</label>
            <input type="text" id="cekilecekIsim" placeholder="Hesap Sahibi Ad Soyad" required>
            <input type="text" id="cekilecekIban" placeholder="Paranın Yatacağı IBAN (TR...)" required>
            <input type="number" id="cekilecekMiktar" placeholder="Çekmek İstediğiniz Tutar (En Az 10 TL)" required>
            
            <button type="submit" class="btn" style="width: 100%;">Fotoğrafları Onayla ve Para Çek</button>
        </form>
    </div>
    <script>
        const aktif = JSON.parse(localStorage.getItem('aktifKullanici'));
        if (!aktif) { window.location.href = '/login'; } 
        else {
            document.getElementById('icerik').style.display = 'block';
            document.getElementById('mevcutBakiyeGosterge').value = (aktif.bakiye || 0) + " ₺";
        }

        let kimlikOnBase64 = "";
        let kimlikArkaBase64 = "";

        function resimOku(inputElement, onizlemeId, callback) {
            inputElement.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        document.getElementById(onizlemeId).src = e.target.result;
                        document.getElementById(onizlemeId).style.display = 'block';
                        callback(e.target.result);
                    }
                    reader.readAsDataURL(file);
                }
            });
        }

        resimOku(document.getElementById('kimlikOnInput'), 'onOnizleme', function(base64) { kimlikOnBase64 = base64; });
        resimOku(document.getElementById('kimlikArkaInput'), 'arkaOnizleme', function(base64) { kimlikArkaBase64 = base64; });

        document.getElementById('paraCekForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const miktar = parseFloat(document.getElementById('cekilecekMiktar').value);
            const iban = document.getElementById('cekilecekIban').value;
            const isim = document.getElementById('cekilecekIsim').value;

            // KURAL GÜNCELLEMESİ: EN AZ 10 TL KONTROLÜ (ÜST LİMİT KALDIRILDI)
            if (miktar < 10) { 
                alert("Hata: Para çekebilmek için miktar en az 10 TL olmalıdır Çınar!"); 
                return; 
            }
            if (miktar > aktif.bakiye) { 
                alert("Hata: Cüzdanınızdaki mevcut paradan daha fazlasını çekemezsiniz!"); 
                return; 
            }
            if (!kimlikOnBase64 || !kimlikArkaBase64) { 
                alert("Hata: Lütfen kimlik fotoğraflarını yükleyin!"); 
                return; 
            }

            let kullanicilar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
            const idx = kullanicilar.findIndex(u => u.kullaniciAdi === aktif.kullaniciAdi);
            if (idx !== -1) {
                kullanicilar[idx].bakiye = parseFloat((kullanicilar[idx].bakiye - miktar).toFixed(2));
                localStorage.setItem('kullanicilar', JSON.stringify(kullanicilar));
                aktif.bakiye = kullanicilar[idx].bakiye;
                localStorage.setItem('aktifKullanici', JSON.stringify(aktif));
            }

            let talepler = JSON.parse(localStorage.getItem('paraCekmeTalepleri') || '[]');
            talepler.push({
                id: Date.now(),
                kullanici: aktif.kullaniciAdi,
                miktar: miktar,
                iban: iban,
                isim: isim,
                kimlikOn: kimlikOnBase64,
                kimlikArka: kimlikArkaBase64,
                durum: 'Beklemede'
            });
            localStorage.setItem('paraCekmeTalepleri', JSON.stringify(talepler));

            alert(`Kimlik fotoğraflarınız başarıyla alındı! 10 TL komisyon kesildi. Net ${miktar - 10} TL aktarımı için Çınar Eymen'e iletildi.`);
            window.location.href = '/';
        });
    </script>
</body>
</html>
