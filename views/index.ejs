    <meta name="keywords" content="itemlerinmarketi, güvenli ticaret, oyun hesabı, valorant hesap, e-pin, riot points, sanal ürün">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph -->
    <meta property="og:title" content="İtemlerinMarketi - Güvenli Ticaret">
    <meta property="og:description" content="Güvenli ticaret platformu. Oyun hesapları, e-pinler ve sanal ürünler.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://itemlerinmarketi.onrender.com">
    
    <link rel="canonical" href="https://itemlerinmarketi.onrender.com" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="stylesheet" href="/style.css">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <style>
        /* ===== RESET & BASE ===== */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #0f172a;
            color: #e2e8f0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ===== ARKA PLAN ANİMASYONU ===== */
        .bg-animation {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: -1;
            overflow: hidden;
            pointer-events: none;
        }
        .bg-animation .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.3;
            animation: orbFloat 20s infinite ease-in-out;
        }
        .bg-animation .orb:nth-child(1) {
            width: 500px; height: 500px;
            background: #6366f1;
            top: -10%; left: -10%;
            animation-delay: 0s;
        }
        .bg-animation .orb:nth-child(2) {
            width: 400px; height: 400px;
            background: #a855f7;
            bottom: -10%; right: -10%;
            animation-delay: -7s;
        }
        .bg-animation .orb:nth-child(3) {
            width: 300px; height: 300px;
            background: #10b981;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: -14s;
        }
        @keyframes orbFloat {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(100px, -80px) scale(1.1); }
            50% { transform: translate(-50px, 100px) scale(0.9); }
            75% { transform: translate(80px, 50px) scale(1.05); }
        }

        /* ===== HEADER ===== */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 24px;
            background: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(51, 65, 85, 0.5);
            position: sticky;
            top: 0;
            z-index: 100;
            flex-wrap: wrap;
        }
        .header-sol-bölüm {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }
        .logo-img {
            height: 55px;
            width: auto;
            object-fit: contain;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        .logo-img:hover { transform: scale(1.05) rotate(-2deg); }

        /* ===== GLOW BUTTONS ===== */
        .btn-glow {
            background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);
            color: white;
            border: none;
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 700;
            border-radius: 50px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }
        .btn-glow::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.5s;
        }
        .btn-glow:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 30px rgba(99, 102, 241, 0.5);
        }
        .btn-glow:hover::before { opacity: 1; }
        .btn-glow:active { transform: scale(0.95); }

        .btn-glow-gold {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            box-shadow: 0 4px 20px rgba(245, 158, 11, 0.3);
        }
        .btn-glow-gold:hover { box-shadow: 0 6px 30px rgba(245, 158, 11, 0.5); }

        /* ===== HEADER RIGHT ===== */
        .header-sag-grup {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* ===== CÜZDAN ===== */
        .cuzdan-dropdown { position: relative; display: inline-block; }
        .cuzdan-buton {
            background: rgba(21, 128, 61, 0.9);
            backdrop-filter: blur(10px);
            color: white;
            padding: 6px 16px;
            border-radius: 50px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            user-select: none;
            border: 1px solid rgba(22, 101, 52, 0.6);
            transition: all 0.3s;
        }
        .cuzdan-buton:hover { background: rgba(21, 128, 61, 1); transform: scale(1.05); }
        .cuzdan-buton svg { width: 16px; height: 16px; fill: white; }
        .dropdown-menu {
            display: none;
            position: absolute;
            right: 0; top: 40px;
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(20px);
            min-width: 170px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.6);
            border-radius: 12px;
            border: 1px solid rgba(51, 65, 85, 0.5);
            z-index: 1002;
            overflow: hidden;
            animation: slideDown 0.3s ease;
        }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .dropdown-menu a {
            color: #cbd5e1;
            padding: 10px 16px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 500;
            border-bottom: 1px solid rgba(51, 65, 85, 0.3);
            transition: all 0.2s;
        }
        .dropdown-menu a:last-child { border-bottom: none; }
        .dropdown-menu a:hover { background: rgba(51, 65, 85, 0.5); color: #38bdf8; padding-left: 20px; }
        .cuzdan-dropdown:hover .dropdown-menu { display: block; }

        /* ===== BİLDİRİM ===== */
        .bildirim-dropdown { position: relative; display: inline-block; }
        .bildirim-buton {
            font-size: 20px;
            cursor: pointer;
            user-select: none;
            position: relative;
            background: none;
            border: none;
            padding: 6px 10px;
            transition: transform 0.3s;
        }
        .bildirim-buton:hover { transform: scale(1.1); }
        .bildirim-sayac {
            position: absolute;
            top: -4px; right: -2px;
            background: #ef4444;
            color: white;
            font-size: 9px;
            padding: 1px 6px;
            border-radius: 50px;
            font-weight: 700;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }
        .bildirim-menu {
            display: none;
            position: absolute;
            right: 0; top: 40px;
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(20px);
            width: 300px;
            max-height: 350px;
            overflow-y: auto;
            box-shadow: 0 8px 30px rgba(0,0,0,0.6);
            border-radius: 12px;
            border: 1px solid rgba(51, 65, 85, 0.5);
            z-index: 1002;
            animation: slideDown 0.3s ease;
        }
        .bildirim-item {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(51, 65, 85, 0.3);
            font-size: 13px;
            color: #cbd5e1;
            text-align: left;
            line-height: 1.4;
            transition: background 0.2s;
        }
        .bildirim-item:hover { background: rgba(51, 65, 85, 0.3); }
        .bildirim-item:last-child { border-bottom: none; }
        .bildirim-item small { display: block; color: #94a3b8; margin-top: 4px; font-size: 11px; }

        /* ===== PROFİL ===== */
        .profil-dropdown { position: relative; display: inline-block; }
        .profil-avatar-btn {
            width: 38px; height: 38px;
            border-radius: 50%;
            object-fit: cover;
            cursor: pointer;
            border: 2px solid #10b981;
            transition: all 0.3s;
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
        }
        .profil-avatar-btn:hover { transform: scale(1.1); border-color: #38bdf8; box-shadow: 0 0 30px rgba(56, 189, 248, 0.3); }
        .profil-menu {
            display: none;
            position: absolute;
            right: 0; top: 45px;
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(20px);
            min-width: 160px;
            border-radius: 12px;
            border: 1px solid rgba(51, 65, 85, 0.5);
            box-shadow: 0 8px 30px rgba(0,0,0,0.6);
            z-index: 1005;
            overflow: hidden;
            animation: slideDown 0.3s ease;
        }
        .profil-menu a {
            color: #cbd5e1;
            padding: 10px 16px;
            text-decoration: none;
            display: block;
            font-size: 13px;
            border-bottom: 1px solid rgba(51, 65, 85, 0.3);
            transition: all 0.2s;
        }
        .profil-menu a:last-child { border-bottom: none; }
        .profil-menu a:hover { background: rgba(51, 65, 85, 0.5); color: #38bdf8; padding-left: 20px; }

        /* ===== PAZAR ===== */
        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        .pazar-wrapper { display: flex; gap: 30px; flex-wrap: wrap; margin-top: 10px; }
        .ilan-listesi-kutu { flex: 1; min-width: 300px; }
        .ilan-listesi-kutu h3 {
            color: #38bdf8;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* ===== İLAN KARTLARI ===== */
        .ilan-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }
        .card {
            position: relative;
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(10px);
            padding: 16px;
            border-radius: 16px;
            border: 1px solid rgba(51, 65, 85, 0.4);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
            cursor: pointer;
        }
        .card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at center, rgba(99, 102, 241, 0.05) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.6s;
        }
        .card:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: rgba(99, 102, 241, 0.6);
            box-shadow: 0 20px 60px rgba(99, 102, 241, 0.15);
        }
        .card:hover::before { opacity: 1; }
        .card a { text-decoration: none; color: inherit; display: block; }
        .card a:hover .pazar-ilan-img { transform: scale(1.03); }
        .pazar-ilan-img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 12px;
            border: 1px solid rgba(51, 65, 85, 0.3);
            background: #0f172a;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .teslimat-rozet {
            display: inline-block;
            background: rgba(30, 27, 75, 0.8);
            backdrop-filter: blur(10px);
            color: #a855f7;
            padding: 3px 10px;
            font-size: 11px;
            font-weight: 700;
            border-radius: 50px;
            border: 1px solid rgba(168, 85, 247, 0.3);
            margin-bottom: 8px;
        }
        .ilan-baslik {
            font-size: 16px;
            font-weight: 600;
            color: white;
            margin-bottom: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .ilan-satici {
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 6px;
        }
        .ilan-satici strong { color: #38bdf8; }
        .price {
            font-size: 20px;
            font-weight: 700;
            color: #10b981;
            margin-bottom: 10px;
        }

        /* ===== KART BUTONLARI ===== */
        .kart-buton-grup {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }
        .btn-kart {
            padding: 8px 14px;
            border: none;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-kart-satin {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }
        .btn-kart-satin:hover { transform: scale(1.05); box-shadow: 0 6px 25px rgba(16, 185, 129, 0.4); }
        .btn-kart-mesaj {
            background: rgba(30, 41, 59, 0.8);
            color: #38bdf8;
            border: 1px solid rgba(56, 189, 248, 0.3);
        }
        .btn-kart-mesaj:hover { background: rgba(56, 189, 248, 0.1); transform: scale(1.05); }

        /* ===== DÜZENLE BUTONU (kart üstü) ===== */
        .ilan-ust-eylem-btn {
            position: absolute;
            top: 16px;
            right: 16px;
            padding: 4px 12px;
            font-size: 11px;
            font-weight: 700;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            z-index: 10;
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);
            transition: all 0.3s;
            backdrop-filter: blur(10px);
        }
        .ilan-ust-eylem-btn:hover { transform: scale(1.1); }
        .btn-duzenle { background: rgba(56, 189, 248, 0.9); color: #0f172a; }
        .btn-raporla { background: rgba(239, 68, 68, 0.9); color: white; }

        /* ===== SOHBET & DESTEK BUTONLARI ===== */
        .sohbet-butonu {
            position: fixed;
            bottom: 24px;
            left: 24px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            border-radius: 50%;
            box-shadow: 0 4px 30px rgba(99, 102, 241, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            z-index: 1001;
            border: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .sohbet-butonu:hover { transform: scale(1.15) rotate(-10deg); box-shadow: 0 8px 40px rgba(99, 102, 241, 0.6); }
        .sohbet-butonu svg { width: 30px; height: 30px; fill: white; }
        .sohbet-butonu::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid rgba(99, 102, 241, 0.3);
            animation: ringPulse 2s infinite;
        }
        @keyframes ringPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.15); opacity: 0.5; }
        }

        .destek-butonu {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%;
            box-shadow: 0 4px 30px rgba(16, 185, 129, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            z-index: 1001;
            border: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .destek-butonu:hover { transform: scale(1.15) rotate(10deg); box-shadow: 0 8px 40px rgba(16, 185, 129, 0.6); }
        .destek-butonu img {
            width: 30px;
            height: 30px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }
        .destek-butonu::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid rgba(16, 185, 129, 0.3);
            animation: ringPulse 2s infinite 0.5s;
        }

        /* ===== SOHBET KUTULARI ===== */
        .sohbet-kapsayici, .destek-kapsayici {
            position: fixed;
            bottom: 100px;
            left: 24px;
            width: 360px;
            max-height: 480px;
            height: 480px;
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(51, 65, 85, 0.5);
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.6);
            z-index: 1000;
            font-family: inherit;
            display: none;
            flex-direction: column;
            overflow: hidden;
            animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .destek-kapsayici { left: auto; right: 24px; border-color: rgba(16, 185, 129, 0.3); }
        .sohbet-kapsayici.acik, .destek-kapsayici.acik { display: flex; }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .chat-baslik {
            padding: 14px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 700;
            font-size: 15px;
            flex-shrink: 0;
            color: white;
        }
        .chat-baslik.sohbet-baslik { background: linear-gradient(135deg, #6366f1, #4f46e5); }
        .chat-baslik.destek-baslik { background: linear-gradient(135deg, #10b981, #059669); }
        .chat-baslik .baslik-sol { display: flex; align-items: center; gap: 10px; }
        .chat-baslik .online-nokta {
            width: 10px; height: 10px;
            background: #10b981;
            border-radius: 50%;
            display: inline-block;
            animation: pulse 1.5s infinite;
        }
        .chat-baslik .kapat-btn {
            background: none; border: none;
            color: white; font-size: 22px;
            cursor: pointer; opacity: 0.7;
            transition: opacity 0.2s;
        }
        .chat-baslik .kapat-btn:hover { opacity: 1; }

        .chat-mesajlar {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: rgba(15, 23, 42, 0.5);
        }
        .chat-mesajlar::-webkit-scrollbar { width: 4px; }
        .chat-mesajlar::-webkit-scrollbar-track { background: #1e293b; }
        .chat-mesajlar::-webkit-scrollbar-thumb { background: #6366f1; border-radius: 4px; }

        .chat-mesaj {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.5;
            word-break: break-word;
            animation: messageIn 0.3s ease;
        }
        @keyframes messageIn {
            from { opacity: 0; transform: scale(0.9) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        .chat-mesaj.giden {
            align-self: flex-end;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: white;
            border-radius: 16px 16px 4px 16px;
        }
        .chat-mesaj.gelen {
            align-self: flex-start;
            background: rgba(30, 41, 59, 0.8);
            color: #e2e8f0;
            border-radius: 16px 16px 16px 4px;
            border: 1px solid rgba(51, 65, 85, 0.3);
        }
        .chat-mesaj .mesaj-zaman {
            font-size: 10px;
            opacity: 0.6;
            margin-top: 4px;
            display: block;
        }
        .chat-mesaj .mesaj-gonderen {
            font-size: 11px;
            font-weight: 600;
            color: #a855f7;
            display: block;
            margin-bottom: 2px;
        }
        .chat-mesaj.sistem {
            align-self: center;
            background: rgba(30, 27, 75, 0.8);
            color: #a855f7;
            border: 1px solid rgba(168, 85, 247, 0.3);
            font-size: 12px;
            padding: 6px 16px;
            border-radius: 50px;
            max-width: 90%;
            text-align: center;
        }
        .chat-mesaj.sonlandirildi {
            align-self: center;
            background: rgba(127, 29, 29, 0.8);
            color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.3);
            font-size: 12px;
            padding: 6px 16px;
            border-radius: 50px;
            max-width: 90%;
            text-align: center;
        }

        .chat-form {
            display: flex;
            padding: 12px 16px;
            background: rgba(15, 23, 42, 0.8);
            gap: 10px;
            border-top: 1px solid rgba(51, 65, 85, 0.3);
            flex-shrink: 0;
        }
        .chat-form input {
            flex: 1;
            padding: 10px 16px;
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid rgba(51, 65, 85, 0.4);
            color: white;
            border-radius: 50px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.3s;
        }
        .chat-form input:focus { border-color: #6366f1; }
        .chat-form input::placeholder { color: #64748b; }
        .chat-form button {
            padding: 10px 20px;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 14px;
            white-space: nowrap;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: white;
        }
        .chat-form button:hover { transform: scale(1.05); box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4); }
        .chat-form button.destek-gonder { background: linear-gradient(135deg, #10b981, #059669); }
        .chat-form button.destek-gonder:hover { box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4); }

        /* ===== KİŞİ LİSTESİ ===== */
        .kisiler-listesi {
            flex: 1;
            padding: 10px;
            overflow-y: auto;
            background: rgba(15, 23, 42, 0.5);
        }
        .kisi-kart {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: rgba(30, 41, 59, 0.6);
            margin-bottom: 6px;
            border-radius: 10px;
            cursor: pointer;
            border: 1px solid rgba(51, 65, 85, 0.3);
            transition: all 0.3s;
        }
        .kisi-kart:hover { background: rgba(51, 65, 85, 0.5); border-color: #6366f1; transform: translateX(4px); }
        .kisi-avatar {
            width: 36px; height: 36px;
            background: #475569;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 700;
            color: #38bdf8;
            font-size: 14px;
            flex-shrink: 0;
        }

        /* ===== MODAL ===== */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(10px);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s ease;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        .modal-overlay.active { display: flex; }
        .modal-icerik {
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(51, 65, 85, 0.5);
            border-radius: 16px;
            max-width: 600px;
            width: 92%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 30px;
            color: #cbd5e1;
            animation: modalIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.9) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        .modal-icerik h2 { color: #38bdf8; margin-top: 0; font-size: 26px; }
        .modal-icerik h3 { color: #a855f7; }
        .modal-kapat-btn {
            background: rgba(239, 68, 68, 0.8);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 700;
            float: right;
            transition: all 0.3s;
        }
        .modal-kapat-btn:hover { background: #dc2626; transform: scale(1.05); }

        /* ===== MODAL FORM ===== */
        .ilan-form input, .ilan-form textarea {
            width: 100%;
            padding: 12px 16px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(51, 65, 85, 0.4);
            color: white;
            border-radius: 10px;
            box-sizing: border-box;
            margin-bottom: 12px;
            font-family: inherit;
            transition: border-color 0.3s;
        }
        .ilan-form input:focus, .ilan-form textarea:focus { border-color: #6366f1; outline: none; }
        .ilan-form textarea { min-height: 100px; resize: vertical; }

        .kurallar-checkbox {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 12px 0;
            color: #94a3b8;
            font-size: 14px;
        }
        .kurallar-checkbox input[type="checkbox"] {
            width: 18px; height: 18px;
            accent-color: #6366f1;
            cursor: pointer;
        }
        .kurallar-link {
            color: #38bdf8;
            text-decoration: underline;
            cursor: pointer;
        }
        .kurallar-link:hover { color: #a855f7; }

        .resim-ekle-alani { margin-bottom: 12px; }
        .resim-ekle-alani label {
            color: #94a3b8;
            font-size: 13px;
            display: block;
            margin-bottom: 4px;
        }
        .resim-ekle-alani input[type="file"] {
            width: 100%;
            padding: 10px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(51, 65, 85, 0.4);
            color: white;
            border-radius: 10px;
            cursor: pointer;
        }
        .resim-onizleme {
            margin-top: 8px;
            display: none;
            position: relative;
        }
        .resim-onizleme img {
            max-width: 100%;
            max-height: 150px;
            border-radius: 8px;
            border: 1px solid rgba(51, 65, 85, 0.4);
        }
        .resim-onizleme .kaldir-btn {
            background: rgba(239, 68, 68, 0.8);
            color: white;
            border: none;
            padding: 4px 14px;
            border-radius: 50px;
            cursor: pointer;
            margin-top: 4px;
            font-size: 12px;
            transition: all 0.3s;
        }
        .resim-onizleme .kaldir-btn:hover { background: #dc2626; }

        /* ===== ONAY MODAL ===== */
        .onay-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(10px);
            z-index: 10000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s ease;
        }
        .onay-modal.active { display: flex; }
        .onay-icerik {
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 16px;
            max-width: 420px;
            width: 90%;
            padding: 30px;
            color: #cbd5e1;
            text-align: center;
            animation: modalIn 0.4s ease;
        }
        .onay-icerik h3 { color: #ef4444; margin-top: 0; }
        .onay-icerik .onay-butonlar {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }
        .onay-icerik .onay-butonlar button {
            padding: 10px 30px;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }
        .onay-icerik .onay-butonlar button:hover { transform: scale(1.05); }
        .onay-icerik .onay-butonlar .evet-btn { background: #ef4444; color: white; }
        .onay-icerik .onay-butonlar .evet-btn:hover { background: #dc2626; }
        .onay-icerik .onay-butonlar .hayir-btn { background: #475569; color: white; }
        .onay-icerik .onay-butonlar .hayir-btn:hover { background: #334155; }
        .onay-icerik .kullanici-listesi {
            background: rgba(15, 23, 42, 0.8);
            border-radius: 10px;
            padding: 10px;
            margin: 15px 0;
            max-height: 150px;
            overflow-y: auto;
            text-align: left;
        }
        .onay-icerik .kullanici-item {
            padding: 8px 12px;
            border-bottom: 1px solid rgba(51, 65, 85, 0.3);
            cursor: pointer;
            border-radius: 6px;
            transition: all 0.2s;
        }
        .onay-icerik .kullanici-item:hover { background: rgba(30, 41, 59, 0.5); }
        .onay-icerik .kullanici-item.selected {
            background: rgba(51, 65, 85, 0.5);
            border-left: 3px solid #ef4444;
        }
        .onay-icerik .kullanici-item:last-child { border-bottom: none; }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            .sohbet-kapsayici, .destek-kapsayici {
                width: calc(100% - 16px);
                height: calc(100% - 100px);
                bottom: 90px;
                left: 8px;
                right: 8px;
                border-radius: 16px;
            }
            .destek-kapsayici { left: 8px; right: 8px; }
            .ilan-grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
            header { padding: 10px 16px; }
            .header-sol-bölüm { gap: 10px; }
            .btn-glow { padding: 8px 16px; font-size: 12px; }
            .modal-icerik { padding: 20px; }
        }
        @media (max-width: 480px) {
            .ilan-grid { grid-template-columns: 1fr; }
            .sohbet-butonu, .destek-butonu { width: 50px; height: 50px; bottom: 16px; }
            .sohbet-butonu { left: 16px; }
            .destek-butonu { right: 16px; }
            .cuzdan-buton { font-size: 11px; padding: 4px 12px; }
            .profil-avatar-btn { width: 32px; height: 32px; }
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.5); }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #6366f1; }
    </style>
</head>
<body>

    <!-- ===== ARKA PLAN ANİMASYONU ===== -->
    <div class="bg-animation">
        <div class="orb"></div>
        <div class="orb"></div>
        <div class="orb"></div>
    </div>

    <!-- ===== HEADER ===== -->
    <header>
        <div class="header-sol-bölüm">
            <a href="/"><img src="/gif.png" alt="İtemlerinMarketi" class="logo-img" onerror="this.onerror=null; this.outerHTML='İtemlerinMarketi';"></a>
            <button class="btn-glow" onclick="ilanEkleModalAc()"><i class="fas fa-plus"></i> İlan Ekle</button>
            <button class="btn-glow btn-glow-gold" onclick="kurallariGoster(event)"><i class="fas fa-book"></i> Kurallar</button>
        </div>
        
        <div class="header-sag-grup">
            <!-- BİLDİRİM -->
            <div class="bildirim-dropdown" id="bildirimKapsayici" style="display: none;">
                <button class="bildirim-buton" onclick="bildirimMenuAcKapat(event)">
                    <i class="fas fa-bell"></i>
                    <span class="bildirim-sayac" id="bSayac">0</span>
                </button>
                <div class="bildirim-menu" id="bildirimListesiGövde"></div>
            </div>

            <!-- CÜZDAN -->
            <div class="cuzdan-dropdown" id="cuzdanKapsayici" style="display: none;">
                <div class="cuzdan-buton">
                    <i class="fas fa-wallet"></i>
                    <span id="cuzdanBakiyeYazi">0.00 ₺</span>
                </div>
                <div class="dropdown-menu">
                    <a href="/bakiye"><i class="fas fa-arrow-up"></i> Bakiye Yükle</a>
                    <a href="/para-cek"><i class="fas fa-arrow-down"></i> Para Çek</a>
                </div>
            </div>

            <!-- KULLANICI BİLGİSİ -->
            <div id="userInfo" style="font-weight: 600; color: #10b981; font-size: 13px;">Giriş Yapılmadı</div>

            <!-- PROFİL -->
            <div class="profil-dropdown" id="profilGrup" style="display: none;">
                <img src="/profil.jpg" id="headerProfilResmi" class="profil-avatar-btn" onclick="profilMenusuAcKapat(event)">
                <div class="profil-menu" id="profilAçilirMenu">
                    <a href="/profil"><i class="fas fa-user"></i> Profilim</a>
                    <a href="/destek-talebi"><i class="fas fa-ticket"></i> Destek Talebi</a>
                    <a href="#" onclick="sistemdenCikisYap()"><i class="fas fa-sign-out-alt"></i> Çıkış Yap</a>
                </div>
            </div>
        </div>

        <nav id="navMenu" style="display: flex; gap: 10px; align-items:center;">
            <a href="/" style="color:#38bdf8; text-decoration:none; font-weight:600;"><i class="fas fa-store"></i> Pazar</a>
            <a href="/login" id="loginLink" style="color:#94a3b8; text-decoration:none; font-weight:600;"><i class="fas fa-sign-in-alt"></i> Giriş</a>
        </nav>
    </header>

    <!-- ===== ANA SAYFA ===== -->
    <div class="container">
        <div class="pazar-wrapper">
            <div class="ilan-listesi-kutu">
                <h3><i class="fas fa-store-alt"></i> İtemlerin Pazarı</h3>
                <div class="ilan-grid" id="pazarGrid">
                    <% if (ilanlar && ilanlar.length > 0) { %>
                        <% ilanlar.forEach(ilan => { %>
                            <div class="card" data-satici="<%= ilan.satici %>" data-id="<%= ilan._id %>">
                                <div id="duzenleAlani-<%= ilan._id %>" style="position:absolute; top:16px; right:16px; z-index:10;"></div>
                                <a href="/ilan/<%= ilan._id %>">
                                    <img src="<%= ilan.resim || 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%23334155%22 stroke-width=%222%22><rect x=%223%22 y=%223%22 width=%2218%22 height=%2218%22 rx=%222%22/><circle cx=%228.5%22 cy=%228.5%22 r=%221.5%22/><path d=%22M21 15l-5-5L5 21%22/></svg>' %>" class="pazar-ilan-img" alt="<%= ilan.baslik %>">
                                    <span class="teslimat-rozet"><i class="far fa-clock"></i> <%= ilan.sure || '24 Saat' %></span>
                                    <div class="ilan-baslik"><%= ilan.baslik %></div>
                                    <div class="ilan-satici">Satıcı: <strong><%= ilan.satici %></strong></div>
                                    <div class="price"><%= ilan.fiyat %> TL</div>
                                </a>
                                <div class="kart-buton-grup">
                                    <button class="btn-kart btn-kart-satin" onclick="ilanSatinAl('<%= ilan._id %>', <%= ilan.fiyat %>, '<%= ilan.satici %>', '<%= ilan.baslik.replace(/'/g, "\\'") %>')"><i class="fas fa-shopping-cart"></i> Satın Al</button>
                                    <button class="btn-kart btn-kart-mesaj" onclick="sohbetOdasiTetikle('<%= ilan.satici %>')"><i class="fas fa-comment"></i> Mesaj</button>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div style="color:#94a3b8; text-align:center; padding:60px; grid-column:1/-1; background:rgba(30,41,59,0.5); border-radius:16px; border:1px dashed rgba(51,65,85,0.4);">
                            <i class="fas fa-box-open" style="font-size:48px; display:block; margin-bottom:16px; color:#475569;"></i>
                            <p style="font-size:18px;">📭 Henüz ilan yok</p>
                            <p style="font-size:14px; color:#64748b;">İlk ilanı sen ekle! <i class="fas fa-arrow-right"></i></p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== İLAN EKLEME MODAL ===== -->
    <div id="ilanEkleModal" class="modal-overlay">
        <div class="modal-icerik">
            <button class="modal-kapat-btn" onclick="ilanEkleModalKapat()"><i class="fas fa-times"></i> Kapat</button>
            <h2><i class="fas fa-plus-circle"></i> Yeni İlan Ekle</h2>
            <form id="ilanFormu" class="ilan-form">
                <input type="text" id="ilanBaslik" placeholder="Ürün başlığı" required>
                <input type="number" id="ilanFiyat" placeholder="Fiyat (TL)" step="0.01" required>
                
                <div class="kurallar-checkbox">
                    <input type="checkbox" id="kurallarOnay" required>
                    <label for="kurallarOnay">
                        <span class="kurallar-link" onclick="kurallariGoster(event)">İlan kurallarını</span> okudum ve kabul ediyorum.
                    </label>
                </div>

                <textarea id="ilanDetay" placeholder="Ürün açıklaması..." rows="3"></textarea>
                <input type="text" id="ilanSure" placeholder="Teslimat süresi (örn: 15 Dakika)" value="24 Saat">
                
                <div class="resim-ekle-alani">
                    <label><i class="fas fa-image"></i> Ürün Görseli (Opsiyonel)</label>
                    <input type="file" id="ilanResimInput" accept="image/*">
                    <div class="resim-onizleme" id="ilanResimOnizleme">
                        <img id="ilanResimGoster" src="#" alt="Görsel önizleme">
                        <button type="button" class="kaldir-btn" onclick="ilanResimTemizle()"><i class="fas fa-times"></i> Kaldır</button>
                    </div>
                </div>

                <button type="submit" class="btn-glow" style="width:100%; justify-content:center; padding:14px;"><i class="fas fa-rocket"></i> İlanı Yayınla</button>
            </form>
        </div>
    </div>

    <!-- ===== KURALLAR MODAL ===== -->
    <div id="kurallarModal" class="modal-overlay">
        <div class="modal-icerik">
            <button class="modal-kapat-btn" onclick="kurallarModalKapat()"><i class="fas fa-times"></i> Kapat</button>
            <h2><i class="fas fa-book"></i> İlan Verme Kuralları</h2>
            <div style="font-size:13px; line-height:1.8; color:#cbd5e1; max-height:50vh; overflow-y:auto;">
                <p>Aşağıda yazan ilan verme kuralları bireysel ve kurumsal üyeler dahil ve tüm kategori tipleri için geçerlidir.</p>
                <h3 style="color:#a855f7;">1. TANIMLAR</h3>
                <p><strong>İNTERNET SİTESİ :</strong> www.itemlerinmarketi.com</p>
                <p><strong>İTEMLERİNMARKETİ :</strong> İnternet Sitesi ve Mobil Uygulama ile birlikte "İtemlerinMarketi" olarak anılmaktadır.</p>
                <h3 style="color:#a855f7;">2. GENEL HÜKÜMLER</h3>
                <p>2.1. İtemlerinMarketi "Aracı Hizmet Sağlayıcı" sıfatını haizdir.</p>
                <p>2.2. İtemlerinMarketi'ya üye olmayanlar ilan veremez.</p>
                <p>2.3. İlan vermek ücretsizdir.</p>
                <p>2.4. Satıcı, ilan vermeden önce kuralları okuduğunu kabul eder.</p>
                <p>2.17. Yasak içerikler (ırkçılık, terör, pornografi, hakaret vb.) yasaktır.</p>
                <h3 style="color:#a855f7;">3. YASAKLI ÜRÜNLER LİSTESİ</h3>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:4px; font-size:12px;">
                    <span>• Sağlık Beyanlı Ürünler</span>
                    <span>• Kültür ve Tabiat Varlıkları</span>
                    <span>• Ateşli Silah ve Kesici Aletler</span>
                    <span>• Yanıcı ve Patlayıcı Malzemeler</span>
                    <span>• Bandrolsüz Ürünler</span>
                    <span>• Alkollü İçecek ve Tütün</span>
                    <span>• Cinsel İçerik ve Pornografi</span>
                    <span>• Taklit Ürünler</span>
                    <span>• Resmi Belge Satışı</span>
                    <span>• Trafik Aygıtları ve Plaka</span>
                    <span>• Fon ve Hisse Senedi</span>
                    <span>• Organ</span>
                    <span>• Evcil Hayvan ve Yasaklı Hayvanlar</span>
                    <span>• Şans Oyunu Biletleri</span>
                    <span>• Uyuşturucu Madde</span>
                    <span>• Hack Yazılımları</span>
                    <span>• Sosyal Medya Pazarlama</span>
                    <span>• SEO Hizmetleri</span>
                    <span>• Sanal Para Satışı</span>
                    <span>• Çalıntı Ürünler</span>
                    <span>• Emlak ve Arsa Satışı</span>
                    <span>• Riot Points, Valorant Points</span>
                    <span>• IPTV, BeinConnect, Digitürk</span>
                    <span>• Discord Nitro Generator</span>
                    <span>• NordVPN</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== SOHBET BUTONU ===== -->
    <button class="sohbet-butonu" onclick="sohbetPencerisiniAcKapat()" aria-label="Sohbet">
        <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
    </button>

    <!-- ===== DESTEK BUTONU ===== -->
    <button class="destek-butonu" onclick="destekPencerisiniAcKapat()" aria-label="Canlı Destek">
        <img src="/destek.png" alt="Canlı Destek">
    </button>

    <!-- ===== SOHBET KUTUSU ===== -->
    <div class="sohbet-kapsayici" id="sohbetKapsayici">
        <div class="chat-baslik sohbet-baslik">
            <div class="baslik-sol"><i class="fas fa-comments"></i> <span>Sohbet</span></div>
            <button class="kapat-btn" onclick="sohbetPencerisiniAcKapat()"><i class="fas fa-times"></i></button>
        </div>
        <div class="kisiler-listesi" id="kisiListesiGövdeSol"></div>
        <div class="chat-ekran" id="ekranKonusmaSol" style="display: none; flex-direction: column; height: 100%;">
            <div style="display:flex; align-items:center; padding:10px 16px; background:rgba(15,23,42,0.5); border-bottom:1px solid rgba(51,65,85,0.3); gap:10px;">
                <span style="cursor:pointer; font-size:18px; color:#94a3b8;" onclick="kisilerEkraninaDonSol()"><i class="fas fa-arrow-left"></i></span>
                <span id="sohbetHedefAdSol" style="color:white; font-weight:600;">Kullanıcı</span>
            </div>
            <div class="chat-mesajlar" id="chatMesajAlaniSol"></div>
            <form class="chat-form" id="chatFormuSol">
                <input type="text" id="chatMesajInputSol" placeholder="Mesajınızı yazın..." required autocomplete="off">
                <button type="submit"><i class="fas fa-paper-plane"></i></button>
            </form>
        </div>
    </div>

    <!-- ===== DESTEK KUTUSU ===== -->
    <div class="destek-kapsayici" id="destekKapsayici">
        <div class="chat-baslik destek-baslik">
            <div class="baslik-sol"><i class="fas fa-headset"></i> <span>Canlı Destek</span> <span class="online-nokta"></span></div>
            <div style="display:flex; gap:8px; align-items:center;">
                <button class="sonlandir-btn" id="sonlandirBtn" onclick="destekSonlandirModalAc()" style="display:none; background:rgba(239,68,68,0.8); color:white; border:none; padding:4px 12px; border-radius:50px; font-size:11px; font-weight:700; cursor:pointer; transition:all 0.3s;"><i class="fas fa-stop"></i> Sonlandır</button>
                <button class="kapat-btn" onclick="destekPencerisiniAcKapat()"><i class="fas fa-times"></i></button>
            </div>
        </div>
        <div class="chat-mesajlar" id="destekMesajAlani">
            <div class="chat-mesaj sistem"><i class="fas fa-robot"></i> Hoş geldin! Size nasıl yardımcı olabilirim?</div>
        </div>
        <form class="chat-form" id="destekFormu">
            <input type="text" id="destekMesajInput" placeholder="Mesajınızı yazın..." required autocomplete="off">
            <button type="submit" class="destek-gonder"><i class="fas fa-paper-plane"></i></button>
        </form>
    </div>

    <!-- ===== SONLANDIRMA ONAY MODAL ===== -->
    <div class="onay-modal" id="sonlandirModal">
        <div class="onay-icerik">
            <h3><i class="fas fa-exclamation-triangle"></i> Sohbeti Sonlandır</h3>
            <p style="color:#94a3b8;">Hangi kullanıcının destek sohbetini sonlandırmak istiyorsun?</p>
            <div class="kullanici-listesi" id="kullaniciListesiModal"></div>
            <div class="onay-butonlar">
                <button class="hayir-btn" onclick="destekSonlandirModalKapat()"><i class="fas fa-times"></i> İptal</button>
                <button class="evet-btn" id="sonlandirOnaylaBtn" onclick="destekSonlandir()"><i class="fas fa-check"></i> Sonlandır</button>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- ===== JAVASCRIPT ===== -->
    <!-- ============================================ -->
    <script>
    // ============================================
    // TAM SCRIPT - FULL VFX + PREMIUM
    // ============================================
    
    const aktif = JSON.parse(localStorage.getItem('aktifKullanici'));
    let suAnkiSohbetKullaniciSol = "";
    let destekAktif = false;
    let secilenSonlandirilacakKullanici = null;
    let yuklenenResimBase64 = "";

    // ============================================
    // DÜZENLE BUTONLARINI GÖSTER (admin9595 veya ilan sahibi)
    // ============================================
    function duzenleButonlariniGoster() {
        const user = JSON.parse(localStorage.getItem('aktifKullanici'));
        if (!user) return;
        
        document.querySelectorAll('.card').forEach(kart => {
            const satici = kart.getAttribute('data-satici');
            const id = kart.getAttribute('data-id');
            
            if (!satici || !id) return;
            
            if (user.kullaniciAdi === 'admin9595' || user.kullaniciAdi === satici) {
                const alan = document.getElementById('duzenleAlani-' + id);
                if (alan) {
                    alan.innerHTML = `<button class="ilan-ust-eylem-btn btn-duzenle" onclick="event.stopPropagation(); window.location.href='/ilan-duzenle?id=${id}';"><i class="fas fa-edit"></i> Düzenle</button>`;
                }
            }
        });
    }

    // ============================================
    // RESİM YÜKLEME
    // ============================================
    document.getElementById('ilanResimInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = function(event) {
            yuklenenResimBase64 = event.target.result;
            const onizleme = document.getElementById('ilanResimOnizleme');
            const goster = document.getElementById('ilanResimGoster');
            goster.src = yuklenenResimBase64;
            onizleme.style.display = 'block';
        };
        reader.readAsDataURL(file);
    });

    function ilanResimTemizle() {
        yuklenenResimBase64 = "";
        document.getElementById('ilanResimInput').value = '';
        document.getElementById('ilanResimOnizleme').style.display = 'none';
        document.getElementById('ilanResimGoster').src = '#';
    }

    // ============================================
    // YAPAY ZEKA CEVAP MOTORU
    // ============================================
    function aiCevapUret(mesaj) {
        const msg = mesaj.toLowerCase().trim();
        const cevaplar = [
            { anahtar: ["merhaba", "selam", "hey", "naber"], cevap: "Merhaba! Size nasıl yardımcı olabilirim? 😊" },
            { anahtar: ["teşekkür", "sağol", "tşk"], cevap: "Rica ederim! 🙏" },
            { anahtar: ["bakiye", "para", "cüzdan"], cevap: "💵 Bakiyenizi cüzdan kısmından kontrol edebilirsiniz." },
            { anahtar: ["ilan", "ilanlar", "ilan verme"], cevap: "📦 İlan vermek için 'İlan Ekle' butonunu kullanabilirsiniz." },
            { anahtar: ["destek", "yardım", "sorun"], cevap: "🛡️ Size nasıl yardımcı olabilirim?" },
            { anahtar: ["güvenli", "güvenlik"], cevap: "🔒 İtemlerinMarketi güvenli ticaret prensibiyle çalışır." }
        ];
        for (let i = 0; i < cevaplar.length; i++) {
            for (let j = 0; j < cevaplar[i].anahtar.length; j++) {
                if (msg.includes(cevaplar[i].anahtar[j])) {
                    return cevaplar[i].cevap;
                }
            }
        }
        return null;
    }

    // ============================================
    // DESTEK FONKSİYONLARI
    // ============================================
    function destekAiCevapla(kullaniciAdi, mesaj) {
        const odaKey = [kullaniciAdi, 'admin9595'].sort().join('_');
        let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        const aiCevap = aiCevapUret(mesaj);
        if (aiCevap) {
            mesajlar.push({ gonderen: 'SİSTEM', metin: `🤖 ${aiCevap}` });
            localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
            if (destekAktif && aktif.kullaniciAdi === kullaniciAdi) {
                destekMesajlariGoster(mesajlar);
            }
            bildirimEkle(kullaniciAdi, `🤖 AI Asistan: ${aiCevap}`);
            return true;
        } else {
            mesajlar.push({ gonderen: 'SİSTEM', metin: `📨 ${kullaniciAdi} size mesaj gönderdi (AI yönlendirdi)` });
            localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
            bildirimEkle('admin9595', `🤖 AI yönlendirdi! ${kullaniciAdi} mesaj gönderdi.`);
            return false;
        }
    }

    function destekPencerisiniAcKapat() {
        if (!aktif) { alert('Giriş yapmalısın!'); return; }
        const kapsayici = document.getElementById('destekKapsayici');
        kapsayici.classList.toggle('acik');
        if (kapsayici.classList.contains('acik')) {
            destekAktif = true;
            const odaKey = [aktif.kullaniciAdi, 'admin9595'].sort().join('_');
            const mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
            destekMesajlariGoster(mesajlar);
            document.getElementById('destekMesajInput').focus();
        } else {
            destekAktif = false;
        }
    }

    function destekMesajlariGoster(mesajlar) {
        const alan = document.getElementById('destekMesajAlani');
        alan.innerHTML = '';
        if (mesajlar.length === 0) {
            alan.innerHTML = `<div class="chat-mesaj sistem"><i class="fas fa-robot"></i> Hoş geldin! Size nasıl yardımcı olabilirim?</div>`;
            return;
        }
        mesajlar.forEach(m => {
            const div = document.createElement('div');
            div.className = 'chat-mesaj';
            if (m.gonderen === 'SİSTEM') {
                div.classList.add('sistem');
                div.textContent = m.metin;
            } else if (m.gonderen === 'SİSTEM_SONLANDIR') {
                div.classList.add('sonlandirildi');
                div.textContent = m.metin;
            } else if (m.gonderen === aktif.kullaniciAdi) {
                div.classList.add('giden');
                div.innerHTML = `${m.metin}<span class="mesaj-zaman">${new Date().toLocaleTimeString()}</span>`;
            } else {
                div.classList.add('gelen');
                div.innerHTML = `<span class="mesaj-gonderen"><i class="fas fa-headset"></i> Destek</span>${m.metin}<span class="mesaj-zaman">${new Date().toLocaleTimeString()}</span>`;
            }
            alan.appendChild(div);
        });
        alan.scrollTop = alan.scrollHeight;
    }

    document.getElementById('destekFormu').addEventListener('submit', function(e) {
        e.preventDefault();
        if (!aktif) return;
        const girdi = document.getElementById('destekMesajInput');
        const mesaj = girdi.value.trim();
        if (!mesaj) return;
        const odaKey = [aktif.kullaniciAdi, 'admin9595'].sort().join('_');
        let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        mesajlar.push({ gonderen: aktif.kullaniciAdi, metin: mesaj });
        localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
        destekMesajlariGoster(mesajlar);
        girdi.value = '';
        destekAiCevapla(aktif.kullaniciAdi, mesaj);
    });

    // ============================================
    // DESTEK SONLANDIRMA
    // ============================================
    function destekSonlandirModalAc() {
        if (aktif.rol !== 'admin') { alert('Sadece admin!'); return; }
        const modal = document.getElementById('sonlandirModal');
        const liste = document.getElementById('kullaniciListesiModal');
        liste.innerHTML = '';
        secilenSonlandirilacakKullanici = null;
        let tumUyeler = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
        if (tumUyeler.length === 0) {
            liste.innerHTML = '<div style="padding:12px; color:#94a3b8; text-align:center;">Hiç kullanıcı yok.</div>';
        } else {
            tumUyeler.forEach(u => {
                if (u.kullaniciAdi === 'admin9595') return;
                const item = document.createElement('div');
                item.className = 'kullanici-item';
                item.textContent = `👤 ${u.kullaniciAdi}`;
                item.onclick = function() {
                    document.querySelectorAll('.kullanici-item').forEach(el => el.classList.remove('selected'));
                    this.classList.add('selected');
                    secilenSonlandirilacakKullanici = u.kullaniciAdi;
                };
                liste.appendChild(item);
            });
        }
        modal.classList.add('active');
    }

    function destekSonlandirModalKapat() {
        document.getElementById('sonlandirModal').classList.remove('active');
        secilenSonlandirilacakKullanici = null;
    }

    function destekSonlandir() {
        if (!secilenSonlandirilacakKullanici) { alert('Kullanıcı seç!'); return; }
        if (confirm(`"${secilenSonlandirilacakKullanici}" sohbetini sonlandır?`)) {
            const odaKey = [secilenSonlandirilacakKullanici, 'admin9595'].sort().join('_');
            let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
            mesajlar.push({ gonderen: 'SİSTEM_SONLANDIR', metin: `🔚 Sohbet sonlandırıldı.` });
            localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
            bildirimEkle(secilenSonlandirilacakKullanici, `🔚 Destek sohbetiniz sonlandırıldı.`);
            alert('✅ Sonlandırıldı!');
            destekSonlandirModalKapat();
        }
    }

    // ============================================
    // 1 SAATTE BİR DESTEK SOHBETİNİ TEMİZLE
    // ============================================
    function destekSohbetiniTemizle() {
        if (!aktif) return;
        const odaKey = [aktif.kullaniciAdi, 'admin9595'].sort().join('_');
        let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        mesajlar = mesajlar.filter(m => m.gonderen !== 'SİSTEM' || m.metin.includes('Hoş geldin'));
        localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
        if (destekAktif) destekMesajlariGoster(mesajlar);
    }

    // ============================================
    // DİĞER FONKSİYONLAR
    // ============================================
    function bildirimEkle(kime, metin) {
        let tumBildirimler = JSON.parse(localStorage.getItem(`bildirimler_${kime}`) || '[]');
        tumBildirimler.unshift({ id: Date.now(), metin: metin, durum: 'yeni', tarih: new Date().toLocaleTimeString() });
        localStorage.setItem(`bildirimler_${kime}`, JSON.stringify(tumBildirimler));
    }

    function bildirimleriYukle() {
        if (!aktif) return;
        const bGövde = document.getElementById('bildirimListesiGövde');
        bGövde.innerHTML = '';
        let list = JSON.parse(localStorage.getItem(`bildirimler_${aktif.kullaniciAdi}`) || '[]');
        let yeniSayisi = list.filter(b => b.durum === 'yeni').length;
        document.getElementById('bSayac').innerText = yeniSayisi;
        if(yeniSayisi === 0) document.getElementById('bSayac').style.display = 'none';
        else document.getElementById('bSayac').style.display = 'block';
        if (list.length === 0) { bGövde.innerHTML = '<div class="bildirim-item">Bildirim yok.</div>'; return; }
        list.forEach(b => {
            const div = document.createElement('div'); div.className = 'bildirim-item';
            if(b.durum === 'yeni') div.style.background = 'rgba(51,65,85,0.3)';
            div.innerHTML = `${b.metin} <small>${b.tarih}</small>`;
            bGövde.appendChild(div);
        });
    }

    function bildirimMenuAcKapat(event) {
        event.stopPropagation();
        const menu = document.getElementById('bildirimListesiGövde');
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        if (menu.style.display === 'block') bildirimleriOkunduYap();
    }

    function bildirimleriOkunduYap() {
        if (!aktif) return;
        let list = JSON.parse(localStorage.getItem(`bildirimler_${aktif.kullaniciAdi}`) || '[]');
        list.forEach(b => b.durum = 'okundu');
        localStorage.setItem(`bildirimler_${aktif.kullaniciAdi}`, JSON.stringify(list));
    }

    // ============================================
    // PROFİL MENÜSÜ
    // ============================================
    function profilMenusuAcKapat(event) {
        event.stopPropagation();
        const menu = document.getElementById('profilAçilirMenu');
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }

    function sistemdenCikisYap() {
        document.getElementById('sohbetKapsayici').classList.remove('acik');
        document.getElementById('destekKapsayici').classList.remove('acik');
        document.getElementById('profilAçilirMenu').style.display = 'none';
        localStorage.removeItem('aktifKullanici'); 
        window.location.reload();
    }

    window.addEventListener('click', function() {
        const pMenu = document.getElementById('profilAçilirMenu');
        if (pMenu) pMenu.style.display = 'none';
        const menu = document.getElementById('bildirimListesiGövde');
        if (menu) menu.style.display = 'none';
    });

    // ============================================
    // KURALLAR MODAL
    // ============================================
    function kurallariGoster(event) {
        if (event) { event.preventDefault(); event.stopPropagation(); }
        document.getElementById('kurallarModal').classList.add('active');
    }
    function kurallarModalKapat() {
        document.getElementById('kurallarModal').classList.remove('active');
    }

    // ============================================
    // İLAN LİSTELEME (EJS ile render)
    // ============================================
    function ilanlariListele() {
        setTimeout(duzenleButonlariniGoster, 100);
    }

    // ============================================
    // İLAN EKLEME MODAL
    // ============================================
    function ilanEkleModalAc() {
        document.getElementById('ilanEkleModal').classList.add('active');
    }
    function ilanEkleModalKapat() {
        document.getElementById('ilanEkleModal').classList.remove('active');
    }

    document.querySelector('.btn-glow:not(.btn-glow-gold)').addEventListener('click', function(e) {
        if (!aktif) { alert('Giriş yap!'); window.location.href = '/login'; return; }
        ilanEkleModalAc();
    });

    document.getElementById('ilanFormu').addEventListener('submit', function(e) {
        e.preventDefault();
        const kurallarOnay = document.getElementById('kurallarOnay');
        if (!kurallarOnay.checked) { alert('Kuralları kabul et!'); return; }
        
        const baslik = document.getElementById('ilanBaslik').value;
        const fiyat = parseFloat(document.getElementById('ilanFiyat').value);
        const detay = document.getElementById('ilanDetay').value;
        const sure = document.getElementById('ilanSure').value || '24 Saat';
        const resim = yuklenenResimBase64 || '';
        
        if (!baslik || !fiyat) { alert('Başlık ve fiyat gir!'); return; }
        
        fetch('/api/ilan-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                baslik, fiyat, detay, sure, resim,
                satici: aktif.kullaniciAdi
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                ilanEkleModalKapat();
                document.getElementById('ilanFormu').reset();
                document.getElementById('kurallarOnay').checked = false;
                ilanResimTemizle();
                alert('✅ İlan başarıyla yayınlandı!');
                window.location.reload();
            } else {
                alert('❌ İlan eklenirken hata: ' + data.error);
            }
        })
        .catch(err => {
            alert('❌ Bağlantı hatası: ' + err.message);
        });
    });

    // ============================================
    // SATIN ALMA
    // ============================================
    function ilanSatinAl(id, fiyat, satici, baslik) {
        if (!aktif) { alert('Giriş yap!'); window.location.href = '/login'; return; }
        if (aktif.kullaniciAdi === satici) { alert('Kendi ilanını satın alamazsın!'); return; }
        if ((aktif.bakiye || 0) < fiyat) { alert('Bakiyen yetersiz!'); return; }
        
        if (confirm(`"${baslik}" ilanını ${fiyat} TL'ye satın almak istediğine emin misin?`)) {
            let kullanicilar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
            const aIdx = kullanicilar.findIndex(u => u.kullaniciAdi === aktif.kullaniciAdi);
            if (aIdx !== -1) {
                kullanicilar[aIdx].bakiye = parseFloat((kullanicilar[aIdx].bakiye - fiyat).toFixed(2));
                localStorage.setItem('kullanicilar', JSON.stringify(kullanicilar));
                aktif.bakiye = kullanicilar[aIdx].bakiye;
                localStorage.setItem('aktifKullanici', JSON.stringify(aktif));
                document.getElementById('cuzdanBakiyeYazi').innerText = aktif.bakiye + " ₺";
            }
            
            bildirimEkle(satici, `🎉 "${baslik}" ilanınız ${aktif.kullaniciAdi} tarafından satın alındı!`);
            bildirimEkle(aktif.kullaniciAdi, `🛍️ "${baslik}" ilanını satın aldın!`);
            
            fetch(`/api/ilan-sil/${id}`, {
                method: 'DELETE'
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert("✅ Satın alma başarılı! Güvenli havuz devrede.");
                    window.location.reload();
                } else {
                    alert('❌ İlan silinirken hata: ' + data.error);
                }
            })
            .catch(err => {
                alert('❌ Bağlantı hatası: ' + err.message);
            });
        }
    }

    // ============================================
    // SOHBET (SOL)
    // ============================================
    function sohbetPencerisiniAcKapat() {
        if (!aktif) { alert('Giriş yap!'); return; }
        const kutu = document.getElementById('sohbetKapsayici');
        kutu.classList.toggle('acik');
        if (kutu.classList.contains('acik')) {
            kisilerListesiniYukleSol();
            document.getElementById('ekranKonusmaSol').style.display = 'none';
        }
    }

    function kisilerListesiniYukleSol() {
        const govde = document.getElementById('kisiListesiGövdeSol'); 
        govde.innerHTML = '';
        let tumUyeler = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
        let konusulacaklar = tumUyeler.map(u => u.kullaniciAdi).filter(name => name !== aktif.kullaniciAdi);
        if (!konusulacaklar.includes('admin9595') && aktif.kullaniciAdi !== 'admin9595') {
            konusulacaklar.push('admin9595');
        }
        if (konusulacaklar.length === 0) {
            govde.innerHTML = '<div style="padding:20px; text-align:center; color:#94a3b8;">Henüz mesajlaşacak kişi yok.</div>';
            return;
        }
        konusulacaklar.forEach(isim => {
            const kart = document.createElement('div'); 
            kart.className = 'kisi-kart'; 
            kart.onclick = () => ozelKonusmaAcSol(isim);
            kart.innerHTML = `<div class="kisi-avatar">${isim.toUpperCase().substring(0,2)}</div><div><strong style="color:white; font-size:15px;">${isim}</strong><p style="color:#94a3b8; font-size:12px; margin:2px 0 0 0;">Mesajlaşmak için tıkla</p></div>`;
            govde.appendChild(kart);
        });
    }

    function ozelKonusmaAcSol(hedefAd) { 
        suAnkiSohbetKullaniciSol = hedefAd; 
        document.getElementById('sohbetHedefAdSol').innerText = hedefAd; 
        document.getElementById('kisiListesiGövdeSol').style.display = 'none'; 
        document.getElementById('ekranKonusmaSol').style.display = 'flex'; 
        mesajlariYukleSol(); 
    }

    function kisilerEkraninaDonSol() { 
        suAnkiSohbetKullaniciSol = ""; 
        document.getElementById('ekranKonusmaSol').style.display = 'none'; 
        document.getElementById('kisiListesiGövdeSol').style.display = 'block';
        document.getElementById('chatMesajAlaniSol').innerHTML = '';
        kisilerListesiniYukleSol(); 
    }

    function sohbetOdasiTetikle(saticiAdi) { 
        if (!aktif) { alert('Giriş yap!'); return; }
        if (aktif.kullaniciAdi === saticiAdi) return; 
        document.getElementById('sohbetKapsayici').classList.add('acik');
        ozelKonusmaAcSol(saticiAdi); 
    }

    function mesajlariYukleSol() {
        if (!suAnkiSohbetKullaniciSol) return; 
        const mesajAlani = document.getElementById('chatMesajAlaniSol'); 
        mesajAlani.innerHTML = '';
        const odaKey = [aktif.kullaniciAdi, suAnkiSohbetKullaniciSol].sort().join('_');
        const mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        mesajlar.forEach(m => {
            const blok = document.createElement('div'); 
            blok.className = 'chat-mesaj'; 
            if (m.gonderen === 'SİSTEM') {
                blok.classList.add('sistem');
                blok.textContent = m.metin;
            } else if (m.gonderen === 'SİSTEM_SONLANDIR') {
                blok.classList.add('sonlandirildi');
                blok.textContent = m.metin;
            } else if (m.gonderen === aktif.kullaniciAdi) {
                blok.classList.add('giden');
                blok.innerHTML = `${m.metin}<span class="mesaj-zaman">${new Date().toLocaleTimeString()}</span>`;
            } else {
                blok.classList.add('gelen');
                blok.innerHTML = `<span class="mesaj-gonderen">${m.gonderen}</span>${m.metin}<span class="mesaj-zaman">${new Date().toLocaleTimeString()}</span>`;
            }
            mesajAlani.appendChild(blok);
        });
        mesajAlani.scrollTop = mesajAlani.scrollHeight;
    }

    document.getElementById('chatFormuSol').addEventListener('submit', function(e) {
        e.preventDefault(); 
        if (!aktif || !suAnkiSohbetKullaniciSol) { alert('Kişi seç!'); return; }
        const girdi = document.getElementById('chatMesajInputSol'); 
        const odaKey = [aktif.kullaniciAdi, suAnkiSohbetKullaniciSol].sort().join('_');
        let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        mesajlar.push({ gonderen: aktif.kullaniciAdi, metin: girdi.value });
        localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar)); 
        girdi.value = ''; 
        mesajlariYukleSol();
    });

    // ============================================
    // BAKİYE GÜNCELLEME
    // ============================================
    function bakiyeGuncelle() {
        if (!aktif) return;
        let u = JSON.parse(localStorage.getItem('kullanicilar') || '[]').find(x => x.kullaniciAdi === aktif.kullaniciAdi);
        if(u) { 
            aktif.bakiye = u.bakiye; 
            localStorage.setItem('aktifKullanici', JSON.stringify(aktif)); 
            document.getElementById('cuzdanBakiyeYazi').innerText = u.bakiye + " ₺"; 
        }
    }

    // ============================================
    // DESTEK KONTROL
    // ============================================
    function destekKontrol() {
        if (destekAktif && aktif) {
            const odaKey = [aktif.kullaniciAdi, 'admin9595'].sort().join('_');
            const mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
            destekMesajlariGoster(mesajlar);
            const sonMesaj = mesajlar[mesajlar.length - 1];
            if (sonMesaj && sonMesaj.gonderen === 'SİSTEM_SONLANDIR') {
                document.getElementById('destekMesajInput').disabled = true;
                document.querySelector('#destekFormu button').disabled = true;
            } else {
                document.getElementById('destekMesajInput').disabled = false;
                document.querySelector('#destekFormu button').disabled = false;
            }
        }
    }

    // ============================================
    // GİRİŞ YAPMIŞSA
    // ============================================
    if (aktif) {
        document.getElementById('bildirimKapsayici').style.display = 'block';
        document.getElementById('cuzdanKapsayici').style.display = 'block';
        document.getElementById('cuzdanBakiyeYazi').innerText = (aktif.bakiye || 0) + " ₺";
        document.getElementById('userInfo').innerText = aktif.kullaniciAdi;
        document.getElementById('profilGrup').style.display = 'block';
        document.getElementById('loginLink').style.display = 'none';
        
        let kayitliProfilResmi = localStorage.getItem(`profil_resim_${aktif.kullaniciAdi}`);
        if (kayitliProfilResmi) {
            document.getElementById('headerProfilResmi').src = kayitliProfilResmi;
        } else {
            document.getElementById('headerProfilResmi').src = '/profil.jpg';
        }
        
        const navMenu = document.getElementById('navMenu');
        const loginLink = document.getElementById('loginLink');
        if (aktif.rol === 'admin') {
            const adminLink = document.createElement('a');
            adminLink.href = '/yonetici-paneli'; 
            adminLink.innerText = 'Yönetici Paneli'; 
            adminLink.style.color = '#f59e0b';
            navMenu.insertBefore(adminLink, loginLink);
            document.getElementById('sonlandirBtn').style.display = 'block';
        }
        bildirimleriYukle();
    } else { 
        document.getElementById('userInfo').style.display = 'none'; 
    }

    // ============================================
    // BAŞLANGIÇ
    // ============================================
    ilanlariListele();
    
    setInterval(() => {
        destekSohbetiniTemizle();
    }, 3600000);
    
    setInterval(() => { 
        if (document.getElementById('ekranKonusmaSol').style.display === 'flex') { 
            mesajlariYukleSol(); 
        }
        destekKontrol();
        bildirimleriYukle(); 
        bakiyeGuncelle(); 
        duzenleButonlariniGoster();
    }, 3000);
    </script>
</body>
</html>