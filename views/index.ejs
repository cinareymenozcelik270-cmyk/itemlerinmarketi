<!DOCTYPE html>
<html lang="tr">
<head>
    <meta name="google-site-verification" content="rXTtLPJavFhXvJ7TGofxQ3XXGZXb_B8dzSBNAPZwLFk" />
    <link rel="icon" type="image/png" href="/resim.png">
    <meta charset="UTF-8">
    
    <!-- SEO -->
    <title><%= title || 'İtemlerinMarketi - Güvenli Ticaret ve Oyun İlanları' %></title>
    <meta name="description" content="<%= description || 'İtemlerinMarketi, güvenli ticaret platformu. Valorant, PUBG, CS:GO ve daha fazlası için oyun hesapları, e-pinler ve sanal ürünler. Hemen ilan ver veya satın al!' %>">
    <meta name="keywords" content="itemlerinmarketi, güvenli ticaret, oyun hesabı, valorant hesap, e-pin, riot points, sanal ürün">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph -->
    <meta property="og:title" content="İtemlerinMarketi - Güvenli Ticaret">
    <meta property="og:description" content="Güvenli ticaret platformu. Oyun hesapları, e-pinler ve sanal ürünler.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://itemlerinmarketi.onrender.com">
    
    <link rel="canonical" href="https://itemlerinmarketi.onrender.com" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="stylesheet" href="/style.css">
    
    <style>
        /* HEADER VE SOL ÜST GRUP ESNEK TASARIMI */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 20px;
            background: #1e293b;
            border-bottom: 1px solid #334155;
            flex-wrap: wrap;
        }
        .header-sol-bölüm {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        .logo-img { height: 60px; width: auto; max-width: 200px; object-fit: contain; cursor: pointer; }
        
        .pazar-wrapper { display: flex; gap: 30px; flex-wrap: wrap; margin-top: 20px; }
        .ilan-listesi-kutu { flex: 1; min-width: 300px; }

        .oval-ilan-ekle-btn {
            background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);
            color: white;
            border: none;
            padding: 10px 25px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
            white-space: nowrap;
        }
        .oval-ilan-ekle-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 16px rgba(99, 102, 241, 0.5);
        }
        .kurallar-btn {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
        }
        .kurallar-btn:hover {
            box-shadow: 0 6px 16px rgba(245, 158, 11, 0.5);
        }

        .card {
            position: relative;
            background: #1e293b;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #334155;
        }
        .card a {
            text-decoration: none;
            color: inherit;
            display: block;
        }
        .card a:hover .pazar-ilan-img {
            opacity: 0.9;
        }
        .pazar-ilan-img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 10px;
            border: 1px solid #334155;
            background: #0f172a;
        }
        .teslimat-rozet {
            display: inline-block;
            background: #1e1b4b;
            color: #a855f7;
            padding: 2px 8px;
            font-size: 11px;
            font-weight: bold;
            border-radius: 4px;
            border: 1px solid #a855f7;
            margin-bottom: 8px;
        }
        .price { color: #10b981; font-size: 20px; font-weight: bold; }

        .ilan-ust-eylem-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 4px 10px;
            font-size: 11px;
            font-weight: bold;
            border-radius: 20px;
            border: none;
            cursor: pointer;
            z-index: 10;
            box-shadow: 0 2px 8px rgba(0,0,0,0.4);
            transition: transform 0.2s;
        }
        .ilan-ust-eylem-btn:hover { transform: scale(1.1); }
        .btn-duzenle { background: #38bdf8; color: #0f172a; }
        .btn-raporla { background: #ef4444; color: white; }

        .header-sag-grup { display: flex; align-items: center; gap: 15px; flex-wrap: wrap; }
        .cuzdan-dropdown { position: relative; display: inline-block; }
        .cuzdan-buton { background: #15803d; color: white; padding: 6px 14px; border-radius: 20px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 13px; user-select: none; border: 1px solid #166534; }
        .cuzdan-buton svg { width: 14px; height: 14px; fill: white; }
        .dropdown-menu { display: none; position: absolute; right: 0; top: 35px; background-color: #1e293b; min-width: 160px; box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.5); border-radius: 8px; border: 1px solid #334155; z-index: 1002; overflow: hidden; }
        .dropdown-menu a { color: #cbd5e1; padding: 10px 14px; text-decoration: none; display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 500; border-bottom: 1px solid #334155; }
        .dropdown-menu a:last-child { border-bottom: none; }
        .dropdown-menu a:hover { background-color: #334155; color: #38bdf8; }
        .cuzdan-dropdown:hover .dropdown-menu { display: block; }
        
        .bildirim-dropdown { position: relative; display: inline-block; }
        .bildirim-buton { font-size: 20px; cursor: pointer; user-select: none; position: relative; background: none; border: none; padding: 5px; }
        .bildirim-sayac { position: absolute; top: -2px; right: -5px; background: #ef4444; color: white; font-size: 9px; padding: 1px 5px; border-radius: 10px; font-weight: bold; }
        .bildirim-menu { display: none; position: absolute; right: 0; top: 40px; background-color: #1e293b; width: 280px; max-height: 300px; overflow-y: auto; box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.5); border-radius: 8px; border: 1px solid #334155; z-index: 1002; }
        .bildirim-item { padding: 12px; border-bottom: 1px solid #334155; font-size: 13px; color: #cbd5e1; text-align: left; line-height: 1.4; }
        .bildirim-item:last-child { border-bottom: none; }
        .bildirim-item small { display: block; color: #94a3b8; margin-top: 4px; font-size: 11px; }

        .profil-dropdown { position: relative; display: inline-block; }
        .profil-avatar-btn { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; cursor: pointer; border: 2px solid #10b981; }
        .profil-menu { display: none; position: absolute; right: 0; top: 45px; background: #1e293b; min-width: 140px; border-radius: 8px; border: 1px solid #334155; z-index: 1005; overflow: hidden; }
        .profil-menu a { color: #cbd5e1; padding: 10px 15px; text-decoration: none; display: block; font-size: 13px; border-bottom: 1px solid #334155; }
        .profil-menu a:hover { background: #334155; color: #38bdf8; }
        .profil-menu a:last-child { border-bottom: none; }

        /* SOHBET BUTONU */
        .sohbet-butonu {
            position: fixed;
            bottom: 25px;
            left: 25px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            border-radius: 50%;
            box-shadow: 0 4px 16px rgba(99, 102, 241, 0.4);
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            z-index: 1001;
            transition: transform 0.2s;
            border: none;
        }
        .sohbet-butonu:hover { transform: scale(1.1); }
        .sohbet-butonu svg { width: 30px; height: 30px; fill: white; }

        /* DESTEK BUTONU */
        .destek-butonu {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border-radius: 50%;
            box-shadow: 0 4px 16px rgba(16, 185, 129, 0.4);
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            z-index: 1001;
            transition: transform 0.2s;
            border: none;
        }
        .destek-butonu:hover { transform: scale(1.1); }
        .destek-butonu img {
            width: 30px;
            height: 30px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        /* SOHBET KUTUSU */
        .sohbet-kapsayici {
            position: fixed;
            bottom: 100px;
            left: 25px;
            width: 350px;
            max-height: 450px;
            height: 450px;
            background: #1e293b;
            border: 2px solid #6366f1;
            border-radius: 16px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.6);
            z-index: 1000;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            display: none;
            flex-direction: column;
            overflow: hidden;
        }
        .sohbet-kapsayici.acik { display: flex; }

        /* DESTEK KUTUSU */
        .destek-kapsayici {
            position: fixed;
            bottom: 100px;
            right: 25px;
            width: 350px;
            max-height: 450px;
            height: 450px;
            background: #1e293b;
            border: 2px solid #10b981;
            border-radius: 16px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.6);
            z-index: 1000;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            display: none;
            flex-direction: column;
            overflow: hidden;
        }
        .destek-kapsayici.acik { display: flex; }

        .chat-baslik {
            padding: 14px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 15px;
            flex-shrink: 0;
            color: white;
        }
        .chat-baslik.sohbet-baslik {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        }
        .chat-baslik.destek-baslik {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        .chat-baslik .baslik-sol {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .chat-baslik .online-nokta {
            width: 10px;
            height: 10px;
            background: #10b981;
            border-radius: 50%;
            display: inline-block;
            animation: yanipSon 1.5s infinite;
        }
        @keyframes yanipSon {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        .chat-baslik .kapat-btn {
            background: none;
            border: none;
            color: white;
            font-size: 22px;
            cursor: pointer;
            padding: 0 5px;
            opacity: 0.7;
            transition: opacity 0.2s;
        }
        .chat-baslik .kapat-btn:hover { opacity: 1; }
        .chat-baslik .sonlandir-btn {
            background: #ef4444;
            color: white;
            border: none;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }
        .chat-baslik .sonlandir-btn:hover { background: #dc2626; }

        .chat-mesajlar {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
            background: #0f172a;
        }
        .chat-mesajlar::-webkit-scrollbar {
            width: 4px;
        }
        .chat-mesajlar::-webkit-scrollbar-track {
            background: #1e293b;
        }
        .chat-mesajlar::-webkit-scrollbar-thumb {
            background: #6366f1;
            border-radius: 4px;
        }

        .chat-mesaj {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.5;
            word-break: break-word;
        }
        .chat-mesaj.giden {
            align-self: flex-end;
            background: #6366f1;
            color: white;
            border-radius: 12px 12px 4px 12px;
        }
        .chat-mesaj.gelen {
            align-self: flex-start;
            background: #1e293b;
            color: #e2e8f0;
            border-radius: 12px 12px 12px 4px;
            border: 1px solid #334155;
        }
        .chat-mesaj .mesaj-zaman {
            font-size: 10px;
            opacity: 0.6;
            margin-top: 4px;
            display: block;
        }
        .chat-mesaj .mesaj-gonderen {
            font-size: 11px;
            font-weight: 600;
            color: #a855f7;
            display: block;
            margin-bottom: 2px;
        }
        .chat-mesaj.sistem {
            align-self: center;
            background: #1e1b4b;
            color: #a855f7;
            border: 1px solid #a855f7;
            font-size: 12px;
            padding: 6px 14px;
            border-radius: 20px;
            max-width: 90%;
            text-align: center;
        }
        .chat-mesaj.sonlandirildi {
            align-self: center;
            background: #7f1d1d;
            color: #fca5a5;
            border: 1px solid #ef4444;
            font-size: 12px;
            padding: 6px 14px;
            border-radius: 20px;
            max-width: 90%;
            text-align: center;
        }

        .chat-form {
            display: flex;
            padding: 12px 15px;
            background: #1e293b;
            gap: 10px;
            border-top: 1px solid #334155;
            flex-shrink: 0;
        }
        .chat-form input {
            flex: 1;
            padding: 10px 14px;
            background: #0f172a;
            border: 1px solid #334155;
            color: white;
            border-radius: 25px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.3s;
        }
        .chat-form input:focus {
            border-color: #6366f1;
        }
        .chat-form input::placeholder {
            color: #64748b;
        }
        .chat-form input:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .chat-form button {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            font-size: 14px;
            white-space: nowrap;
        }
        .chat-form button:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
        }
        .chat-form button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }
        .chat-form button.destek-gonder {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        .chat-form button.destek-gonder:hover {
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
        }

        .kisiler-listesi {
            flex: 1;
            padding: 10px;
            overflow-y: auto;
            background: #0f172a;
        }
        .kisi-kart {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: #1e293b;
            margin-bottom: 5px;
            border-radius: 8px;
            cursor: pointer;
            border: 1px solid #334155;
            transition: background 0.2s;
        }
        .kisi-kart:hover {
            background: #334155;
            border-color: #6366f1;
        }
        .kisi-avatar {
            width: 35px;
            height: 35px;
            background: #475569;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            color: #38bdf8;
            font-size: 14px;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        .modal-overlay.active { display: flex; }
        .modal-icerik {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            max-width: 700px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            padding: 25px;
            color: #cbd5e1;
        }
        .modal-icerik h2 { color: #38bdf8; margin-top: 0; }
        .modal-icerik h3 { color: #a855f7; }
        .modal-kapat-btn {
            background: #ef4444;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            float: right;
        }
        .modal-kapat-btn:hover { background: #dc2626; }

        .kurallar-checkbox {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 12px 0;
            color: #94a3b8;
            font-size: 14px;
        }
        .kurallar-checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #6366f1;
            cursor: pointer;
        }
        .kurallar-link {
            color: #38bdf8;
            text-decoration: underline;
            cursor: pointer;
        }
        .kurallar-link:hover { color: #a855f7; }

        @media (max-width: 480px) {
            .sohbet-kapsayici, .destek-kapsayici {
                width: 100%;
                height: 100%;
                bottom: 0;
                left: 0;
                right: 0;
                border-radius: 0;
                border: none;
            }
            .sohbet-butonu, .destek-butonu {
                width: 50px;
                height: 50px;
            }
            .sohbet-butonu { left: 15px; }
            .destek-butonu { right: 15px; }
        }

        .onay-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.8);
            z-index: 10000;
            justify-content: center;
            align-items: center;
        }
        .onay-modal.active { display: flex; }
        .onay-icerik {
            background: #1e293b;
            border: 1px solid #ef4444;
            border-radius: 16px;
            max-width: 450px;
            width: 90%;
            padding: 30px;
            color: #cbd5e1;
            text-align: center;
        }
        .onay-icerik h3 { color: #ef4444; margin-top: 0; }
        .onay-icerik .onay-butonlar {
            display: flex;
            gap: 15px;
            margin-top: 20px;
            justify-content: center;
        }
        .onay-icerik .onay-butonlar button {
            padding: 10px 30px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .onay-icerik .onay-butonlar button:hover { transform: scale(1.05); }
        .onay-icerik .onay-butonlar .evet-btn {
            background: #ef4444;
            color: white;
        }
        .onay-icerik .onay-butonlar .evet-btn:hover { background: #dc2626; }
        .onay-icerik .onay-butonlar .hayir-btn {
            background: #475569;
            color: white;
        }
        .onay-icerik .onay-butonlar .hayir-btn:hover { background: #334155; }
        .onay-icerik .kullanici-listesi {
            background: #0f172a;
            border-radius: 8px;
            padding: 10px;
            margin: 15px 0;
            max-height: 150px;
            overflow-y: auto;
            text-align: left;
        }
        .onay-icerik .kullanici-listesi .kullanici-item {
            padding: 8px 12px;
            border-bottom: 1px solid #334155;
            cursor: pointer;
            border-radius: 4px;
            transition: background 0.2s;
        }
        .onay-icerik .kullanici-listesi .kullanici-item:hover {
            background: #1e293b;
        }
        .onay-icerik .kullanici-listesi .kullanici-item.selected {
            background: #334155;
            border-left: 3px solid #ef4444;
        }
        .onay-icerik .kullanici-listesi .kullanici-item:last-child {
            border-bottom: none;
        }

        .resim-ekle-alani {
            margin-bottom: 12px;
        }
        .resim-ekle-alani label {
            color: #94a3b8;
            font-size: 13px;
            display: block;
            margin-bottom: 4px;
        }
        .resim-ekle-alani input[type="file"] {
            width: 100%;
            padding: 10px;
            background: #0f172a;
            border: 1px solid #475569;
            color: white;
            border-radius: 6px;
            box-sizing: border-box;
            cursor: pointer;
        }
        .resim-ekle-alani input[type="file"]::-webkit-file-upload-button {
            background: #334155;
            color: white;
            border: none;
            padding: 6px 14px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
        .resim-ekle-alani input[type="file"]::-webkit-file-upload-button:hover {
            background: #475569;
        }
        .resim-onizleme {
            margin-top: 8px;
            display: none;
            position: relative;
        }
        .resim-onizleme img {
            max-width: 100%;
            max-height: 150px;
            border-radius: 6px;
            border: 1px solid #334155;
        }
        .resim-onizleme .kaldir-btn {
            background: #ef4444;
            color: white;
            border: none;
            padding: 4px 12px;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 4px;
            font-size: 12px;
        }
        .resim-onizleme .kaldir-btn:hover {
            background: #dc2626;
        }
    </style>
</head>
<body>
    <header>
        <div class="header-sol-bölüm">
            <a href="/"><img src="/gif.png" alt="İtemlerinMarketi" class="logo-img" onerror="this.onerror=null; this.outerHTML='İtemlerinMarketi';"></a>
            <a href="/ilan-ekle" class="oval-ilan-ekle-btn">➕ İlan Ekle</a>
            <button class="oval-ilan-ekle-btn kurallar-btn" onclick="kurallariGoster(event)">📋 Kurallar</button>
        </div>
        
        <div class="header-sag-grup">
            <div class="bildirim-dropdown" id="bildirimKapsayici" style="display: none;">
                <div class="bildirim-buton" onclick="bildirimMenuAcKapat(event)">
                    🔔 <span class="bildirim-sayac" id="bSayac">0</span>
                </div>
