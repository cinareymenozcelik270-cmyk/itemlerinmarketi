<!DOCTYPE html>
<html lang="tr">
<head>
    <!-- GOOGLE ADSENSE -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7453399945201277" crossorigin="anonymous"></script>
    <meta name="google-adsense-account" content="ca-pub-7453399945201277">
    <meta name="google-site-verification" content="rXTtLPJavFhXvJ7TGofxQ3XXGZXb_B8dzSBNAPZwLFk" />
    <link rel="icon" type="image/png" href="/resim.png">
    <meta charset="UTF-8">
    <title><%= title || 'İtemlerinMarketi - Güvenli Ticaret' %></title>
    <meta name="description" content="İtemlerinMarketi - Güvenli ticaret platformu. Oyun hesapları, e-pinler ve sanal ürünler.">
    <link rel="canonical" href="https://itemlerinmarketi.onrender.com" />
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ===== RESET & BASE ===== */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #0a0a1a;
            color: #e8e8f0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ===== ARKA PLAN ===== */
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: 
                radial-gradient(ellipse at 10% 20%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 90% 80%, rgba(168, 85, 247, 0.06) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(16, 185, 129, 0.04) 0%, transparent 70%);
            z-index: -1;
            pointer-events: none;
        }

        /* ===== HEADER ===== */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 40px;
            background: rgba(10, 10, 26, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            position: sticky;
            top: 0;
            z-index: 100;
            flex-wrap: wrap;
            gap: 12px;
        }
        .header-sol-bölüm {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        .logo-img {
            height: 42px;
            width: auto;
            object-fit: contain;
            transition: opacity 0.3s;
        }
        .logo-img:hover { opacity: 0.8; }

        .btn {
            padding: 10px 22px;
            border: none;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Inter', sans-serif;
        }
        .btn-primary {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.25);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(99, 102, 241, 0.35);
        }
        .btn-gold {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            box-shadow: 0 4px 20px rgba(245, 158, 11, 0.2);
        }
        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(245, 158, 11, 0.3);
        }
        .btn-ghost {
            background: rgba(255,255,255,0.06);
            color: #c4c4d4;
            border: 1px solid rgba(255,255,255,0.08);
        }
        .btn-ghost:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }

        .header-sag-grup {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }
        .cuzdan-buton {
            background: rgba(255,255,255,0.06);
            padding: 8px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,0.06);
            transition: all 0.3s;
            color: #e8e8f0;
        }
        .cuzdan-buton:hover {
            background: rgba(255,255,255,0.1);
            border-color: rgba(99, 102, 241, 0.3);
        }
        .cuzdan-buton svg { width: 16px; height: 16px; fill: #e8e8f0; }
        .cuzdan-buton .bakiye-renk { color: #34d399; }

        .dropdown {
            position: relative;
            display: inline-block;
        }
        .dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 44px;
            background: #14142a;
            min-width: 180px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.06);
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            z-index: 1002;
            overflow: hidden;
            backdrop-filter: blur(20px);
        }
        .dropdown:hover .dropdown-menu { display: block; }
        .dropdown-menu a {
            color: #c4c4d4;
            padding: 10px 18px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 500;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: all 0.2s;
        }
        .dropdown-menu a:last-child { border-bottom: none; }
        .dropdown-menu a:hover { background: rgba(99, 102, 241, 0.1); color: white; }

        .profil-avatar-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            cursor: pointer;
            border: 2px solid rgba(99, 102, 241, 0.3);
            transition: all 0.3s;
        }
        .profil-avatar-btn:hover { border-color: #6366f1; transform: scale(1.05); }

        .user-info {
            font-size: 13px;
            font-weight: 500;
            color: #c4c4d4;
        }
        .user-info.guest { color: #5a5a7a; }

        /* ===== BİLDİRİM ===== */
        .bildirim-buton {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #8a8aaa;
            position: relative;
            padding: 6px;
            transition: color 0.3s;
        }
        .bildirim-buton:hover { color: white; }
        .bildirim-sayac {
            position: absolute;
            top: -2px;
            right: -2px;
            background: #ef4444;
            color: white;
            font-size: 9px;
            padding: 1px 6px;
            border-radius: 50px;
            font-weight: 700;
        }
        .bildirim-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 44px;
            background: #14142a;
            width: 300px;
            max-height: 350px;
            overflow-y: auto;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.06);
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            z-index: 1002;
            backdrop-filter: blur(20px);
        }
        .bildirim-item {
            padding: 12px 18px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 13px;
            color: #c4c4d4;
            line-height: 1.4;
        }
        .bildirim-item:last-child { border-bottom: none; }
        .bildirim-item small {
            display: block;
            color: #5a5a7a;
            font-size: 11px;
            margin-top: 4px;
        }
        .bildirim-item.yeni { background: rgba(99, 102, 241, 0.08); }

        /* ===== NAV ===== */
        nav {
            display: flex;
            gap: 16px;
            align-items: center;
        }
        nav a {
            color: #8a8aaa;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.3s;
            padding: 4px 0;
            border-bottom: 2px solid transparent;
        }
        nav a:hover { color: white; }
        nav a.active { color: white; border-bottom-color: #6366f1; }

        /* ===== CONTAINER ===== */
        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 40px 24px;
        }
        .pazar-wrapper { display: flex; flex-wrap: wrap; gap: 32px; }
        .ilan-listesi-kutu { flex: 1; min-width: 280px; }

        .sayfa-baslik {
            font-size: 28px;
            font-weight: 800;
            color: white;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .sayfa-baslik span {
            font-weight: 400;
            color: #5a5a7a;
            font-size: 18px;
        }
        .sayfa-baslik .vurgu { color: #6366f1; }

        /* ===== İLAN GRİD ===== */
        .ilan-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 24px;
        }
        .card {
            background: rgba(255,255,255,0.03);
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.06);
            padding: 20px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            backdrop-filter: blur(10px);
        }
        .card:hover {
            transform: translateY(-6px);
            border-color: rgba(99, 102, 241, 0.3);
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            background: rgba(255,255,255,0.05);
        }
        .card a { text-decoration: none; color: inherit; display: block; }
        .pazar-ilan-img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 14px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.04);
            transition: transform 0.4s;
        }
        .card:hover .pazar-ilan-img { transform: scale(1.02); }
        .teslimat-rozet {
            display: inline-block;
            background: rgba(99, 102, 241, 0.12);
            color: #a5b4fc;
            padding: 3px 12px;
            font-size: 11px;
            font-weight: 600;
            border-radius: 50px;
            margin-bottom: 10px;
            border: 1px solid rgba(99, 102, 241, 0.1);
        }
        .ilan-baslik {
            font-size: 16px;
            font-weight: 600;
            color: white;
            margin-bottom: 4px;
        }
        .ilan-satici {
            font-size: 13px;
            color: #6a6a8a;
            margin-bottom: 6px;
        }
        .ilan-satici strong { color: #c4c4d4; }
        .price {
            font-size: 20px;
            font-weight: 700;
            color: #34d399;
            margin-bottom: 14px;
        }

        .kart-buton-grup {
            display: flex;
            gap: 10px;
        }
        .btn-kart {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-family: 'Inter', sans-serif;
        }
        .btn-kart-satin {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            box-shadow: 0 4px 16px rgba(99, 102, 241, 0.2);
        }
        .btn-kart-satin:hover { transform: scale(1.03); box-shadow: 0 6px 24px rgba(99, 102, 241, 0.3); }
        .btn-kart-mesaj {
            background: rgba(255,255,255,0.06);
            color: #c4c4d4;
            border: 1px solid rgba(255,255,255,0.06);
        }
        .btn-kart-mesaj:hover { background: rgba(255,255,255,0.1); color: white; }

        .ilan-ust-eylem-btn {
            position: absolute;
            top: 16px;
            right: 16px;
            padding: 4px 12px;
            font-size: 11px;
            font-weight: 600;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            z-index: 10;
            transition: all 0.3s;
            font-family: 'Inter', sans-serif;
        }
        .ilan-ust-eylem-btn:hover { transform: scale(1.05); }
        .btn-duzenle { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.1); }
        .btn-raporla { background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.08); }

        /* ===== BOS ILAN ===== */
        .bos-ilan {
            color: #5a5a7a;
            text-align: center;
            padding: 60px 20px;
            background: rgba(255,255,255,0.02);
            border-radius: 16px;
            border: 1px dashed rgba(255,255,255,0.06);
            grid-column: 1/-1;
        }
        .bos-ilan i { font-size: 40px; display: block; margin-bottom: 16px; color: #3a3a5a; }
        .bos-ilan p { font-size: 18px; }

        /* ===== MODAL ===== */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(12px);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        .modal-overlay.active { display: flex; }
        .modal-icerik {
            background: #14142a;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 20px;
            max-width: 540px;
            width: 92%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 36px;
            color: #e8e8f0;
            box-shadow: 0 40px 80px rgba(0,0,0,0.5);
        }
        .modal-icerik h2 {
            font-size: 24px;
            font-weight: 700;
            margin-top: 0;
            margin-bottom: 24px;
        }
        .modal-kapat-btn {
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: #5a5a7a;
            float: right;
            padding: 4px;
            transition: color 0.3s;
        }
        .modal-kapat-btn:hover { color: white; }

        .ilan-form input,
        .ilan-form textarea {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
            color: white;
            box-sizing: border-box;
            margin-bottom: 14px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            transition: border-color 0.3s;
        }
        .ilan-form input:focus,
        .ilan-form textarea:focus {
            border-color: #6366f1;
            outline: none;
            background: rgba(255,255,255,0.06);
        }
        .ilan-form input::placeholder,
        .ilan-form textarea::placeholder { color: #5a5a7a; }
        .ilan-form textarea { min-height: 80px; resize: vertical; }

        .kurallar-checkbox {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 14px 0;
            font-size: 14px;
            color: #8a8aaa;
        }
        .kurallar-checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #6366f1;
            cursor: pointer;
        }
        .kurallar-link {
            color: #a5b4fc;
            text-decoration: underline;
            cursor: pointer;
        }
        .kurallar-link:hover { color: white; }

        .resim-ekle-alani { margin-bottom: 14px; }
        .resim-ekle-alani label {
            display: block;
            font-size: 13px;
            color: #8a8aaa;
            margin-bottom: 6px;
        }
        .resim-ekle-alani input[type="file"] {
            width: 100%;
            padding: 10px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
            color: #c4c4d4;
            cursor: pointer;
            font-size: 13px;
        }
        .resim-onizleme {
            margin-top: 8px;
            display: none;
        }
        .resim-onizleme img {
            max-width: 100%;
            max-height: 140px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.06);
        }
        .resim-onizleme .kaldir-btn {
            background: none;
            border: none;
            color: #f87171;
            cursor: pointer;
            font-size: 12px;
            margin-top: 4px;
        }
        .resim-onizleme .kaldir-btn:hover { color: #ef4444; }

        /* ===== SOHBET BUTONLARI ===== */
        .sohbet-butonu {
            position: fixed;
            bottom: 28px;
            left: 28px;
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            border-radius: 50%;
            border: none;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1001;
            box-shadow: 0 8px 32px rgba(99, 102, 241, 0.3);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .sohbet-butonu:hover { transform: scale(1.08); box-shadow: 0 12px 40px rgba(99, 102, 241, 0.4); }
        .sohbet-butonu svg { width: 26px; height: 26px; fill: white; }

        .destek-butonu {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%;
            border: none;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1001;
            box-shadow: 0 8px 32px rgba(16, 185, 129, 0.3);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .destek-butonu:hover { transform: scale(1.08); box-shadow: 0 12px 40px rgba(16, 185, 129, 0.4); }
        .destek-butonu img {
            width: 28px;
            height: 28px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        /* ===== SOHBET KUTULARI ===== */
        .sohbet-kapsayici {
            position: fixed;
            bottom: 96px;
            left: 28px;
            width: 360px;
            max-height: 460px;
            height: 460px;
            background: #14142a;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            box-shadow: 0 24px 80px rgba(0,0,0,0.5);
            z-index: 1000;
            display: none;
            flex-direction: column;
            overflow: hidden;
            backdrop-filter: blur(20px);
        }
        .destek-kapsayici {
            position: fixed;
            bottom: 96px;
            right: 28px;
            width: 360px;
            max-height: 460px;
            height: 460px;
            background: #14142a;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            box-shadow: 0 24px 80px rgba(0,0,0,0.5);
            z-index: 1000;
            display: none;
            flex-direction: column;
            overflow: hidden;
            backdrop-filter: blur(20px);
        }
        .sohbet-kapsayici.acik,
        .destek-kapsayici.acik { display: flex; }

        .chat-baslik {
            padding: 14px 20px;
            background: rgba(255,255,255,0.03);
            border-bottom: 1px solid rgba(255,255,255,0.04);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 14px;
            color: white;
            flex-shrink: 0;
        }
        .chat-baslik .online-nokta {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            display: inline-block;
            margin-left: 6px;
        }
        .chat-baslik .kapat-btn {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #5a5a7a;
            transition: color 0.3s;
        }
        .chat-baslik .kapat-btn:hover { color: white; }
        .chat-baslik .sonlandir-btn {
            background: rgba(239, 68, 68, 0.1);
            border: none;
            color: #f87171;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            padding: 4px 12px;
            border-radius: 6px;
            transition: all 0.3s;
        }
        .chat-baslik .sonlandir-btn:hover { background: rgba(239, 68, 68, 0.2); }

        .chat-mesajlar {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: rgba(0,0,0,0.2);
        }
        .chat-mesajlar::-webkit-scrollbar { width: 4px; }
        .chat-mesajlar::-webkit-scrollbar-track { background: transparent; }
        .chat-mesajlar::-webkit-scrollbar-thumb { background: #3a3a5a; border-radius: 4px; }

        .chat-mesaj {
            max-width: 80%;
            padding: 10px 16px;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.5;
            word-break: break-word;
        }
        .chat-mesaj.giden {
            align-self: flex-end;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            border-radius: 16px 16px 4px 16px;
        }
        .chat-mesaj.gelen {
            align-self: flex-start;
            background: rgba(255,255,255,0.06);
            color: #e8e8f0;
            border-radius: 16px 16px 16px 4px;
            border: 1px solid rgba(255,255,255,0.04);
        }
        .chat-mesaj .mesaj-zaman {
            font-size: 10px;
            opacity: 0.5;
            margin-top: 4px;
            display: block;
        }
        .chat-mesaj .mesaj-gonderen {
            font-size: 11px;
            font-weight: 600;
            color: #a5b4fc;
            display: block;
            margin-bottom: 2px;
        }
        .chat-mesaj.sistem {
            align-self: center;
            background: rgba(99, 102, 241, 0.08);
            color: #a5b4fc;
            border: 1px solid rgba(99, 102, 241, 0.1);
            font-size: 12px;
            padding: 6px 18px;
            border-radius: 50px;
            max-width: 90%;
            text-align: center;
        }
        .chat-mesaj.sonlandirildi {
            align-self: center;
            background: rgba(239, 68, 68, 0.08);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.1);
            font-size: 12px;
            padding: 6px 18px;
            border-radius: 50px;
            max-width: 90%;
            text-align: center;
        }

        .chat-form {
            display: flex;
            padding: 12px 16px;
            background: rgba(255,255,255,0.02);
            border-top: 1px solid rgba(255,255,255,0.04);
            gap: 10px;
            flex-shrink: 0;
        }
        .chat-form input {
            flex: 1;
            padding: 10px 16px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.3s;
            color: white;
        }
        .chat-form input:focus { border-color: #6366f1; }
        .chat-form input::placeholder { color: #5a5a7a; }
        .chat-form button {
            padding: 10px 20px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s;
        }
        .chat-form button:hover { transform: scale(1.03); }
        .chat-form button.destek-gonder { background: linear-gradient(135deg, #10b981, #059669); }

        /* ===== KİŞİ LİSTESİ ===== */
        .kisiler-listesi {
            flex: 1;
            padding: 8px 12px;
            overflow-y: auto;
            background: rgba(0,0,0,0.15);
        }
        .kisi-kart {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            background: rgba(255,255,255,0.02);
            margin-bottom: 4px;
            border-radius: 10px;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,0.03);
            transition: all 0.2s;
        }
        .kisi-kart:hover { background: rgba(255,255,255,0.05); border-color: rgba(99, 102, 241, 0.1); }
        .kisi-avatar {
            width: 34px;
            height: 34px;
            background: rgba(99, 102, 241, 0.15);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 600;
            color: #a5b4fc;
            font-size: 13px;
            flex-shrink: 0;
        }

        /* ===== ONAY MODAL ===== */
        .onay-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(12px);
            z-index: 10000;
            justify-content: center;
            align-items: center;
        }
        .onay-modal.active { display: flex; }
        .onay-icerik {
            background: #14142a;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 20px;
            max-width: 420px;
            width: 90%;
            padding: 32px;
            text-align: center;
            box-shadow: 0 40px 80px rgba(0,0,0,0.5);
        }
        .onay-icerik h3 { color: white; margin-top: 0; }
        .onay-icerik .onay-butonlar {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }
        .onay-icerik .onay-butonlar button {
            padding: 10px 32px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-family: 'Inter', sans-serif;
        }
        .onay-icerik .onay-butonlar button:hover { transform: scale(1.03); }
        .onay-icerik .onay-butonlar .evet-btn { background: #ef4444; color: white; }
        .onay-icerik .onay-butonlar .evet-btn:hover { background: #dc2626; }
        .onay-icerik .onay-butonlar .hayir-btn { background: rgba(255,255,255,0.06); color: #c4c4d4; }
        .onay-icerik .onay-butonlar .hayir-btn:hover { background: rgba(255,255,255,0.1); }
        .onay-icerik .kullanici-listesi {
            background: rgba(0,0,0,0.2);
            border-radius: 10px;
            padding: 8px;
            margin: 14px 0;
            max-height: 130px;
            overflow-y: auto;
            text-align: left;
        }
        .onay-icerik .kullanici-item {
            padding: 8px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            cursor: pointer;
            border-radius: 6px;
            font-size: 14px;
            color: #c4c4d4;
            transition: all 0.2s;
        }
        .onay-icerik .kullanici-item:hover { background: rgba(255,255,255,0.04); }
        .onay-icerik .kullanici-item.selected { background: rgba(99, 102, 241, 0.1); border-left: 3px solid #6366f1; }
        .onay-icerik .kullanici-item:last-child { border-bottom: none; }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header { padding: 12px 20px; }
            .container { padding: 24px 16px; }
            .ilan-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
            .sohbet-kapsayici, .destek-kapsayici {
                width: calc(100% - 32px);
                height: calc(100% - 140px);
                bottom: 80px;
                left: 16px;
                right: 16px;
                border-radius: 16px;
            }
            .destek-kapsayici { left: 16px; right: 16px; }
            .sohbet-butonu, .destek-butonu { width: 48px; height: 48px; bottom: 20px; }
            .sohbet-butonu { left: 20px; }
            .destek-butonu { right: 20px; }
            .sayfa-baslik { font-size: 22px; }
            .modal-icerik { padding: 24px; }
            .header-sol-bölüm { gap: 12px; }
            .btn { padding: 8px 16px; font-size: 12px; }
        }
        @media (max-width: 480px) {
            .ilan-grid { grid-template-columns: 1fr; }
            header { flex-direction: column; align-items: stretch; gap: 8px; }
            .header-sol-bölüm { justify-content: center; flex-wrap: wrap; }
            .header-sag-grup { justify-content: center; flex-wrap: wrap; }
            nav { justify-content: center; flex-wrap: wrap; }
            .sohbet-kapsayici, .destek-kapsayici { height: calc(100% - 120px); bottom: 72px; }
        }
    </style>
</head>
<body>

    <!-- ===== HEADER ===== -->
