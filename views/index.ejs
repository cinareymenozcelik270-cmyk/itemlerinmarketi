    <!-- ============================================ -->
    <!-- ===== JAVASCRIPT ===== -->
    <!-- ============================================ -->
    <script>
    // ============================================
    // TAM SCRIPT
    // ============================================
    
    const aktif = JSON.parse(localStorage.getItem('aktifKullanici'));
    let suAnkiSohbetKullaniciSol = "";
    let destekAktif = false;
    let secilenSonlandirilacakKullanici = null;
    let yuklenenResimBase64 = "";

    // ============================================
    // DÜZENLE BUTONLARI
    // ============================================
    function duzenleButonlariniGoster() {
        const user = JSON.parse(localStorage.getItem('aktifKullanici'));
        if (!user) return;
        document.querySelectorAll('.card').forEach(kart => {
            const satici = kart.getAttribute('data-satici');
            const id = kart.getAttribute('data-id');
            if (!satici || !id) return;
            if (user.kullaniciAdi === 'admin9595' || user.kullaniciAdi === satici) {
                const alan = document.getElementById('duzenleAlani-' + id);
                if (alan) {
                    alan.innerHTML = `<button class="ilan-ust-eylem-btn btn-duzenle" onclick="event.stopPropagation(); window.location.href='/ilan-duzenle?id=${id}';"><i class="fas fa-edit"></i> Düzenle</button>`;
                }
            }
        });
    }

    // ============================================
    // RESİM YÜKLEME
    // ============================================
    document.getElementById('ilanResimInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(event) {
            yuklenenResimBase64 = event.target.result;
            document.getElementById('ilanResimOnizleme').style.display = 'block';
            document.getElementById('ilanResimGoster').src = yuklenenResimBase64;
        };
        reader.readAsDataURL(file);
    });

    function ilanResimTemizle() {
        yuklenenResimBase64 = "";
        document.getElementById('ilanResimInput').value = '';
        document.getElementById('ilanResimOnizleme').style.display = 'none';
        document.getElementById('ilanResimGoster').src = '#';
    }

    // ============================================
    // AI CEVAP
    // ============================================
    function aiCevapUret(mesaj) {
        const msg = mesaj.toLowerCase().trim();
        const cevaplar = [
            { anahtar: ["merhaba", "selam", "hey"], cevap: "Merhaba! Size nasıl yardımcı olabilirim? 😊" },
            { anahtar: ["teşekkür", "sağol"], cevap: "Rica ederim! 🙏" },
            { anahtar: ["bakiye", "para", "cüzdan"], cevap: "Bakiyenizi cüzdan kısmından kontrol edebilirsiniz." },
            { anahtar: ["ilan", "ilanlar"], cevap: "İlan vermek için 'İlan Ekle' butonunu kullanabilirsiniz." },
            { anahtar: ["destek", "yardım"], cevap: "Size nasıl yardımcı olabilirim?" },
            { anahtar: ["güvenli", "güvenlik"], cevap: "İtemlerinMarketi güvenli ticaret prensibiyle çalışır." }
        ];
        for (let i = 0; i < cevaplar.length; i++) {
            for (let j = 0; j < cevaplar[i].anahtar.length; j++) {
                if (msg.includes(cevaplar[i].anahtar[j])) return cevaplar[i].cevap;
            }
        }
        return null;
    }

    // ============================================
    // DESTEK
    // ============================================
    function destekAiCevapla(kullaniciAdi, mesaj) {
        const odaKey = [kullaniciAdi, 'admin9595'].sort().join('_');
        let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        const aiCevap = aiCevapUret(mesaj);
        if (aiCevap) {
            mesajlar.push({ gonderen: 'SİSTEM', metin: `🤖 ${aiCevap}` });
            localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
            if (destekAktif && aktif.kullaniciAdi === kullaniciAdi) destekMesajlariGoster(mesajlar);
            bildirimEkle(kullaniciAdi, `🤖 AI Asistan: ${aiCevap}`);
            return true;
        } else {
            mesajlar.push({ gonderen: 'SİSTEM', metin: `📨 ${kullaniciAdi} size mesaj gönderdi (AI yönlendirdi)` });
            localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
            bildirimEkle('admin9595', `🤖 AI yönlendirdi! ${kullaniciAdi} mesaj gönderdi.`);
            return false;
        }
    }

    function destekPencerisiniAcKapat() {
        if (!aktif) { alert('Giriş yapmalısın!'); return; }
        const kapsayici = document.getElementById('destekKapsayici');
        kapsayici.classList.toggle('acik');
        if (kapsayici.classList.contains('acik')) {
            destekAktif = true;
            const odaKey = [aktif.kullaniciAdi, 'admin9595'].sort().join('_');
            const mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
            destekMesajlariGoster(mesajlar);
            document.getElementById('destekMesajInput').focus();
        } else {
            destekAktif = false;
        }
    }

    function destekMesajlariGoster(mesajlar) {
        const alan = document.getElementById('destekMesajAlani');
        alan.innerHTML = '';
        if (mesajlar.length === 0) {
            alan.innerHTML = `<div class="chat-mesaj sistem"><i class="fas fa-robot"></i> Hoş geldin! Size nasıl yardımcı olabilirim?</div>`;
            return;
        }
        mesajlar.forEach(m => {
            const div = document.createElement('div');
            div.className = 'chat-mesaj';
            if (m.gonderen === 'SİSTEM') { div.classList.add('sistem'); div.textContent = m.metin; }
            else if (m.gonderen === 'SİSTEM_SONLANDIR') { div.classList.add('sonlandirildi'); div.textContent = m.metin; }
            else if (m.gonderen === aktif.kullaniciAdi) {
                div.classList.add('giden');
                div.innerHTML = `${m.metin}<span class="mesaj-zaman">${new Date().toLocaleTimeString()}</span>`;
            } else {
                div.classList.add('gelen');
                div.innerHTML = `<span class="mesaj-gonderen"><i class="fas fa-headset"></i> Destek</span>${m.metin}<span class="mesaj-zaman">${new Date().toLocaleTimeString()}</span>`;
            }
            alan.appendChild(div);
        });
        alan.scrollTop = alan.scrollHeight;
    }

    document.getElementById('destekFormu').addEventListener('submit', function(e) {
        e.preventDefault();
        if (!aktif) return;
        const girdi = document.getElementById('destekMesajInput');
        const mesaj = girdi.value.trim();
        if (!mesaj) return;
        const odaKey = [aktif.kullaniciAdi, 'admin9595'].sort().join('_');
        let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        mesajlar.push({ gonderen: aktif.kullaniciAdi, metin: mesaj });
        localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
        destekMesajlariGoster(mesajlar);
        girdi.value = '';
        destekAiCevapla(aktif.kullaniciAdi, mesaj);
    });

    // ============================================
    // SONLANDIRMA
    // ============================================
    function destekSonlandirModalAc() {
        if (aktif.rol !== 'admin') { alert('Sadece admin!'); return; }
        const modal = document.getElementById('sonlandirModal');
        const liste = document.getElementById('kullaniciListesiModal');
        liste.innerHTML = '';
        secilenSonlandirilacakKullanici = null;
        let tumUyeler = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
        if (tumUyeler.length === 0) {
            liste.innerHTML = '<div style="padding:8px; color:#5a5a7a;">Hiç kullanıcı yok.</div>';
        } else {
            tumUyeler.forEach(u => {
                if (u.kullaniciAdi === 'admin9595') return;
                const item = document.createElement('div');
                item.className = 'kullanici-item';
                item.textContent = `👤 ${u.kullaniciAdi}`;
                item.onclick = function() {
                    document.querySelectorAll('.kullanici-item').forEach(el => el.classList.remove('selected'));
                    this.classList.add('selected');
                    secilenSonlandirilacakKullanici = u.kullaniciAdi;
                };
                liste.appendChild(item);
            });
        }
        modal.classList.add('active');
    }

    function destekSonlandirModalKapat() {
        document.getElementById('sonlandirModal').classList.remove('active');
        secilenSonlandirilacakKullanici = null;
    }

    function destekSonlandir() {
        if (!secilenSonlandirilacakKullanici) { alert('Kullanıcı seç!'); return; }
        if (confirm(`"${secilenSonlandirilacakKullanici}" sohbetini sonlandır?`)) {
            const odaKey = [secilenSonlandirilacakKullanici, 'admin9595'].sort().join('_');
            let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
            mesajlar.push({ gonderen: 'SİSTEM_SONLANDIR', metin: `🔚 Sohbet sonlandırıldı.` });
            localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
            bildirimEkle(secilenSonlandirilacakKullanici, `🔚 Destek sohbetiniz sonlandırıldı.`);
            alert('✅ Sonlandırıldı!');
            destekSonlandirModalKapat();
        }
    }

    // ============================================
    // DİĞER FONKSİYONLAR
    // ============================================
    function bildirimEkle(kime, metin) {
        let tumBildirimler = JSON.parse(localStorage.getItem(`bildirimler_${kime}`) || '[]');
        tumBildirimler.unshift({ id: Date.now(), metin: metin, durum: 'yeni', tarih: new Date().toLocaleTimeString() });
        localStorage.setItem(`bildirimler_${kime}`, JSON.stringify(tumBildirimler));
    }

    function bildirimleriYukle() {
        if (!aktif) return;
        const bGövde = document.getElementById('bildirimListesiGövde');
        bGövde.innerHTML = '';
        let list = JSON.parse(localStorage.getItem(`bildirimler_${aktif.kullaniciAdi}`) || '[]');
        let yeniSayisi = list.filter(b => b.durum === 'yeni').length;
        document.getElementById('bSayac').innerText = yeniSayisi;
        document.getElementById('bSayac').style.display = yeniSayisi === 0 ? 'none' : 'block';
        if (list.length === 0) { bGövde.innerHTML = '<div class="bildirim-item">Bildirim yok.</div>'; return; }
        list.forEach(b => {
            const div = document.createElement('div');
            div.className = 'bildirim-item' + (b.durum === 'yeni' ? ' yeni' : '');
            div.innerHTML = `${b.metin} <small>${b.tarih}</small>`;
            bGövde.appendChild(div);
        });
    }

    function bildirimMenuAcKapat(event) {
        event.stopPropagation();
        const menu = document.getElementById('bildirimListesiGövde');
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        if (menu.style.display === 'block') {
            let list = JSON.parse(localStorage.getItem(`bildirimler_${aktif.kullaniciAdi}`) || '[]');
            list.forEach(b => b.durum = 'okundu');
            localStorage.setItem(`bildirimler_${aktif.kullaniciAdi}`, JSON.stringify(list));
        }
    }

    function profilMenusuAcKapat(event) {
        event.stopPropagation();
        const menu = document.getElementById('profilAçilirMenu');
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }

    function sistemdenCikisYap() {
        document.getElementById('sohbetKapsayici').classList.remove('acik');
        document.getElementById('destekKapsayici').classList.remove('acik');
        document.getElementById('profilAçilirMenu').style.display = 'none';
        localStorage.removeItem('aktifKullanici');
        window.location.reload();
    }

    window.addEventListener('click', function() {
        document.getElementById('profilAçilirMenu').style.display = 'none';
        document.getElementById('bildirimListesiGövde').style.display = 'none';
    });

    // ============================================
    // KURALLAR
    // ============================================
    function kurallariGoster(event) {
        if (event) { event.preventDefault(); event.stopPropagation(); }
        document.getElementById('kurallarModal').classList.add('active');
    }
    function kurallarModalKapat() {
        document.getElementById('kurallarModal').classList.remove('active');
    }

    // ============================================
    // İLAN EKLEME
    // ============================================
    function ilanEkleModalAc() {
        if (!aktif) { alert('Giriş yap!'); window.location.href = '/login'; return; }
        document.getElementById('ilanEkleModal').classList.add('active');
    }
    function ilanEkleModalKapat() {
        document.getElementById('ilanEkleModal').classList.remove('active');
    }

    document.getElementById('ilanFormu').addEventListener('submit', function(e) {
        e.preventDefault();
        if (!document.getElementById('kurallarOnay').checked) { alert('Kuralları kabul et!'); return; }
        
        const baslik = document.getElementById('ilanBaslik').value;
        const fiyat = parseFloat(document.getElementById('ilanFiyat').value);
        const detay = document.getElementById('ilanDetay').value;
        const sure = document.getElementById('ilanSure').value || '24 Saat';
        const resim = yuklenenResimBase64 || '';
        
        if (!baslik || !fiyat) { alert('Başlık ve fiyat gir!'); return; }
        
        fetch('/api/ilan-ekle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ baslik, fiyat, detay, sure, resim, satici: aktif.kullaniciAdi })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                ilanEkleModalKapat();
                document.getElementById('ilanFormu').reset();
                document.getElementById('kurallarOnay').checked = false;
                ilanResimTemizle();
                alert('✅ İlan başarıyla yayınlandı!');
                window.location.reload();
            } else {
                alert('❌ Hata: ' + data.error);
            }
        })
        .catch(err => alert('❌ Bağlantı hatası: ' + err.message));
    });

    // ============================================
    // SATIN ALMA
    // ============================================
    function ilanSatinAl(id, fiyat, satici, baslik) {
        if (!aktif) { alert('Giriş yap!'); window.location.href = '/login'; return; }
        if (aktif.kullaniciAdi === satici) { alert('Kendi ilanını satın alamazsın!'); return; }
        if ((aktif.bakiye || 0) < fiyat) { alert('Bakiyen yetersiz!'); return; }
        if (!confirm(`"${baslik}" ilanını ${fiyat} TL'ye satın al?`)) return;
        
        let kullanicilar = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
        const aIdx = kullanicilar.findIndex(u => u.kullaniciAdi === aktif.kullaniciAdi);
        if (aIdx !== -1) {
            kullanicilar[aIdx].bakiye = parseFloat((kullanicilar[aIdx].bakiye - fiyat).toFixed(2));
            localStorage.setItem('kullanicilar', JSON.stringify(kullanicilar));
            aktif.bakiye = kullanicilar[aIdx].bakiye;
            localStorage.setItem('aktifKullanici', JSON.stringify(aktif));
            document.getElementById('cuzdanBakiyeYazi').innerText = aktif.bakiye + " ₺";
        }
        
        bildirimEkle(satici, `🎉 "${baslik}" ilanınız ${aktif.kullaniciAdi} tarafından satın alındı!`);
        bildirimEkle(aktif.kullaniciAdi, `🛍️ "${baslik}" ilanını satın aldın!`);
        
        fetch(`/api/ilan-sil/${id}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("✅ Satın alma başarılı!");
                window.location.reload();
            } else {
                alert('❌ Hata: ' + data.error);
            }
        })
        .catch(err => alert('❌ Bağlantı hatası: ' + err.message));
    }

    // ============================================
    // SOHBET
    // ============================================
    function sohbetPencerisiniAcKapat() {
        if (!aktif) { alert('Giriş yap!'); return; }
        const kutu = document.getElementById('sohbetKapsayici');
        kutu.classList.toggle('acik');
        if (kutu.classList.contains('acik')) {
            kisilerListesiniYukleSol();
            document.getElementById('ekranKonusmaSol').style.display = 'none';
        }
    }

    function kisilerListesiniYukleSol() {
        const govde = document.getElementById('kisiListesiGövdeSol');
        govde.innerHTML = '';
        let tumUyeler = JSON.parse(localStorage.getItem('kullanicilar') || '[]');
        let konusulacaklar = tumUyeler.map(u => u.kullaniciAdi).filter(name => name !== aktif.kullaniciAdi);
        if (!konusulacaklar.includes('admin9595') && aktif.kullaniciAdi !== 'admin9595') konusulacaklar.push('admin9595');
        if (konusulacaklar.length === 0) {
            govde.innerHTML = '<div style="padding:16px; text-align:center; color:#5a5a7a;">Henüz mesajlaşacak kişi yok.</div>';
            return;
        }
        konusulacaklar.forEach(isim => {
            const kart = document.createElement('div');
            kart.className = 'kisi-kart';
            kart.onclick = () => ozelKonusmaAcSol(isim);
            kart.innerHTML = `<div class="kisi-avatar">${isim.substring(0,2).toUpperCase()}</div><div><strong style="color:white;">${isim}</strong><p style="color:#5a5a7a; font-size:12px; margin:0;">Mesajlaşmak için tıkla</p></div>`;
            govde.appendChild(kart);
        });
    }

    function ozelKonusmaAcSol(hedefAd) {
        suAnkiSohbetKullaniciSol = hedefAd;
        document.getElementById('sohbetHedefAdSol').innerText = hedefAd;
        document.getElementById('kisiListesiGövdeSol').style.display = 'none';
        document.getElementById('ekranKonusmaSol').style.display = 'flex';
        mesajlariYukleSol();
    }

    function kisilerEkraninaDonSol() {
        suAnkiSohbetKullaniciSol = "";
        document.getElementById('ekranKonusmaSol').style.display = 'none';
        document.getElementById('kisiListesiGövdeSol').style.display = 'block';
        document.getElementById('chatMesajAlaniSol').innerHTML = '';
        kisilerListesiniYukleSol();
    }

    function sohbetOdasiTetikle(saticiAdi) {
        if (!aktif) { alert('Giriş yap!'); return; }
        if (aktif.kullaniciAdi === saticiAdi) return;
        document.getElementById('sohbetKapsayici').classList.add('acik');
        ozelKonusmaAcSol(saticiAdi);
    }

    function mesajlariYukleSol() {
        if (!suAnkiSohbetKullaniciSol) return;
        const mesajAlani = document.getElementById('chatMesajAlaniSol');
        mesajAlani.innerHTML = '';
        const odaKey = [aktif.kullaniciAdi, suAnkiSohbetKullaniciSol].sort().join('_');
        const mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        mesajlar.forEach(m => {
            const blok = document.createElement('div');
            blok.className = 'chat-mesaj';
            if (m.gonderen === 'SİSTEM') { blok.classList.add('sistem'); blok.textContent = m.metin; }
            else if (m.gonderen === 'SİSTEM_SONLANDIR') { blok.classList.add('sonlandirildi'); blok.textContent = m.metin; }
            else if (m.gonderen === aktif.kullaniciAdi) {
                blok.classList.add('giden');
                blok.innerHTML = `${m.metin}<span class="mesaj-zaman">${new Date().toLocaleTimeString()}</span>`;
            } else {
                blok.classList.add('gelen');
                blok.innerHTML = `<span class="mesaj-gonderen">${m.gonderen}</span>${m.metin}<span class="mesaj-zaman">${new Date().toLocaleTimeString()}</span>`;
            }
            mesajAlani.appendChild(blok);
        });
        mesajAlani.scrollTop = mesajAlani.scrollHeight;
    }

    document.getElementById('chatFormuSol').addEventListener('submit', function(e) {
        e.preventDefault();
        if (!aktif || !suAnkiSohbetKullaniciSol) { alert('Kişi seç!'); return; }
        const girdi = document.getElementById('chatMesajInputSol');
        const odaKey = [aktif.kullaniciAdi, suAnkiSohbetKullaniciSol].sort().join('_');
        let mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
        mesajlar.push({ gonderen: aktif.kullaniciAdi, metin: girdi.value });
        localStorage.setItem(`ozel_oda_${odaKey}`, JSON.stringify(mesajlar));
        girdi.value = '';
        mesajlariYukleSol();
    });

    // ============================================
    // BAKİYE
    // ============================================
    function bakiyeGuncelle() {
        if (!aktif) return;
        let u = JSON.parse(localStorage.getItem('kullanicilar') || '[]').find(x => x.kullaniciAdi === aktif.kullaniciAdi);
        if (u) {
            aktif.bakiye = u.bakiye;
            localStorage.setItem('aktifKullanici', JSON.stringify(aktif));
            document.getElementById('cuzdanBakiyeYazi').innerText = u.bakiye + " ₺";
        }
    }

    // ============================================
    // DESTEK KONTROL
    // ============================================
    function destekKontrol() {
        if (destekAktif && aktif) {
            const odaKey = [aktif.kullaniciAdi, 'admin9595'].sort().join('_');
            const mesajlar = JSON.parse(localStorage.getItem(`ozel_oda_${odaKey}`) || '[]');
            destekMesajlariGoster(mesajlar);
            const sonMesaj = mesajlar[mesajlar.length - 1];
            if (sonMesaj && sonMesaj.gonderen === 'SİSTEM_SONLANDIR') {
                document.getElementById('destekMesajInput').disabled = true;
                document.querySelector('#destekFormu button').disabled = true;
            } else {
                document.getElementById('destekMesajInput').disabled = false;
                document.querySelector('#destekFormu button').disabled = false;
            }
        }
    }

    // ============================================
    // GİRİŞ KONTROL
    // ============================================
    if (aktif) {
        document.getElementById('bildirimKapsayici').style.display = 'block';
        document.getElementById('cuzdanKapsayici').style.display = 'block';
        document.getElementById('cuzdanBakiyeYazi').innerText = (aktif.bakiye || 0) + " ₺";
        document.getElementById('userInfo').innerText = aktif.kullaniciAdi;
        document.getElementById('userInfo').className = 'user-info';
        document.getElementById('profilGrup').style.display = 'block';
        document.getElementById('loginLink').style.display = 'none';
        
        let kayitliProfilResmi = localStorage.getItem(`profil_resim_${aktif.kullaniciAdi}`);
        document.getElementById('headerProfilResmi').src = kayitliProfilResmi || '/profil.jpg';
        
        const navMenu = document.getElementById('navMenu');
        const loginLink = document.getElementById('loginLink');
        if (aktif.rol === 'admin') {
            const adminLink = document.createElement('a');
            adminLink.href = '/yonetici-paneli';
            adminLink.innerText = 'Admin';
            adminLink.style.color = '#f59e0b';
            navMenu.insertBefore(adminLink, loginLink);
            document.getElementById('sonlandirBtn').style.display = 'block';
        }
        bildirimleriYukle();
    } else {
        document.getElementById('userInfo').style.display = 'none';
    }

    // ============================================
    // BAŞLANGIÇ
    // ============================================
    setTimeout(duzenleButonlariniGoster, 100);
    
    setInterval(() => {
        if (document.getElementById('ekranKonusmaSol').style.display === 'flex') mesajlariYukleSol();
        destekKontrol();
        bildirimleriYukle();
        bakiyeGuncelle();
        duzenleButonlariniGoster();
    }, 3000);
    </script>
</body>
</html>